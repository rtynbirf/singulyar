   "level": "line"
  },
  {
   "text": "wanneer iemand se lig agter die deur uitgaan",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Ons waai agter die vertrekkende treine aan",
