  {
   "text": "staal. OOR",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "As ek net vooraf geweet het hoe dit sou kerm",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "hierdie deursigtige hartseer in die siel",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Roep die ou mense, druk hulle",
