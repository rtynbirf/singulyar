   "level": "line"
  },
  {
   "text": "[musiek]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "terwyl die pols klop",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Laat die griewe verbygaan, ek is vandag daarvoor",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ek bid",
