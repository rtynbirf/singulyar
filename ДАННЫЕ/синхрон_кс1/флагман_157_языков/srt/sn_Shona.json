   "level": "line"
  },
  {
   "text": "Manheru matsva pachitoro chekofi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mhute yakakora inonyungudutsa dzimba. [mimhanzi]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
