   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[mimhanzi]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kwakafamba hupenyu semuseve, mazuva apfuura, mazuva apfuura",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "isu",
