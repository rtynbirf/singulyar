  },
  {
   "text": "[mimhanzi]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Takaunganidza mapepa, tichikanganwa kuti sei takaita",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "tinorarama",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Uye zvaiita sekunge, [mimhanzi]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "kuchine ruzha rweC mberi",
