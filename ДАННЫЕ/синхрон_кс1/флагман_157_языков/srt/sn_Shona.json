   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "haapi chinhu",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Uye kamwe kamwe [mimhanzi] inowira pamoyo pangu",
