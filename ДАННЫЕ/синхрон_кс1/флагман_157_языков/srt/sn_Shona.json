   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "zvinondipengesa",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kupi muchirimo chinodziya",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Chando chinofukidza mweya",
