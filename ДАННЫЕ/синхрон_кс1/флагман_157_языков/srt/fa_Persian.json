 "юниты": [
  {
   "text": "[موسیقی]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "عصر جدید در کافی‌شاپ،",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "مه غلیظ خانه‌ها را در خود حل می‌کند. [موسیقی]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "در محله‌هایی که خاطرات در آنها هستند پرسه می‌زنم",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "دیوانه ام کن",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "کجا در بهار گرم",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "زمستان روح را می‌پوشاند",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[موسیقی]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "جایی که زندگی مانند تیری از کنار تاریخ‌ها، گذشته‌ها، پرواز می‌کرد",
