{
 "канон": "пульс-синхрон/1",
 "songId": "ko_Korean",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ko_Korean.srt",
 "юниты": [
  {
   "text": "[음악]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "커피숍에서의 새로운 저녁",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "짙은 안개가 집들을 가려버린다. [음악]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "나는 추억이 깃든 동네들을 거닐었다",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "날 미치게 해",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "따뜻한 봄날에 어디에서",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "겨울은 영혼을 감싼다",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "삶이 화살처럼 지나쳐가는 곳, 날짜와 시간들을",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "우리를",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "우리는 왜 그랬는지 잊어버린 채 서류를 쌓아두었다",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "우리는 살아간다",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "그리고 그것은 언제나 [음악]처럼 느껴졌습니다",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "아직 C음이 남아 있습니다",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "단지 빌린 시간일 뿐",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "아무것도 주지 않는다",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "그리고 갑자기 [음악]이 내 마음에 닿았다",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "차가운 얼음",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "우리는 패배를 통해 음악의 진가를 깨닫게 된다",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "누군가의 문 뒤에서 불이 꺼질 때",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "우리는 떠나가는 기차들을 향해 손을 흔들며",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "과거에 답을 구걸하다",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "우리는 추울 때 사랑하는 법을 배운다. [음악]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "손바닥에 쇠가 아니라 재가 묻어 있을 때. 에 대한",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "미리 알았더라면 좋았을 텐데, [음악]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "이 투명한 것이 얼마나 영혼을 아프게 할 것인가",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "비애",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "그는 아무 말도 하지 않았고, [음악] 포옹도 하지 않았고, 시간이 없었다고도 하지 않았다",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "이것은 영원한 동기입니다",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "모든 걸 나중을 위해 아껴뒀어. 내 마음은 다른 사람을 향하지 않아",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "열렸습니다. [음악]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "우리는 그림자와 싸우고 있다",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "우리는 하찮은 일들에 지쳐버린다",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "서리가 어떻게 내리는지 볼 수가 없네요",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "우리 어깨에 짊어지고 있다",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "하지만 행복은 상점 쇼윈도의 화려함에 있는 것이 아닙니다",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[음악] 지폐 뭉치 속에 있는 것이 아니라, 조용한 곳에 있는",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "폭풍우 속에서도 변치 않는 따뜻함 속에 담긴 친척들의 진실. 하지만",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "우리는 음악이 이미 가진 것만을 높이 평가할 뿐이다",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "반품이 불가능합니다",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "제 오랜 여정을 계속 이어가겠습니다",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "그리고 종종 음악은 무의미한 길이 되기도 합니다",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "우리는 음악을 잃었을 때 비로소 그 소중함을 깨닫게 된다",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "누군가의 문 뒤에서 불이 꺼질 때",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "우리는 떠나가는 기차들을 향해 손을 흔든다",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "과거에게 답을 구걸하는 것",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "음악이 식었을 때 비로소 우리는 음악을 사랑하는 법을 배우게 된다",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "손바닥에 재가 있을 때, [음악] 그리고 그렇지 않을 때",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "강철. 에 대한",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "그게 어떻게 징징거릴지 미리 알았더라면 좋았을 텐데",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "영혼 속에 깃든 이 투명한 슬픔",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "어르신들께 전화 드리고, 안아 드릴게요",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "맥박이 뛰는 동안",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "불만은 접어두고, 오늘은 이 의견에 동의합니다",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "저는 기도합니다",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "모든 노래에는 끝이 있기 때문입니다",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "결국 하나",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[명음]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "음악은 중요한 순간들의 기억 속에 남아 있습니다",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "우리는 잊혀진 채 앉아 있다",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "우리는 실패를 통해 감사함을 배우게 된다",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "누군가의 음악 소리가 문 뒤로 새어나갈 때",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "빛",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "우리는 떠나가는 기차들을 향해 손을 흔들며",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "과거에 답을 구걸하다",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "우리는 사랑하는 법을 배웁니다, [음악]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "날씨가 식고, 손바닥에 재가 남았을 때",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "깨진 [음악] 크리스탈. 내가 처리해야겠어",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "우리가 여기 있는 동안, 그때까지 무엇이 있을까요?",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "날아갔다",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "영혼이 저 멀리 사라져간다",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[음악]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
