 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/st_Southern_Sotho.srt",
 "юниты": [
  {
   "text": "['mino]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Mantsiboea a macha lebenkeleng la kofi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Moholi o teteaneng o qhala matlo. ['mino]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ke lelera libakeng tseo ho nang le mehopolo",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ho nketsa hore ke hlanye",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Moo nakong ea selemo e futhumetseng",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Mariha a koahela moea",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Moo bophelo bo neng bo fofa joaloka motsu matsatsi a fetileng, a fetileng",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "rona",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Re ile ra bokella lipampiri, ra lebala hore na hobaneng re",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "re phela",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "'Me ho ne ho bonahala kamehla, ['mino]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ho ntse ho na le molumo oa C ka pele",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Nako e alimiloeng feela",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ha e fane ka letho",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "'Me ka tšohanyetso ['mino] o oela pelong ea ka",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "leqhoa le batang",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Re ithuta ho ananela ['mino] ha re lahleheloa",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ha lebone la motho e mong le tima ka mor'a lemati",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Re tsoka letsoho ka mora literene tse tlohang, re leka",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "kopa karabo ho tse fetileng",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Re ithuta ho rata ha ho bata, ['mino]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "ha ho na le molora matsohong a hao, eseng tšepe. MABAPI LE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "hoja feela ke ne ke tseba esale pele, ['mino]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kamoo ena e bonaletsang e tla opang kateng moeeng",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "masoabi",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ha a ka a re, [mmino] ha a ka a mo haka, ha a ka a ba le nako",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ena ke sepheo sa ka ho sa feleng",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ke bolokile ntho e 'ngoe le e 'ngoe bakeng sa hamorao, pelo ea ka ha e rate ba bang",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "e butsoe. ['mino]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Re loana le moriti",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "re chesa ka lebaka la lintho tse se nang thuso",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "'Me u ke ke ua bona hore na serame se lula joang",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "mahetleng a rona",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Empa thabo ha e benyetsehe fensetereng ea lebenkele",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "['mino] eseng ka har'a letoto la libili, empa ka khutso",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "'nete ea beng ka bona, mofuthung oa bona har'a lifefo. Empa",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "re ananela feela seo ['mino] o seng o ntse o le sona",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ho ke ke ha khoneha ho kgutla",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Ho tsoela pele ka nako e telele ea ka",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "'me hangata ['mino] ke tsela e se nang moelelo",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "re ithuta ho ananela ha re lahleheloa ke ['mino]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ha lebone la motho e mong le tima ka mor'a lemati",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Re tsoka matsoho ka mor'a ['mino] literene tse ileng",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ho leka ho kopa karabo ho tse fetileng",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Re ithuta ho rata ['mino] ha o se o pholile",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "ha ho na le molora matsohong a matsoho, ['mino] eseng",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "tšepe. MABAPI LE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Hoja feela ke ne ke tseba esale pele hore na e tla lla joang",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "masoabi ana a pepeneneng moeeng",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Bitsa batho ba baholo, ba hake",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ha pelo e ntse e otla",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Litletlebo li fete, ke bakeng sa sena kajeno",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Kea rapela",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Hobane lipina tsohle li na le qetello",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "qetellong, e le 'ngoe",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ho bina]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Re [mmino] re ntse re hopola liketsahalo tsa bohlokoa",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "re lutse re lebetsoe",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Re ithuta ho ananela ha re lahleheloa",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "ha 'mino oa motho e mong o tsoa ka mor'a lemati",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "leseli",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Re tsoka letsoho ka mora literene tse tlohang, re leka",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "kopa karabo ho tse fetileng",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Re ithuta ho rata, ['mino]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "ha e phola, ha ho ne ho e-na le molora liatleng le",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristale [ea 'mino] e robehileng. Ke lokela ho e hlokomela",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ke eng, ha re ntse re le mona, ho fihlela",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "o ile a fofa",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "moea hole",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "['mino]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
