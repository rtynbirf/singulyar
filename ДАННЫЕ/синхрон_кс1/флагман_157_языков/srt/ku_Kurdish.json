{
 "канон": "пульс-синхрон/1",
 "songId": "ku_Kurdish",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ku_Kurdish.srt",
 "юниты": [
  {
   "text": "[mûzîk]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Êvareke nû li qehwexaneyê",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mij ​​û dûmana stûr malan dihelîne. [mûzîk]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ez di nav taxên ku bîranîn lê ne de digerim",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "min dîn bike",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Li ku derê di bihara germ de",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Zivistan giyanê xwe vedişêre",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Li cihê ku jiyan wek tîrê difiriya di demên borî de, di demên borî de",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "me",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Me kaxez kom kirin, ji bîr kirin çima em",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "em dijin",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Û her tim wisa xuya dikir, [muzîk]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "hîn jî dengekî C li pêş heye",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Tenê dem deyn kir",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "tiştek nade",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Û ji nişkê ve [muzîk] dikeve ser dilê min",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "qeşa sar",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Em fêr dibin ku dema em winda dikin [muzîkê] binirxînin",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "dema çira kesekî li pişt derî vedimire",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Em li dû trênên ku diçin destê xwe dihejînin, hewl didin",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ji bo bersivê ji rabirdûyê lava bikin",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Em fêrî hezkirinê dibin dema ku sar be, [muzîk]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "dema di nav lepên te de xwelî hebe, ne pola. JI DOR",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "xwezî min pêşwext bizanibûya, [muzîk]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "ev yeka zelal dê çawa di giyan de biêşe",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "liberketinî",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Wî negot, [muzîk] wî hembêz nekir, wextê wî tunebû",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ev motîvasyonek herheyî ye",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Min her tişt ji bo paşê hişt, dilê min ne ji bo yên din e",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "vekir. [mûzîk]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Em bi sînemayê re şer dikin",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "em li ser trifleqên vala dişewitin",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Û hûn nabînin ka qeşa çawa rûdine",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "li ser milên me",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Lê bextewarî ne di biriqîna pencereya dikanekê de ye",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzîk] ne di nav komek fatûreyan de, lê di bêdengiyekê de",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "rastiya xizmên, di germahiya wan de di nav tofanan de. Lebê",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "em tenê tiştê ku [muzîk] jixwe ye dinirxînin",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "vegerandin ne gengaz e",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Dirêjiya min berdewam dike",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "û pir caran [muzîk] rêyeke bêwate ye",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "em fêr dibin ku dema em [muzîkê] winda dikin qedir bigirin",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "dema çira kesekî li pişt derî vedimire",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Em li dû [muzîkê] trênên ku çûne destê xwe dihejînin",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "hewl dide ku ji rabirdûyê bersivê bixwaze",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Em fêr dibin ku [muzîkê] hez bikin dema ku ew sar bibe",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "dema ku di nav daran de xwelî hebe, [muzîk] û ne",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "pola. JI DOR",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Xwezî min ji berê de bizanibûya ka ew ê çawa bigirî",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ev xemgîniya zelal di giyan de",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Gazî kal û pîran bike, wan hembêz bike",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "dema ku lêdana dil lê dide",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Bila gilî û gazind derbas bibin, ez îro ji bo vê me",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ez dua dikim",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Ji ber ku hemû stran xwedî dawiyek in",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "di dawiyê de, yek",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[stranbêjî]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Em [muzîk] di bîranîna qonaxên girîng de dimînin",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "em ji bîrkirî rûniştine",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Em fêr dibin ku gava em winda dikin qîmetê bidinê",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "dema muzîka kesekî ji pişt derî derdikeve",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "sivik",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Em li dû trênên ku diçin destê xwe dihejînin, hewl didin",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ji bo bersivê ji rabirdûyê lava bikin",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Em fêrî evînê dibin, [muzîk]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "dema ku sar bû, dema ku di nav daran de xwelî hebû û",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "krîstala [muzîk] a şikestî. Divê ez lê xwedî derkevim",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "çi ye, dema ku em li vir in, heta ku",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "firî",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ruh ber bi dûr ve diavêje",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[mûzîk]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
