 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/wo_Wolof.srt",
 "юниты": [
  {
   "text": "[misaal]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Guddi gu bees ci kafe bi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Lay bu dëll dafay seey kër yi. [misaal]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Maa ngi doxantu ci dëkkuwaay yi am fàttaliku",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "def ma dof",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Fan ci pringtemps bu tàng bi",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Hiver dafay muur ruuh gi",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Fu dundu naaw ni fett romb bis, romb",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nu",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Nu dajale ay këyit, fàtte li tax nu",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "nu ngi dundu",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Te daa musa melni, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ba leegi amna son C ci kanam",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Dama leble jot",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "du joxe dara",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ci saasi daanu ci sama xol",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "glaas bu sedd",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Danuy jàng fonk sunu ñàkkee",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "su amee lumiere bu dee ci buntu bi",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Nuy tàllal loxo ginaaw saxaar yiy dem, di jéema",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ñaanal lu weesu tontu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Danuy jàng bëgg su sedd",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "soo amee dóóm ci sa loxo, du weñ. LU JËM CI",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Suma ko xamoon bu njëkk",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "naka la ko leer gi di metti ci ruuh gi",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "naqar",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Waxul, laxasuwul, amul jotu",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Loolu mooy mébet budul jeex",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Dama denc lépp ngir ëlëg, sama xol nekkul ci ñeneen ñi",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ubbeeku. [misaal]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Danuy xeex ak lëndëm",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "nu ngi lakk ci mbir yu amul benn njariñ",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "te mënoo gis ni gelu bi di wàccee",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ci sunuy mbagg",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Waaye bànneex nekkul ci melax biy melax ci vitrine bi",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "du ci ay xaalis yu bari, waaye ci anam wu dal",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "dëggu mbokk yi, ci seen tàngoor ci biir taw yu metti yi. Waaye",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Danuy xam li jota am",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "mënu ñu dellusi",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "wéyal sama guddaay",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "te lu bari yoon wu amul njariñ la",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Danuy jàng gërëm sunu ñàkkee [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "su amee lumiere bu dee ci buntu bi",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Nuy tàllal loxo ginaaw [musik] saxaar yi dem",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "di jéema ñaan lu weesu ngir am tontu",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Danuy jàng bëgg bu seddee",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "su amee dóóm ci loxo yi, [musik] te amul",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "asiye. LU JËM CI",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Suma xamoon bu njëkk naka lay def",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "naqar bu leer ci ruuh gi",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Woowal mag ñi, laxasu leen",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "bi puuls bi di tëf",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Bàyyileen ñaxtu yi dem, maa ngi ci lii tay",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Maa ngi ñaan",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[misaal]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Ndax way yépp amnañu njeexte",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "ci gàttal, benn",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[di way]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Nun des ci fàttaliku jaar-jaar yu am solo",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "nu toog ñu fàtte",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
