{
 "канон": "пульс-синхрон/1",
 "songId": "el_Greek",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/el_Greek.srt",
 "юниты": [
  {
   "text": "[μουσική]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Νέα βραδιά στο καφενείο",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Η πυκνή ομίχλη διαλύει τα σπίτια. [μουσική]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Περιπλανιέμαι στις γειτονιές όπου υπάρχουν αναμνήσεις",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "με τρελαίνεις",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Πού στη ζεστή άνοιξη",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ο χειμώνας σκεπάζει την ψυχή",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Όπου η ζωή πετούσε σαν βέλος πέρα ​​από ημερομηνίες, περασμένες",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "μας",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Μαζέψαμε χαρτιά, ξεχνώντας γιατί",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ζούμε",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Και πάντα φαινόταν, [μουσική]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Ακούγεται ακόμα ένας ήχος Ντο μπροστά",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Απλώς δανεισμένος χρόνος",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "δεν δίνει τίποτα",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Και ξαφνικά [η μουσική] πέφτει στην καρδιά μου",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "κρύος πάγος",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Μαθαίνουμε να εκτιμούμε [τη μουσική] όταν χάνουμε",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "όταν το φως κάποιου σβήνει πίσω από την πόρτα",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Χαιρετάμε τα τρένα που αναχωρούν, προσπαθώντας",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "παρακαλώ το παρελθόν για μια απάντηση",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Μαθαίνουμε να αγαπάμε όταν κάνει κρύο, [μουσική]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "όταν υπάρχει στάχτη στις παλάμες σου, όχι ατσάλι. ΓΙΑ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Μακάρι να το ήξερα εκ των προτέρων, [μουσική]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "πώς αυτό το διάφανο θα πονέσει στην ψυχή",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "θλίψη",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Δεν είπε, [μουσική] δεν αγκάλιασε, δεν είχε χρόνο",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Αυτό είναι ένα διαχρονικό κίνητρο",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Τα άφησα όλα για αργότερα, η καρδιά μου δεν είναι για τους άλλους",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "άνοιξε. [μουσική]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Παλεύουμε με τη σκιά",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "καίγουμε πάνω από άδεια μικροπράγματα",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Και δεν μπορείς να δεις πώς κατακάθεται ο παγετός",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "στους ώμους μας",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Αλλά η ευτυχία δεν είναι στη λάμψη μιας βιτρίνας",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[μουσική] όχι σε μια στοίβα χαρτονομισμάτων, αλλά σε μια ήσυχη",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "η αλήθεια των συγγενών, στη ζεστασιά τους ανάμεσα στις καταιγίδες. Αλλά",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Εκτιμούμε μόνο αυτό που είναι ήδη [η μουσική]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "αδύνατο να επιστρέψει",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Συνεχίζοντας τη μακρά μου",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "και συχνά [η μουσική] είναι ένα μονοπάτι χωρίς νόημα",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "μαθαίνουμε να εκτιμούμε όταν χάνουμε [μουσική]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "όταν το φως κάποιου σβήνει πίσω από την πόρτα",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Χαιρετάμε μετά [μουσική] τα αναχωρούντα τρένα",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "προσπαθώντας να παρακαλέσει το παρελθόν για μια απάντηση",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Μαθαίνουμε να αγαπάμε [τη μουσική] όταν αυτή έχει ηρεμήσει",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "όταν υπάρχουν στάχτες στις παλάμες, [μουσική] και όχι",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ατσάλι. ΓΙΑ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Μακάρι να ήξερα εκ των προτέρων πώς θα γκρίνιαζε",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "αυτή η διάφανη θλίψη στην ψυχή",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Φώναξε τους ηλικιωμένους, αγκάλιασέ τους",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ενώ ο σφυγμός χτυπάει",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Άσε τα παράπονα να περάσουν, είμαι υπέρ αυτού σήμερα",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Προσεύχομαι",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Γιατί όλα τα τραγούδια έχουν ένα τέλος",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "στο τέλος, ένα",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[τραγούδι]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Εμείς [η μουσική] παραμένουμε στη μνήμη ορόσημων",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "καθόμαστε ξεχασμένοι",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Μαθαίνουμε να εκτιμούμε όταν χάνουμε",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "όταν η μουσική κάποιου ακούγεται πίσω από την πόρτα",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "φως",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Χαιρετάμε τα τρένα που αναχωρούν, προσπαθώντας",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "παρακαλώ το παρελθόν για μια απάντηση",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Μαθαίνουμε να αγαπάμε, [μουσική]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "όταν δρόσισε, όταν υπήρχαν στάχτες στις παλάμες και",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "σπασμένο [μουσικό] κρύσταλλο. Θα έπρεπε να το φροντίσω",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "τι είναι, όσο είμαστε εδώ, μέχρι",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "πέταξε μακριά",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ψυχή στο βάθος",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[μουσική]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
