{
 "канон": "пульс-синхрон/1",
 "songId": "kk_Kazakh",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/kk_Kazakh.srt",
 "юниты": [
  {
   "text": "Кофеханадағы жаңа кеш",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Қалың тұман үйлерді ерітеді",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Мен естеліктер жатқан аудандарды аралап жүремін",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "мені есінен тандырады",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Жылы көктемде қайда",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Қыс жанды жауып тұр",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "Өмір жебе сияқты ұшып өткен күндерден, өткен күндерден",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "бізді",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "Біз қағаздарды жинап қойдық, неге екенін ұмытып кеттік",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "біз өмір сүреміз",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Және бұл әрқашан көрінетін",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "алда әлі С дыбысы бар",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Тек уақытты қарызға алдыңыз",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ештеңе бермейді",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Кенеттен жүрегіме құлады",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "суық мұз",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Біз жеңілген кезде [музыканы] бағалауды үйренеміз",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "есіктің артында біреудің шамы сөнгенде",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Біз кетіп бара жатқан пойыздардың соңынан қол бұлғап, тырысып жатырмыз",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "өткеннен жауап сұраңыз",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Біз суық болған кезде сүюді үйренеміз",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "алақаныңда болат емес, күл болған кезде. ТУРАЛЫ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "егер мен алдын ала білсем ғой",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "бұл мөлдір жанды қалай ауыртады",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "қайғы",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ол құшақтамадым, уақытым жоқ деп айтқан жоқ",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Бұл мәңгілік мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Мен бәрін кейінге сақтадым, жүрегім басқаларға арналмаған",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ашылды",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Біз көлеңкемен күресіп жатырмыз",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "бос нәрселерге күйіп кетеміз",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Аяздың қалай орнығып жатқанын көре алмайсыз",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "біздің иығымызда",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Бірақ бақыт дүкен терезесінің жарқырауында емес",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "купюралар шоғырында емес, тыныштықта",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "дауылдар арасындағы жылулықтағы туыстардың шындығы. Бірақ",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "біз тек [музыканың] қазірдің өзінде бар екенін бағалаймыз",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "қайтару мүмкін емес",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Ұзақ өмірімді жалғастырудамын",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "және көбінесе мағынасыз жол болып табылады",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "біз [музыканы] жоғалтқан кезде бағалай білуді үйренеміз",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "есіктің артында біреудің шамы сөнгенде",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Біз кетіп бара жатқан пойыздардың артынан қол бұлғаймыз",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "өткеннен жауап сұрауға тырысады",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Біз [музыканы] суыған кезде сүюді үйренеміз",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "алақанда күл болған кезде, және емес",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "болат. ТУРАЛЫ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Егер мен оның қалай ыңырсыйтынын алдын ала білсем ғой",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "жандағы бұл мөлдір қайғы",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Қарт адамдарды шақырыңыз, құшақтаңыз",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "пульс соғып тұрғанда",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Ашулар өтсін, мен бүгін осыны қолдаймын",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Мен даға оқимын",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "Өйткені барлық әндердің соңы бар",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "соңында, біреуі",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ән айту]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Біз маңызды кезеңдердің есінде қаламыз",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ұмытылып отырамыз",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "Біз жоғалтқан кезде бағалай білуді үйренеміз",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "есіктің артында біреудің музыкасы естілгенде",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "жарық",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Біз кетіп бара жатқан пойыздардың соңынан қол бұлғап, тырысып жатырмыз",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "өткеннен жауап сұраңыз",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Біз сүюді үйренеміз",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "суыған кезде, алақандарда күл болған кезде және",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "сынған хрусталь. Мен оған қамқорлық жасауым керек",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "біз осында болғанша, не болып жатыр",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "ұшып кетті",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "жан алысқа",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  }
 ]
}
