 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/id_Indonesian.srt",
 "юниты": [
  {
   "text": "[musik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Suasana malam baru di kedai kopi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Kabut tebal melarutkan rumah-rumah. [musik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Aku berkelana menyusuri lingkungan tempat kenangan tersimpan",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "membuatku gila",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Di mana di mata air hangat",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Musim dingin menyelimuti jiwa",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Di mana kehidupan melesat seperti anak panah melewati tanggal, melewati",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "kita",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Kita menimbun kertas, melupakan alasan kita melakukannya",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "kita hidup",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Dan sepertinya selalu begitu, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Masih ada bunyi C di depan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Hanya waktu pinjaman",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "tidak memberikan apa pun",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Dan tiba-tiba [musik] menyentuh hatiku",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "es dingin",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Kita belajar menghargai [musik] ketika kita kalah",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ketika lampu seseorang padam di balik pintu",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Kami melambaikan tangan setelah kereta berangkat, mencoba",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "memohon jawaban dari masa lalu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Kita belajar mencintai saat cuaca dingin, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "ketika yang ada abu di telapak tanganmu, bukan baja. TENTANG",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Seandainya aku tahu sebelumnya, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "betapa menyakitkannya hal yang transparan ini di dalam jiwa",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "kesedihan",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Dia tidak mengatakan apa-apa, [musik] dia tidak memeluk, dia tidak punya waktu",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ini adalah motif abadi",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Aku menyimpan semuanya untuk nanti, hatiku bukan untuk orang lain",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "dibuka. [musik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Kita sedang bertarung dengan bayangan",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Kita kelelahan karena hal-hal sepele yang tidak berarti",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Dan kamu tidak bisa melihat bagaimana embun beku itu terbentuk",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "di pundak kita",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Namun kebahagiaan bukanlah terletak pada kilauan etalase toko",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musik] bukan dalam setumpuk uang kertas, tetapi dalam keheningan",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "Kebenaran tentang hubungan keluarga, dalam kehangatan mereka di tengah badai. Tetapi",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "kita hanya menghargai apa yang sudah ada [musik]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "Tidak mungkin dikembalikan",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Melanjutkan perjalanan panjang saya",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "dan seringkali [musik] adalah jalan yang tidak bermakna",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Kita belajar menghargai ketika kita kehilangan [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ketika lampu seseorang padam di balik pintu",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Kami melambaikan tangan mengikuti [musik] kereta yang telah berangkat",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "mencoba memohon jawaban dari masa lalu",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Kita belajar mencintai [musik] ketika musik itu sudah mereda",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "ketika ada abu di telapak tangan, [musik] dan tidak",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "baja. TENTANG",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Seandainya aku tahu sebelumnya bagaimana ia akan merengek",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "Kesedihan yang transparan di dalam jiwa",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Telepon orang tua, peluk mereka",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "selagi denyut nadi berdetak",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Biarkan keluhan itu berlalu, saya mendukung ini hari ini",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Aku berdoa",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Karena semua lagu memiliki akhir",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "Pada akhirnya, hanya satu",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[nyanyian]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Kami [musik] tetap terukir dalam ingatan akan peristiwa-peristiwa penting",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "kita terabaikan",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Kita belajar menghargai saat kita kalah",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "ketika musik seseorang menghilang di balik pintu",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lampu",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Kami melambaikan tangan setelah kereta berangkat, mencoba",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "memohon jawaban dari masa lalu",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Kita belajar mencintai [musik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "ketika sudah dingin, ketika ada abu di telapak tangan dan",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [musik] pecah. Aku harus mengurusnya",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "apa yang terjadi, selagi kita di sini, sampai",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "terbang pergi",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "jiwa menuju kejauhan",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[musik]",
