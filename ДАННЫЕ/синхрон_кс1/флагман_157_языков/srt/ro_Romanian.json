 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ro_Romanian.srt",
 "юниты": [
  {
   "text": "[muzică]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "O nouă seară la cafenea",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ceața densă dizolvă casele. [muzică]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Rătăcesc prin cartierele unde sunt amintirile",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "mă scoate din minți",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Unde în primăvara caldă",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Iarna acoperă sufletul",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Unde viața a zburat ca o săgeată, trecând peste întâlniri, trecând",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "S.U.A",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Am adunat hârtii, uitând de ce am făcut-o",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "trăim",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Și întotdeauna părea, [muzică]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "se aude încă un sunet C mai departe",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Doar timp împrumutat",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nu dă nimic",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Și dintr-o dată [muzica] îmi cade în inimă",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "gheață rece",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Învățăm să apreciem [muzica] atunci când pierdem",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "când se stinge lumina cuiva în spatele ușii",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Facem cu mâna după trenurile care pleacă, încercând",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "imploră trecutul pentru un răspuns",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Învățăm să iubim când e frig, [muzică]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "când în palme ai cenușă, nu oțel. DESPRE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "dacă aș fi știut dinainte, [muzică]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "cum va durea sufletul acesta transparent",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristeţe",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nu a spus, [muzică] nu a îmbrățișat, nu a avut timp",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Acesta este un motiv etern",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Am păstrat totul pentru mai târziu, inima mea nu este pentru alții",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "deschis. [muzică]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ne luptăm cu umbra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ne epuizăm pentru fleacuri goale",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Și nu poți vedea cum se așază gerul",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "pe umerii noștri",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Dar fericirea nu stă în strălucirea unei vitrine",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzică] nu într-un teanc de bancnote, ci într-o liniște",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "adevărul rudelor, în căldura lor printre furtuni. Dar",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "apreciem doar ceea ce [muzica] este deja",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "imposibil de întors",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Continuându-mi lunga mea",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "și adesea [muzica] este o cale fără sens",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "învățăm să apreciem când pierdem [muzica]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "când se stinge lumina cuiva în spatele ușii",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Facem cu mâna după trenurile plecate",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "încercând să implor trecutul pentru un răspuns",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Învățăm să iubim [muzica] când aceasta s-a mai răcit",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "când este cenușă în palme, [muzică] și nu",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "oţel. DESPRE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Dacă aș fi știut dinainte cum va scânci",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "această tristețe transparentă din suflet",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Cheamă-i pe bătrâni, îmbrățișează-i",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "în timp ce pulsul bate",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lasă nemulțumirile să treacă, eu sunt pentru asta astăzi",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Mă rog",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Pentru că toate cântecele au un sfârșit",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "în cele din urmă, unul",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[cântând]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Noi [muzica] rămânem în memoria momentelor importante",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "stăm uitați",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muzică]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Învățăm să apreciem atunci când pierdem",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "când muzica cuiva se aude în spatele ușii",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "aprinde",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Facem cu mâna după trenurile care pleacă, încercând",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "imploră trecutul pentru un răspuns",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Învățăm să iubim [muzica]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "când s-a răcit, când era cenușă în palme și",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristal [muzical] spart. Ar trebui să am grijă de asta",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ce este, cât timp suntem aici, până când",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "a zburat",
