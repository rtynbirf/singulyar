 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ms_Malay.srt",
 "юниты": [
  {
   "text": "[muzik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Malam baru di kedai kopi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Kabus tebal melarutkan rumah-rumah. [muzik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Aku mengembara melalui kawasan kejiranan di mana kenangan berada",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "buat saya gila",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Di mana pada musim bunga yang hangat",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Musim sejuk menyelubungi jiwa",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Di mana kehidupan terbang seperti anak panah melewati tarikh, masa lalu",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "kami",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Kami menyimpan kertas, lupa mengapa kami",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "kita hidup",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Dan ia sentiasa kelihatan, [muzik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "masih ada bunyi C di hadapan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Hanya meminjam masa",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "tidak memberi apa-apa",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Dan tiba-tiba [muzik] jatuh di hatiku",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ais sejuk",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Kita belajar menghargai [muzik] apabila kita kehilangan",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "apabila lampu seseorang padam di sebalik pintu",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Kami melambai ke arah kereta api yang berlepas, cuba",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "memohon jawapan kepada masa lalu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Kita belajar untuk mencintai ketika cuaca sejuk, [muzik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "apabila terdapat abu di tapak tangan anda, bukan keluli. TENTANG",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "kalaulah saya tahu lebih awal, [muzik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "betapa pedihnya jiwa yang telus ini",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "kesedihan",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Dia tidak kata, [muzik] dia tidak peluk, dia tidak ada masa",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ini adalah motif yang abadi",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Aku simpan semuanya untuk kemudian hari, hatiku bukan untuk orang lain",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "dibuka. [muzik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Kita sedang bertarung dengan bayang-bayang",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "kita keletihan hanya kerana perkara-perkara remeh yang tidak penting",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Dan anda tidak dapat melihat bagaimana fros itu menetap",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "di bahu kita",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Tetapi kebahagiaan bukan pada kilauan tingkap kedai",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzik] bukan dalam gumpalan wang kertas, tetapi dalam keadaan tenang",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "kebenaran saudara-mara, dalam kehangatan mereka di tengah-tengah ribut. Tetapi",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "kami hanya menghargai apa yang [muzik] sudah ada",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "mustahil untuk kembali",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Meneruskan panjang saya",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "dan selalunya [muzik] adalah jalan yang tidak bermakna",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "kita belajar untuk menghargai apabila kita kehilangan [muzik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "apabila lampu seseorang padam di sebalik pintu",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Kami melambai mengikut [muzik] kereta api yang berlepas",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "cuba merayu jawapan kepada masa lalu",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Kita belajar untuk mencintai [muzik] apabila ia telah reda",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "apabila terdapat abu di tapak tangan, [muzik] dan tidak",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "keluli. TENTANG",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Kalaulah aku tahu terlebih dahulu bagaimana ia akan merengek",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "kesedihan yang tersirat di jiwa ini",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Panggil orang tua, peluk mereka",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "semasa nadi berdegup",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Biarlah rungutan berlalu, aku menyokong ini hari ini",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Saya berdoa",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kerana semua lagu ada pengakhirannya",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "pada akhirnya, satu",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[menyanyi]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Kami [muzik] kekal dalam ingatan peristiwa penting",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "kita duduk dilupakan",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Kita belajar menghargai apabila kita kalah",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "apabila muzik seseorang berbunyi di sebalik pintu",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "cahaya",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Kami melambai ke arah kereta api yang berlepas, cuba",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "memohon jawapan kepada masa lalu",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Kita belajar untuk mencintai, [muzik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "apabila ia sejuk, apabila terdapat abu di tapak tangan dan",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [muzik] yang pecah. Saya patut menjaganya",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "apa yang berlaku, sementara kita di sini, sehingga",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "terbang pergi",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[muzik]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "jiwa ke kejauhan",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[muzik]",
