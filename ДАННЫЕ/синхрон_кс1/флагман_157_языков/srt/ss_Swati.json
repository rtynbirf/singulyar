  },
  {
   "text": "insimbi. NGE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Kube nje bengati kusengaphambili kutsi itawububula njani nga 2019",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "loku lusizi lokusobala emphefumulweni",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Bita bantfu labadzala, ubagone",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[umculo]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ngesikhatsi i-pulse ishaya",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Akendlule tikhalato, ngikuloku namuhla",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ngiyathandaza",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[umculo]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Ngoba tonkhe tingoma tinesiphetfo",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "ekugcineni, munye",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
