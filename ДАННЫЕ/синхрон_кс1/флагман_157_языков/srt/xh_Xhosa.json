   "level": "line"
  },
  {
   "text": "xa isibane somntu sicima emva kocango",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Siphakamisa isandla emva koololiwe abasukayo, sizama",
