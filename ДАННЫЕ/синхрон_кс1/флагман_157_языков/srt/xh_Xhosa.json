   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "umkhenkce obandayo",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Sifunda ukuxabisa [umculo] xa silahlekelwa",
