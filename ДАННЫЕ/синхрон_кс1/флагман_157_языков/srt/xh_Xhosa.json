   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Akazange athi, [umculo] akazange amwole, wayengenalo ixesha",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Le yinjongo engunaphakade",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ndigcine yonke into ukuze ndiyigcinele kamva, intliziyo yam ayibakhathaleli abanye abantu",
