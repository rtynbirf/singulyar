   "level": "line"
  },
  {
   "text": "[umculo]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Siqokelele amaphepha, silibale ukuba kutheni",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "siphila",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Kwaye kwakubonakala ngathi, [umculo]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "kusekho isandi sika-C ngaphambili",
