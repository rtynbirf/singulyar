   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ndiphambanise",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Apho entwasahlobo efudumeleyo",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ubusika bugubungela umphefumlo",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[umculo]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Apho ubomi bubhabha khona njengotolo, imihla edlulileyo, edlulileyo",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "thina",
