   "level": "line"
  },
  {
   "text": "Ubusuku obutsha kwivenkile yekofu",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Inkungu engqindilili iyayichitha indlu. [umculo]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ndihambahamba kwiindawo apho kukho iinkumbulo",
