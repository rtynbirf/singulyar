   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[umculo]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Ixesha nje elibolekiweyo",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "akaniki nto",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Kwaye ngequbuliso [umculo] uwela entliziyweni yam",
