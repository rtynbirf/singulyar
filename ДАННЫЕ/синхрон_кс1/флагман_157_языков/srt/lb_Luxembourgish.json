 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/lb_Luxembourgish.srt",
 "юниты": [
  {
   "text": "[Musek]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Neien Owend am Kaffisbuttek",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Décke Niwwel zerstéiert Haiser. [Musek]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ech wanderen duerch d'Quartieren, wou d'Erënnerungen sinn",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "mech verréckt maachen",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Wou am waarme Fréijoer",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "De Wanter bedeckt d'Séil",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Wou d'Liewen wéi e Pfeil laanscht Datumer, Vergaangenheet geflunn ass",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "eis",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Mir hunn Pabeieren gehamstert a vergiess firwat mir",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "mir liewen",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "An et huet ëmmer ausgesinn, [Musek]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "et gëtt nach ëmmer en C-Klang virun",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Just geléint Zäit",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "gëtt näischt",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "An op eemol fällt [Musek] mir op d'Häerz",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kal Äis",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Mir léieren [Musek] ze schätzen, wa mir verléieren",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "wann iergendeen säi Liicht hannert der Dier ausgeet",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Mir winken den offuerenden Zich no a probéieren",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "d'Vergaangenheet ëm eng Äntwert froen",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Mir léieren ze gär ze hunn wann et kal ass, [Musek]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "wann Äsch an Ären Handflächen ass, net Stol. IWWER",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "wann ech et just am Viraus gewosst hätt, [Musek]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "wéi dësen transparenten an der Séil wéi wäert maachen",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "Trauregkeet",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hien huet net gesot, [Musek] hien huet net ëmklammert, hien hat keng Zäit",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dëst ass en éiwegt Motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ech hunn alles fir spéider gespuert, mäin Häerz ass net fir anerer",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "opgemaach. [Musek]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Mir kämpfen mam Schiet",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "mir verbrennen iwwer eidel Triflen",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "An Dir kënnt net gesinn, wéi de Frascht sech nidderléisst",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "op eisen Schëlleren",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mee d'Gléck läit net am Glanz vun enger Butteksfënster",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[Musek] net an engem Kuerf vu Schäiner, mee an enger roueger",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "d'Wourecht vun de Verwandten, an hirer Wäermt tëscht de Stierm. Mä awer",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "mir schätzen nëmmen dat wat [Musek] scho ass",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "onméiglech zréckzekommen",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Weider meng laang",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "an dacks ass [Musek] e sënnlose Wee",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "mir léieren ze schätzen, wann mir [Musek] verléieren",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "wann iergendeen säi Liicht hannert der Dier ausgeet",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Mir winken no [Musek] den ofgefuerte Zich",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "probéiert d'Vergaangenheet ëm eng Äntwert ze bieden",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Mir léieren [Musek] gär ze hunn, wann se ofgekillt ass",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "wann Äsch an de Palmen ass, [Musek] an net",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "Stol. IWWER",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Wann ech just am Viraus wéisst, wéi et géif jäizen",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "dës transparent Trauregkeet an der Séil",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ruff déi al Leit un, knuddel se",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "wärend de Puls schléit",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Loosst d'Grief laanschtgoen, ech sinn haut dofir",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ech bieden",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Well all Lidder hunn en Enn",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "um Enn, een",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[sangen]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Mir [Musek] bleiwen an der Erënnerung un Meilesteen",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "mir sëtzen vergiess",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Mir léieren ze schätzen, wann mir verléieren",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "wann d'Musek vun engem hannert der Dier erausgeet",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "Liicht",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Mir winken den offuerenden Zich no a probéieren",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "d'Vergaangenheet ëm eng Äntwert froen",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Mir léieren ze gär hunn, [Musek]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "wéi et ofgekillt ass, wéi Äsche an de Palmen war an",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "gebrachenen [Musek] Kristall. Ech sollt mech dorëm këmmeren",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "wat ass, wärend mir hei sinn, bis",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "fortgeflunn",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "Séil an d'Distanz",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[Musek]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
