   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "açıldı. [musiqi]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Biz kölgə ilə mübarizə aparırıq",
