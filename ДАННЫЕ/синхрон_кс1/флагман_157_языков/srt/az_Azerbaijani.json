   "level": "line"
  },
  {
   "text": "[musiqi]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Həyatın tarixlərdən, keçmişdən ox kimi uçduğu yer",
