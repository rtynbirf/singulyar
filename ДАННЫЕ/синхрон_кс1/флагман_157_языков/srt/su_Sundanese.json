 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/su_Sundanese.srt",
 "юниты": [
  {
   "text": "[musik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Sore anyar di warung kopi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Halimun kandel ngaburak-barik imah. [musik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Kuring ngumbara ngaliwatan lingkungan dimana kenangan aya",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "nyieun kuring gélo",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Dimana dina usum semi anu haneut",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Usum tiris nutupan jiwa",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Dimana kahirupan hiber kawas panah kaliwat tanggal, kaliwat",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "urang",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Urang ngumpulkeun kertas, poho alesanna",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "urang hirup",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Sareng sigana sok, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "masih aya sora C di hareup",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Ngan saukur nginjeum waktu",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "teu méré nanaon",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Jeung ujug-ujug [musik] murag kana haté kuring",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "és tiis",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Urang diajar ngahargaan [musik] nalika urang kaleungitan",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "nalika lampu batur pareum di tukangeun panto",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Urang ngalambaikeun leungeun sanggeus karéta nu rék indit, bari nyobaan",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "menta jawaban ti jaman baheula",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Urang diajar mikanyaah nalika tiis, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "nalika aya lebu dina dampal leungeun anjeun, sanés baja. NGEUNAAN",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "saupama kuring nyaho ti heula, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kumaha anu transparan ieu bakal nyeri dina jiwa",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "kasedih",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Anjeunna teu nyarios, [musik] anjeunna teu dirangkul, anjeunna teu gaduh waktos",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ieu mangrupikeun motif anu langgeng",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Kuring nyimpen sagalana kanggo engké, haté kuring sanés kanggo batur",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "dibuka. [musik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Urang keur perang jeung bayangan",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "urang béak tanaga ngan saukur ku hal-hal nu teu penting",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Sareng anjeun teu tiasa ningali kumaha ibunna netep",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "dina taktak urang",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Tapi kabagjaan teu aya dina kilauan jandela toko",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musik] lain dina gumpalan duit kertas, tapi dina sepi",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "kaleresan baraya, dina kahaneutan aranjeunna di antara badai. Tapi",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "urang ngan ukur ngahargaan naon anu parantos aya [musik]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "teu mungkin balik deui",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Neruskeun panjang kuring",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "sareng sering [musik] mangrupikeun jalan anu teu aya hartina",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "urang diajar ngahargaan nalika urang kaleungitan [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "nalika lampu batur pareum di tukangeun panto",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Urang ngalambaikeun leungeun nuturkeun [musik] karéta anu geus indit",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "nyobian ménta jawaban ti mangsa katukang",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Urang diajar mikanyaah [musik] nalika musikna tos tiis",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "nalika aya lebu dina dampal leungeun, [musik] sareng henteu",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "baja. NGEUNAAN",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Saupama kuring nyaho ti heula kumaha éta bakal ngarenghik",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "kasedih anu jelas ieu dina jiwa",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Telepon jalma-jalma anu geus kolot, rangkul aranjeunna",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "bari denyut nadi na ngadégdég",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Hayu keluhan-keluhan ieu kaliwat, kuring satuju dinten ieu",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Abdi ngadoa",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Sabab sadaya lagu ngagaduhan tungtung",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "tungtungna, hiji",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[nyanyi]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Urang [musik] tetep aya dina mémori tonggak sejarah",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "urang diuk dipopohokeun",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Urang diajar ngahargaan nalika urang kaleungitan",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "nalika musik batur kaluar di tukangeun panto",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "cahaya",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Urang ngalambaikeun leungeun sanggeus karéta nu rék indit, bari nyobaan",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "menta jawaban ti jaman baheula",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Urang diajar mikanyaah, [musik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "nalika tiis, nalika aya lebu dina damar sareng",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [musik] nu peupeus. Abdi kedah ngurus éta",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "naon, salami urang aya di dieu, dugi ka",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "hiber jauh",
   "startMs": 211160,
