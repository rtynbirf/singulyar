 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ar_Arabic.srt",
 "юниты": [
  {
   "text": "[موسيقى]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "أمسية جديدة في المقهى،",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ضباب كثيف يذيب المنازل. [موسيقى]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "أتجول في الأحياء حيث الذكريات",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "يُجنّنني",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "أين في فصل الربيع الدافئ",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "الشتاء يغطي الروح",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "حيث طارت الحياة كالسهم متجاوزة التواريخ، متجاوزة",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "نحن",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "لقد اكتنزنا الأوراق، ناسين السبب الذي دفعنا إليه",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "نحن نعيش",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ودائماً ما بدا الأمر كذلك، [موسيقى]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "لا يزال هناك صوت \"دو\" في الأمام",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "مجرد وقت مستعار",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "لا يعطي شيئاً",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "وفجأة تسقط [الموسيقى] على قلبي",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ثلج بارد",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "نتعلم تقدير الموسيقى عندما نفقدها،",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "عندما ينطفئ نور أحدهم خلف الباب",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "نلوّح للقطارات المغادرة، محاولين",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "استجداء الإجابة من الماضي",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "نتعلم أن نحب عندما يكون الجو بارداً، [موسيقى]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "عندما يكون في راحة يديك رماد، وليس فولاذ. عن،",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "لو كنت أعرف مسبقاً، [موسيقى]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "كم سيؤلم هذا الشخص الشفاف في الروح",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "حزن",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "لم يقل [موسيقى]، لم يعانق، لم يكن لديه وقت",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "هذا دافع أبدي",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "لقد ادخرت كل شيء لوقت لاحق، قلبي ليس للآخرين",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "تم فتحه. [موسيقى]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "نحن نحارب الظل،",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "نستنزف طاقتنا بسبب أمور تافهة لا قيمة لها",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "ولا يمكنك أن ترى كيف يستقر الصقيع",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "على أكتافنا",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "لكن السعادة لا تكمن في بريق واجهة متجر،",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[الموسيقى] ليست في رزمة من الأوراق النقدية، بل في هدوء",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "حقيقة الأقارب، في دفئهم وسط العواصف. لكن",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "نحن لا نقدّر إلا ما هي عليه [الموسيقى] بالفعل",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "من المستحيل العودة",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "مواصلةً لرحلتي الطويلة",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "وغالباً ما تكون [الموسيقى] طريقاً بلا معنى،",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "نتعلم أن نقدر الموسيقى عندما نفقدها،",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "عندما ينطفئ نور أحدهم خلف الباب",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "نلوّح خلف القطارات المغادرة على أنغام الموسيقى،",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "محاولة التوسل إلى الماضي للحصول على إجابة",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "نتعلم أن نحب [الموسيقى] عندما تهدأ،",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "عندما يكون هناك رماد في راحة اليد، [موسيقى] وليس",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "فُولاَذ. عن،",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "لو كنت أعرف مسبقاً كيف سيصدر صوت الأنين",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "هذا الحزن الشفاف في الروح",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "اتصل بكبار السن، وعانقهم",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "بينما النبض مستمر",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "دعوا المظالم تمر، أنا أؤيد هذا اليوم",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "أنا أصلِّي",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "لأن جميع الأغاني لها نهاية",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "في النهاية، واحد",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[الغناء]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "نحن [الموسيقى] نبقى في ذاكرة المعالم البارزة،",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "نجلس منسيين",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "نتعلم أن نقدر الخسارة،",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "عندما ينطفئ صوت الموسيقى من خلف الباب",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ضوء",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "نلوّح للقطارات المغادرة، محاولين",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "استجداء الإجابة من الماضي",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "نتعلم أن نحب، [موسيقى]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "عندما برد الجو، عندما امتلأت راحة اليد بالرماد و",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "بلورة موسيقية مكسورة. ينبغي عليّ أن أتولى الأمر",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ما هو كائن، بينما نحن هنا، حتى",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "طار بعيدًا",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "الروح في الأفق البعيد",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[موسيقى]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
