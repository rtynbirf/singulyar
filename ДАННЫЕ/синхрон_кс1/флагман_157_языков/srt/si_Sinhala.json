  },
  {
   "text": "අපි [සංගීතය] සන්ධිස්ථාන මතකයේ රැඳී සිටිමු",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "අපි අමතක වෙලා ඉඳගෙන ඉන්නවා",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[සංගීතය]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "අපි පැරදුනාම අගය කරන්න ඉගෙන ගන්නවා",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "කෙනෙකුගේ සංගීතය දොර පිටුපසින් යන විට",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ආලෝකය",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "අපි පිටත් වන දුම්රිය පසුපස හඹා යමින් උත්සාහ කරමු",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "පිළිතුරක් සඳහා අතීතයට කන්නලව් කරන්න",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "අපි ආදරය කිරීමට ඉගෙන ගනිමු, [සංගීතය]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "එය සිසිල් වූ විට, අත්ලෙහි අළු ඇති විට සහ",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "කැඩුණු [සංගීත] ස්ඵටිකයක්. මම ඒක බලාගන්න ඕනේ",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "අපි මෙහි සිටින තාක් කල්, ඒ කියන්නේ",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "පියාසර කළා",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[සංගීතය]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ආත්මය ඈතට",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[සංගීතය]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
