  },
  {
   "text": "[සංගීතය]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ස්පන්දනය වන අතරතුර",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "දුක්ගැනවිලි පහව යන්න ඉඩ දෙන්න, මම අද මේකට කැමතියි",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "මම යාඥා කරනවා",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[සංගීතය]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
