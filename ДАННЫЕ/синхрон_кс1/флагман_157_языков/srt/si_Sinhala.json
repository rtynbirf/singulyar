   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "අපේ උරහිස් මත",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "නමුත් සතුට ඇත්තේ කඩේ කවුළුවක දිලිසීම තුළ නොවේ",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[සංගීතය] බිල්පත් ගොඩකින් නොව, නිහඬතාවයකින්",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "කුණාටු මැද ඔවුන්ගේ උණුසුම තුළ ඥාතීන්ගේ සත්‍යය. නමුත්",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "අපි අගය කරන්නේ [සංගීතය] දැනටමත් ඇති දේ පමණයි",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ආපසු යාමට නොහැකි ය",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "මගේ දිගු ගමන දිගටම කරගෙන යාම",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "සහ බොහෝ විට [සංගීතය] අර්ථ විරහිත මාවතකි",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "අපි [සංගීතය] නැති වූ විට අගය කිරීමට ඉගෙන ගනිමු",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "යමෙකුගේ ආලෝකය දොර පිටුපස නිවී ගිය විට",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "අපි පිටත් වූ දුම්රිය [සංගීතයට] පසුව අත වනමු",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "අතීතයෙන් පිළිතුරක් ඉල්ලා සිටීමට උත්සාහ කිරීම",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "අපි [සංගීතය] සිසිල් වූ විට එයට ආදරය කිරීමට ඉගෙන ගනිමු",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "අත්ලෙහි අළු ඇති විට, [සංගීතය] සහ නොවේ",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "යකඩ. පිළිබඳව",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "ඒක කොහොමද කෙඳිරිගාන්නේ කියලා මම කලින් දැනගෙන හිටියා නම්",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ආත්මයේ මෙම විනිවිද පෙනෙන දුක",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "මහලු අයට කතා කරන්න, ඔවුන්ව බදාගන්න",
   "startMs": 163040,
   "endMs": 165480,
