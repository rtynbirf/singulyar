 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/gn_Guarani.srt",
 "юниты": [
  {
   "text": "[mba'epu]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ka'aru pyahu cafetería-pe",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Niebla hũ omboyke óga. [mba'epu]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Aiko umi barrio oĩháme umi mandu’a",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "chembotavy",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Moõpa pe primavera haku asývape",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ro’y ojaho’i pe ánga",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ovevehápe tekove peteĩ flecha-icha ohasáva fecha, ohasava’ekue",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ore",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Rombyaty kuatiakuéra, oreresarái mba’érepa ore",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "jaikove",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ha akóinte ha’ete, [música]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "oĩ gueteri peteĩ tyapu C tenonderãme",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Ojerure préstamo-nte tiempo",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nome’ẽi mba’eve",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ha sapy’aitépe [músika] ho’a che korasõme",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "hielo ro’ysã",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Ñaaprende ñamombaʼe hag̃ua [músika] japerde jave",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ogue jave peteĩ tapicha resape okẽ rapykuéri",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Roñanduuka umi tren osẽva rire, roñeha’ãvo",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ejerure ñembohovái yma guarépe",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Ñaaprende jahayhu hagua ro'y jave, [música]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "oĩ jave tanimbu nde pópe, ndaha’éi acero. UPÉVA REHEGUA",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "aikuaárire de antemano, [música]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "mba’éichapa hasýta ko transparente ánga ryepýpe",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "ñembyasy",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nde’íri, [música] ndoañuãi, ndorekói tiempo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Kóva ha’e peteĩ motivo eterna",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Opa mba'e añongatu upe rire guarã, che korasõ ndaha'éi ambue tapichápe guarã",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ojeabri. [mba'epu]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ñañorairõ hína pe sombra ndive",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "jahapypa umi mba’e michĩva nandi ári",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ha ndaikatúi rehecha mbaʼéichapa oñemohenda ohóvo pe escarcha",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ñande jyva ári",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ha katu pe vy’apavẽ ndaha’éi peteĩ tenda ventána omimbipávape",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[música] ndaha’éi peteĩ montón de facturas-pe, ha katu peteĩ kirirĩháme",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "pe añetegua pariente-kuéra rehegua, haku jave umi tormenta apytépe. Hakatu",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ñamomba’énte pe [músika] oĩmava",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ndaikatúi ojevy",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Omotenondévo che pukukue",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ha heta jey [purahéi] ha’e peteĩ tape ndorekóiva sentido",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ñaaprende ñamombaʼe hag̃ua japerde jave [músika]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ogue jave peteĩ tapicha resape okẽ rapykuéri",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Roñanduuka [música] rire umi tren osẽva",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "oñeha’ãvo ojerure asy pe yma guarépe peteĩ ñembohovái",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Ñaaprende jahayhu [purahéi] ho’ysã rire",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "oĩ jave tanimbu umi palma-pe, [música] ha nahániri",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "kuarepotitã. UPÉVA REHEGUA",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Aikuaárire de antemano mba’éichapa oike ipy’aju",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ko ñembyasy hesakãva ánga ryepýpe",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ehenói umi tapicha tujápe, eñañuã chupekuéra",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "pe pulso opyrũ aja",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Tohasa umi queja, che aime pévape guarã ko árape",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Añembo’e",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Pórke entéro purahéi oreko peteĩ paha",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "ipahápe, peteĩ",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[purahéi]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ñande [música] japytáma umi mba’e hito mandu’ápe",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "jaguapy tesaráipe",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Ñaaprende ñamombaʼe hag̃ua japerde jave",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "osẽ jave peteĩ tapicha purahéi okẽ rapykuéri",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "tesakã",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Roñanduuka umi tren osẽva rire, roñeha’ãvo",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ejerure ñembohovái yma guarépe",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ñaaprende jahayhu, [música]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "ho’ysã jave, oĩ jave tanimbu umi palma-pe ha",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristal [música] oñembyaíva. Che añangarekova’erã hese",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "mba’épa oĩ, ñaime aja ko’ápe, peve",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "oveve mombyry",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ánga mombyry gotyo",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[mba'epu]",
   "startMs": 220082,
