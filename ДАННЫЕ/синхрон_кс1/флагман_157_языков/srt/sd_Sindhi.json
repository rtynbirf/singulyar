   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[موسيقي]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "ڇاڪاڻ ته سڀني گيتن جو هڪ اختتام هوندو آهي",
