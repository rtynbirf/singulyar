 "юниты": [
  {
   "text": "[موسيقي]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "ڪافي شاپ تي نئين شام،",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "گهاٽو ڪوهيڙو گهرن کي ڊاهي ٿو. [موسيقي]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "مان پاڙن ۾ گھمندو آهيان جتي يادون آهن",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "مونکي چريو ڪري ڇڏيو",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "جتي گرم بهار ۾",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "سيارو روح کي ڍڪي ٿو",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[موسيقي]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "جتي زندگي تير وانگر اڏامي وئي تاريخن کان، ماضي کان",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "اسان کي",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[موسيقي]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "اسان ڪاغذ گڏ ڪيا، وساري ڇڏيو ته اسان ڇو",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "اسين رهون ٿا",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "۽ اهو هميشه لڳي رهيو هو، [موسيقي]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "اڃا تائين هڪ C آواز اڳيان آهي",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[موسيقي]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "بس وقت قرض ورتو",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ڪجھ به نه ٿو ڏئي",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "۽ اوچتو [موسيقي] منهنجي دل تي پوي ٿي",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ٿڌي برف",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "جڏهن اسين هارايون ٿا ته اسين [موسيقي] جي تعريف ڪرڻ سکي وٺون ٿا،",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "جڏهن ڪنهن جي روشني دروازي جي پويان نڪري ويندي آهي",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "اسين روانگي ٿيندڙ ٽرينن جي پٺيان هٿ لوڏيندا آهيون، ڪوشش ڪندا آهيون",
   "startMs": 72200,
   "endMs": 75240,
