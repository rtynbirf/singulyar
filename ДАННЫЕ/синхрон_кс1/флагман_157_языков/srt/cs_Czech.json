  {
   "text": "Nový večer v kavárně",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Hustá mlha rozpouští domy. [hudba]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Toulám se čtvrtěmi, kde jsou vzpomínky",
