   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "zatímco puls tluče",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Nechť křivdy plynou, dnes jsem pro tohle",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Modlím se",
