  {
   "text": "smutek",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Neřekl, [hudba] neobjal, neměl čas",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "To je věčný motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Všechno jsem si schoval na později, mé srdce nepatří jiným",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "otevřeno. [hudba]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Bojujeme se stínem",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Vyhoříme kvůli prázdným maličkostem",
   "startMs": 106520,
   "endMs": 113316,
