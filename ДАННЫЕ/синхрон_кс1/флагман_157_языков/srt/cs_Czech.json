   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Hromadili jsme papíry a zapomínali, proč",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "žijeme",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "A vždycky se zdálo, [hudba]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Stále se ozve zvuk C",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Jen vypůjčený čas",
   "startMs": 52600,
   "endMs": 58520,
