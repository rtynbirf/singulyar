  },
  {
   "text": "na našich bedrech",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ale štěstí nespočívá v třpytu výlohy",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[hudba] ne v balíku bankovek, ale v tichém",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "pravda příbuzných, v jejich teple uprostřed bouří. Ale",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Oceníme jen to, co [hudba] už je",
