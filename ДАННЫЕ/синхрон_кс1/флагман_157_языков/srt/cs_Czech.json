  },
  {
   "text": "[hudba]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kde život letěl jako šíp kolem rande, kolem",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nás",
