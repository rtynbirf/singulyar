 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/is_Icelandic.srt",
 "юниты": [
  {
   "text": "[tónlist]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nýtt kvöld á kaffihúsinu",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Þykk þoka leysir upp hús. [tónlist]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ég reika um hverfin þar sem minningarnar eru",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "gera mig brjálaðan",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Hvar í hlýju vorinu",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Veturinn hylur sálina",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Þar sem lífið flaug eins og ör framhjá dögum, liðnum tíma",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "okkur",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Við höldum pappírum saman og gleymdum hvers vegna við",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "við lifum",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Og það virtist alltaf, [tónlist]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "það er enn C-hljóð framundan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Bara lánaður tími",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "gefur ekkert",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Og skyndilega fellur [tónlist] á hjarta mitt",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kaldur ís",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Við lærum að meta [tónlist] þegar við töpum",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "þegar ljósið hjá einhverjum slokknar á bak við dyrnar",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Við veifum á eftir brottfarandi lestum og reynum",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "biðja fortíðina um svar",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Við lærum að elska þegar það er kalt, [tónlist]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "þegar aska er í lófum þínum, ekki stál. UM",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "ef ég bara vissi það fyrirfram, [tónlist]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hvernig þessi gegnsæi mun sársaukinn í sálinni",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sorg",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hann sagði ekki, [tónlist] að hann faðmaði ekki, hann hefði ekki tíma",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Þetta er eilíf hvöt",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ég geymdi allt til seinna, hjarta mitt er ekki fyrir aðra",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "opnaði. [tónlist]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Við erum að berjast við skuggann",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "við brennum út yfir innantómum smáatriðum",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Og þú sérð ekki hvernig frostið sest",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "á herðum okkar",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "En hamingjan er ekki fólgin í glitrandi búðarglugga",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[tónlist] ekki í seðlabúnki, heldur í kyrrlátu",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "sannleikur ættingja, í hlýju þeirra meðal stormanna. En",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "við kunnum aðeins að meta það sem [tónlist] er nú þegar",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ómögulegt að snúa aftur",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Held áfram með mitt langa",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "og oft er [tónlist] tilgangslaus leið",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "við lærum að meta þegar við týnum [tónlist]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "þegar ljósið hjá einhverjum slokknar á bak við dyrnar",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Við veifum á eftir [tónlist] farnum lestum",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "að reyna að biðja fortíðina um svar",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Við lærum að elska [tónlist] þegar hún hefur kólnað",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "þegar aska er í lófunum, [tónlist] og ekki",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stál. UM",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Ef ég bara vissi fyrirfram hvernig það myndi væla inn",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "þessi gegnsæja sorg í sálinni",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Hringdu í gamla fólkið, faðmaðu það",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "á meðan púlsinn slær",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Láttu kvartanirnar líða hjá, ég er með þessu í dag",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ég bið",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Því öll lög hafa endi",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "að lokum, einn",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[söngur]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Við [tónlist] geymum minningu áfanga",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "við sitjum gleymd",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Við lærum að meta þegar við töpum",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "þegar tónlist einhvers fer út fyrir dyrnar",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ljós",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Við veifum á eftir brottfarandi lestum og reynum",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "biðja fortíðina um svar",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Við lærum að elska, [tónlist]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "þegar það kólnaði, þegar aska var í lófunum og",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "brotinn [tónlist] kristal. Ég ætti að sjá um það",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "hvað er, meðan við erum hér, þangað til",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "flaug í burtu",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "sál í fjarska",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[tónlist]",
   "startMs": 220082,
