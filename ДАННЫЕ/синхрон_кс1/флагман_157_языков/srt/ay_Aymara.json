{
 "канон": "пульс-синхрон/1",
 "songId": "ay_Aymara",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ay_Aymara.srt",
 "юниты": [
  {
   "text": "[jaylliwi]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Machaq jayp’ux café ukanwa",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Thixni nieblax utanakaruw ch’amakt’ayi. [jaylliwi]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Kawkhantï amtañanakajj utjki uka barrionakanwa sarnaqta",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "nayarux loco tukuyapxitu",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kawkhantix junt’u uma jalsunxa",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Juyphi pachax almaruw ch’allt’i",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kawkhantix jakäwix mä flecha ukham t’ijtäna pasado fechas, pasado",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "jiwasaru",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Papelnak apthapipjjayäta, kunatsa ukham lurapkta uk armasipjjayätwa",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "jiwasax jakasktanwa",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ukat sapa kutiw amuyasïna",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "nayraqatapanx wali C sonido ukaw utji",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Ukhamakiwa tiempo mayt’asiwayxi",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "janiw kuns churkiti",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ukat mä akatjamat chuymajar purtʼitu",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "thaya hielo",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Chhaqtasax wali askit uñjañ yatiqtanxa",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kunapachatix maynin qhanapax punku qhipäxan jist’antatäki ukhaxa",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Sarxir trenanak qhipat ampar luqtapxta, yant’asa",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "nayra sarnaqäwinakat mä jaysäwi mayipxam",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Jiwasax munasiñ yatiqtanwa kunapachatï thayäki ukhaxa",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kunapachatï palmeranakaman laqʼajj utjki ukhajja, janiw acerojj utjkiti. UKXATA",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "nayratpach yatiristxa",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kunjams aka transparente ukax almapan usuchjasini",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "llakisiña",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Jupax janiw siskänti, janiw jamp’att’askänti, janiw tiemponïkänti",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ukajj wiñayatak chʼamañchtʼatawa",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Taqi kuns qhipürutakiw imasta, chuymajax janiw mayninakatakikiti",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "jist’aratawa. [jaylliwi]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Jiwasax ch'amakampiw nuwasipxta",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "chʼusa jiskʼa yänakatwa phichhantastanjja",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ukat kunjamsa thayajj thaytʼani uk janiw uñjkasmati",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "jiwasan amparanakasampi",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ukampis kusisiñax janiw mä tienda ventanan kʼajkirïkiti",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "janiw mä qutu billetes ukankiti, jan ukasti mä llamp’u chuymankiwa",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "wila masinakan chiqapätapa, thaya thayt’aninakan junt’uñapataki. Ukampinsa",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "kunatix ukax nayratpach utjki ukak wali askit uñjtanxa",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "janiw kutt’añjamäkiti",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Nayan jaya pachax sarantaskakiwa",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ukat walja kutix ukax mä jan amuyuni thakhiwa",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "kunapachatix chhaqhayasktan ukhax wali askit uñjañ yatiqtanxa",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "kunapachatix maynin qhanapax punku qhipäxan jist’antatäki ukhaxa",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Jiwasax qhipat sarxir trenanakaruw amparapamp luqxatapxta",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "nayra pachat mä jaysäwi mayiñ yant’asa",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "ukar munasiñ yatiqapxta, kunapachatix thayt’awayxi ukhaxa",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kunapachatix palmeras ukan laq’unakax utjki, ukat jan",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "asiru. UKXATA",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Kunjamsa ukajj llaktʼasispa uk nayratpach yatjjayäta ukhajja",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "aka qhana llakisiña alma taypina",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Jilïr jaqinakar jawst’apxam, qhumantt’apxam",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ukatsti pulso ukax thuqt’aski",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Quejas ukax pasañapawa, nayax jichhüruw ukatakix jikxatastxa",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Nayajj mayisitwa",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kunatix taqi q’uchunakax mä tukuyawimpiw utji",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "tukuyaruxa, mä",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[q’ucht’aña]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Jiwasax jach’a lurawinakat amtasiñan qhipararaktanwa",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "armt’ataw qunt’asipxta",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Chhaqtʼasktan ukhajj wali askit uñjañwa yateqtanjja",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kunapachatix maynin musicapax punku qhipäxan mistuni ukhaxa",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "qhana",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Sarxir trenanak qhipat ampar luqtapxta, yant’asa",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "nayra sarnaqäwinakat mä jaysäwi mayipxam",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Munasiñ yatiqapxta",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "kunapachatix thayt’anxäna, kunapachatix palmeras ukan laq’unakax utjkän ukat",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "p’akjata cristal. Nayajj uk sum uñjañajawa",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "kunas utji, jiwasax akankkasax, ukakama",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "tʼijtjjäna",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "almax jayaruw mantawayi",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[jaylliwi]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
