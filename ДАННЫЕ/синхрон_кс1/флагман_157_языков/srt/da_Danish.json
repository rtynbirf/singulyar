 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/da_Danish.srt",
 "юниты": [
  {
   "text": "[musik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ny aften på kaffebaren",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Tyk tåge opløser huse. [musik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Jeg vandrer gennem kvartererne, hvor minderne er",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "drive mig til vanvid",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Hvor i den varme forår",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Vinteren dækker sjælen",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Hvor livet fløj som en pil forbi datoer, forbi",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "os",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Vi hamstrede papirer og glemte hvorfor vi",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vi lever",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Og det virkede altid som, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Der er stadig en C-lyd forude",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Bare lånt tid",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "giver ingenting",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Og pludselig falder [musikken] på mit hjerte",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kold is",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Vi lærer at værdsætte [musik], når vi taber",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "når nogens lys går ud bag døren",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Vi vinker efter de afgående tog og prøver",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "bede fortiden om et svar",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Vi lærer at elske, når det er koldt, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "når der er aske i dine håndflader, ikke stål. OM",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "hvis jeg bare vidste det på forhånd, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hvordan denne gennemsigtige vil smerte i sjælen",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sorg",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Han sagde ikke, [musik], at han ikke krammede, han havde ikke tid",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dette er et evigt motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Jeg gemte alt til senere, mit hjerte er ikke for andre",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "åbnet. [musik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Vi kæmper med skyggen",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "vi brænder ud over tomme bagateller",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Og du kan ikke se, hvordan frosten lægger sig",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "på vores skuldre",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Men lykken ligger ikke i glitteret i et butiksvindue",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musik] ikke i en bunke pengesedler, men i en stille",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "slægtninges sandhed, i deres varme blandt stormene. Men",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "vi værdsætter kun det, der allerede er [musik]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "umulig at vende tilbage",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Fortsætter min lange",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "og ofte er [musik] en meningsløs vej",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "vi lærer at værdsætte, når vi mister [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "når nogens lys går ud bag døren",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Vi vinker efter [musik] de afgåede tog",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "forsøger at bede fortiden om et svar",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Vi lærer at elske [musik], når den er kølet af",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "når der er aske i håndfladerne, [musik] og ikke",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stål. OM",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Hvis jeg bare vidste på forhånd, hvordan den ville klynke i",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "denne gennemsigtige tristhed i sjælen",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ring til de gamle, kram dem",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mens pulsen slår",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lad klagerne passere, jeg er med på dette i dag",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Jeg beder",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Fordi alle sange har en slutning",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "til sidst, en",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[sang]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Vi [musik] forbliver i erindringen om milepæle",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "vi sidder glemt",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Vi lærer at værdsætte, når vi taber",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "når nogens musik går ud bag døren",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lys",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Vi vinker efter de afgående tog og prøver",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "bede fortiden om et svar",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Vi lærer at elske, [musik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "da det kølede af, da der var aske i håndfladerne og",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "knust [musik] krystal. Jeg burde tage mig af det",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "hvad er, mens vi er her, indtil",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "fløj væk",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "sjælen i det fjerne",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
