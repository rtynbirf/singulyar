 "юниты": [
  {
   "text": "[música]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nova noite na cafeteria",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Um denso nevoeiro dissolve as casas. [música]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Eu vagueio pelos bairros onde as memórias estão",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Isso me deixa louco",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Onde na primavera quente",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "O inverno envolve a alma",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Onde a vida voou como uma flecha, ultrapassando datas, ultrapassando",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nós",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Acumulávamos papéis, esquecendo o porquê de o fazermos",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Nós vivemos",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "E sempre parecia, [música]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Ainda há um som de Dó pela frente",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Tempo emprestado",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Não dá nada",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "E de repente [a música] invade meu coração",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "gelo frio",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Aprendemos a apreciar [a música] quando perdemos",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "Quando a luz de alguém se apaga atrás da porta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Acenamos para os trens que partem, tentando",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "Implorar ao passado por uma resposta",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Aprendemos a amar quando está frio, [música]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "Quando houver cinzas em suas palmas, e não aço. SOBRE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Se eu soubesse de antemão, [música]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "Como essa transparência causará dor na alma",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristeza",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ele não disse [música], não abraçou, não teve tempo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Este é um motivo eterno",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Guardei tudo para depois, meu coração não pertence a outros",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "aberto. [música]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Estamos lutando contra a sombra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Nos esgotamos com trivialidades vazias",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "E você não consegue ver como a geada está se depositando",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "em nossos ombros",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mas a felicidade não está no brilho da vitrine de uma loja",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[música] não em um maço de notas, mas em silêncio",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "A verdade dos parentes, em seu calor em meio às tempestades. Mas",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Nós apenas apreciamos o que [a música] já é",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "impossível de retornar",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Continuando minha longa jornada",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "E muitas vezes [a música] é um caminho sem sentido",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Aprendemos a valorizar quando perdemos [a música]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "Quando a luz de alguém se apaga atrás da porta",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Acenamos para os trens que partem [ao som da música]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "tentando implorar ao passado por uma resposta",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Aprendemos a amar [a música] quando ela se acalma",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "quando há cinzas nas palmas das mãos, [música] e não",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "aço. SOBRE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Se eu soubesse de antemão como ele ia reclamar",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "essa tristeza transparente na alma",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ligue para os idosos, abrace-os",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "enquanto o pulso estiver batendo",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Deixemos as queixas de lado, hoje estou a favor disso",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Eu rezo",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Porque todas as músicas têm um final",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "No final, um",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[cantoria]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
