 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/tt_Tatar.srt",
 "юниты": [
  {
   "text": "Кафеда яңа кич",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Куе томан йортларны эретә",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Мин хатирәләр булган районнар буйлап йөрим",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "мине акылдан яздыр",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Җылы язда кайда",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Кыш җанны каплап ала",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "Тормыш ук кебек очып үткән даталар, үткәннәр",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "безне",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "Без кәгазьләрне җыеп куйдык, ни өчен икәнен онытып",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "без яшибез",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Һәм ул һәрвакыт, кебек тоелды",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "алда әле С авазы бар",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Бары тик вакытны гына алдылар",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "бернәрсә дә бирми",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Һәм кинәт кенә йөрәгемә төшә",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "салкын боз",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Без югалтканда [музыканы] кадерләргә өйрәнәбез",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ишек артында кемнеңдер уты сүнгәндә",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Без китү поездлары артыннан кул болгап, тырышып карыйбыз",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "үткәннән җавап сора",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Салкын булганда без яратырга өйрәнәбез",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "учларыңда корыч түгел, ә көл булганда. ТУРЫНДА",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Әгәр мин алдан белсәм иде",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "бу үтә күренмәле җанда ничек авыртачак",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "кайгы",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ул кочакламады, вакыты юк дип әйтмәде",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Бу мәңгелек мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Мин барысын да соңрак өчен сакладым, йөрәгем башкалар өчен түгел",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ачылды",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Без күләгә белән көрәшәбез",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "без буш вак-төяк әйберләр өчен янып бетәбез",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ә сез туңның ничек утыруын күрә алмыйсыз",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "безнең җилкәләрдә",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ләкин бәхет кибет витринасының ялтыравыгында түгел",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "купюралар өемендә түгел, ә тыныч кына",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "туганнарның хакыйкатье, давыллар арасында аларның җылылыгында. Ләкин",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "без ның инде булганын гына бәялибез",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "кире кайтару мөмкин түгел",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Озын вакытымны дәвам итәм",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "һәм еш кына мәгънәсез юл",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "без [музыканы] югалтканда кадерләргә өйрәнәбез",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ишек артында кемнеңдер уты сүнгәндә",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Киткән поездлар артыннан без кул болгыйбыз",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "үткәннән җавап сорарга тырыша",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Без суынгач, аны яратырга өйрәнәбез",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "уч төбендә көл булганда, һәм түгел",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "корыч. ТУРЫНДА",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Аның ничек мыгырдавын алдан белсәм иде",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "җандагы бу ачык моңсулык",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Картларны чакырыгыз, кочаклагыз",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "пульс тибеп торганда",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Зарлар үтеп китсен, мин бүген моның өчен",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Мин дога кылам",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "Чөнки барлык җырларның да ахыры бар",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "ахыр чиктә, бер",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[җырлау]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Без истәлекле вакыйгалар хәтерендә калабыз",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "без онытылып утырабыз",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "Югалтканда кадерен белергә өйрәнәбез",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "ишек артында кемнеңдер музыкасы ишетелгәндә",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "яктылык",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Без китү поездлары артыннан кул болгап, тырышып карыйбыз",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "үткәннән җавап сора",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Без яратырга өйрәнәбез",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "суынгач, пальмаларда көл булганда һәм",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "ватык кристалл. Мин моның турында кайгыртырга тиеш",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "без монда булганда, нәрсә ул, гәрчә",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "очып китте",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "җан еракка",
   "startMs": 213560,
