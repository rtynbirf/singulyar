{
 "канон": "пульс-синхрон/1",
 "songId": "bo_Tibetan",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/bo_Tibetan.srt",
 "юниты": [
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "ཇ་ཁང་དུ་དགོང་མོ་གསར་བ།",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "སྨུག་པ་མཐུག་པོས་ཁང་པ་བཞུ་བ། [རོལ་དབྱངས]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ང་དྲན་པ་ཡོད་སའི་གྲོང་གསེབ་བརྒྱུད་ནས་འཁྱམས།",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ང་སྨྱོན་པ་བཟོས།",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "དཔྱིད་དཔྱིད་དྲོན་མོའི་ནང་གང་དུ།",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "དགུན་དགུན་གྱིས་རྣམ་ཤེས་བཀབ་ཡོད།",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "གང་དུ་ཚེ་སྲོག་འདས་ཟིན་པའི་མདའ་ལྟར་འཕུར་སོང་།",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ང་ཚོ།",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ཤོག་བུ་བསྡུ་གསོག་བྱས་པ་དང་། ང་ཚོས་ཅིའི་ཕྱིར་བརྗེད་སོང་།",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་འཚོ་བཞིན་ཡོད།",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "དེ་ནས་རྟག་ཏུ་[རོལ་དབྱངས།]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ད་དུང་མདུན་དུ་Cསྒྲ་ཡོད།",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "དུས་ཚོད་གཡར་མ་ཙམ་རེད།",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "གང་ཡང་མི་སྤྲོད།",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "གློ་བུར་དུ་ངའི་སེམས་ལ་ལྷུང་སོང་།",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "འཁྱགས་རོམ་གྲང་མོ།",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ཕམ་དུས་རོལ་དབྱངས་ལ་ཡིད་རངས་བྱེད་ཤེས་ཀྱི་ཡོད།",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "སྒོའི་རྒྱབ་ནས་མི་གཞན་ཞིག་གི་འོད་མེད་པར་གྱུར་སྐབས།",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་མེ་འཁོར་འགྲོ་བཞིན་པའི་རྗེས་སུ་ལག་གཡུག་བྱས་ཏེ།",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "འདས་པ་ལ་ལན་ཞིག་ཞུ་དགོས།",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་གྲང་མོ་ཡོད་དུས་བརྩེ་བ་སྦྱོང་བ་ཡིན། [རོལ་དབྱངས།]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "ཁྱེད་ཀྱི་ལག་པར་ཐལ་བ་ཡོད་དུས། ལྕགས་རིགས་མིན། ཉེ་སྐོར་དུ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "གལ་ཏེ་ངས་སྔོན་ནས་ཤེས་ན། [རོལ་དབྱངས།]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "དྭངས་གསལ་འདིས་སེམས་ལ་ཇི་ལྟར་ན་བ།",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "བློ་འགྱོད།",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "ཁོས་བཤད་མ་སོང་། [རོལ་དབྱངས།] ཁོས་འཐམ་མ་སོང་། ཁོང་ལ་དུས་ཚོད་མེད།",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "འདི་ནི་རྟག་པའི་ཀུན་སློང་ཞིག་ཡིན།",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "ངས་ཡོད་ཚད་ཕྱི་མའི་ཆེད་དུ་ཉར་འདུག ངའི་སེམས་པ་གཞན་གྱི་ཆེད་དུ་མ་རེད།",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ཁ་ཕྱེ་ཡོད། [རོལ་དབྱངས]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་གྲིབ་མ་དང་འཐབ་རྩོད་བྱེད་བཞིན་ཡོད།",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་སྟོང་ཆ་ཆུང་ཆུང་ལ་མེར་སྲེག་བཏང་ཡོད།",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "འཁྱགས་ཟིལ་ཇི་ལྟར་ལྷུང་བ་ཁྱོད་ཀྱིས་མཐོང་མི་ཐུབ།",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ང་ཚོའི་དཔུང་པ་སྟེང་།",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "འོན་ཀྱང་བདེ་སྐྱིད་ནི་ཚོང་ཁང་གི་སྒེའུ་ཁུང་གི་འོད་མདངས་ལས་མེད།",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས།] དངུལ་གྱི་ཐུམ་སྒྲིལ་ནང་མ་ཡིན་པར་ཁུ་སིམ་མེའི་ནང་དུ།",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ཉེ་འབྲེལ་གྱི་བདེན་པ། རླུང་དམར་ཁྲོད་ཀྱི་དྲོད་ཁོལ། འོན་ཀྱང",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་སྔོན་ནས་རོལ་དབྱངས་ལ་དགའ་པོ་བྱེད་ཀྱི་ཡོད།",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ཕྱིར་ལོག་བྱེད་མི་ཐུབ།",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "མུ་མཐུད་དུ་ངའི་ཡུན་རིང་།",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ཡང་ཡང་རོལ་དབྱངས་ནི་དོན་མེད་ཀྱི་ལམ་ཞིག་རེད།",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་རོལ་དབྱངས་བརླག་དུས་ཡིད་རངས་བྱེད་ཤེས་ཀྱི་ཡོད།",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "སྒོའི་རྒྱབ་ནས་མི་གཞན་ཞིག་གི་འོད་མེད་པར་གྱུར་སྐབས།",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་མེ་འཁོར་འགྲོ་བའི་རྗེས་སུ་ལག་གཡུག་བྱས།",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "འདས་པའི་དུས་ལ་ལན་ཞིག་ཞུ་བར་འབད་བཞིན་ཡོད།",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་རོལ་དབྱངས་ལ་དགའ་པོ་བྱེད་ཤེས་པ་དེ་བསིལ་པོ་ཆགས་རྗེས།",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "ལག་མཐིལ་དུ་གོ་ཐལ་ཡོད་དུས། [རོལ་དབྱངས་] དང་མིན།",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ལྕགས། ཉེ་སྐོར་དུ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "གལ་ཏེ་ངས་སྔོན་ནས་དེ་གང་འདྲ་བྱས་ནས་ངུ་སྐད་རྒྱག་རྒྱུ་ཡིན་པ་ཤེས་ན།",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "སེམས་ཀྱི་དྭངས་གསལ་གྱི་བློ་འགྱོད་འདི།",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "རྒན་རྒོན་རྣམས་ལ་ཁ་པར་གཏོང་དང་།",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "སྙིང་རྩ་འཕར་བཞིན་པའི་སྐབས་སུ།",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "སྡུག་བསྔལ་དེ་དག་འདས་པར་ཤོག ང་དེ་རིང་འདིའི་ཆེད་དུ་ཡིན།",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "སྨོན་ལམ་འདེབས།",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "གང་ཡིན་ཟེར་ན་གླུ་གཞས་ཚང་མར་མཇུག་སྡོམ་ཡོད།",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "མཐའ་མར་གཅིག",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[གཞས་གཏོང་བ།]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་ [རོལ་དབྱངས་] ལམ་ཚད་རྡོ་རིང་གི་དྲན་ཤེས་ནང་ལུས་ཡོད།",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་བརྗེད་འདུག",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ཤོར་དུས་ཡི་རངས་བྱེད་ཤེས་ཀྱི་ཡོད།",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "མི་ཞིག་གི་རོལ་དབྱངས་སྒོའི་རྒྱབ་ནས་ཕྱིར་ཐོན་དུས།",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "འོད།",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་མེ་འཁོར་འགྲོ་བཞིན་པའི་རྗེས་སུ་ལག་གཡུག་བྱས་ཏེ།",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "འདས་པ་ལ་ལན་ཞིག་ཞུ་དགོས།",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་བརྩེ་བ་སྦྱོང་བ་དང་། [རོལ་དབྱངས།]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "དེ་བསིལ་དུས་ལག་མཐིལ་དུ་གོ་ཐལ་ཡོད་དུས།",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "ཆག་པ་ [རོལ་དབྱངས།] ཕྲེང་བ། ངས་དེ་ལ་བདག་སྐྱོང་བྱེད་དགོས།",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ག་རེ་རེད་ཟེར་ན། ང་ཚོ་འདིར་ཡོད་རིང་།",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "འཕུར་སོང་།",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "རྣམ་ཤེས་ཐག་རིང་དུ་བསྐྱལ།",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
