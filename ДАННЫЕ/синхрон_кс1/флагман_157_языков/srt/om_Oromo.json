   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muuziqaa]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Bakka jireenyi akka xiyyaa balali'ee guyyoota darbe, darbe",
   "startMs": 33320,
   "endMs": 38645,
