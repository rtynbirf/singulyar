   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "jiraanna",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Yeroo hundumaas, [muuziqaa] fakkaata ture",
