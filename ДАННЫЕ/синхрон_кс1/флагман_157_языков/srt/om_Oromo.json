   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Awwaara furdaan manneen ni diiga. [muuziqaa]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ollaa yaadannoowwan jiran keessa nan naanna'a",
