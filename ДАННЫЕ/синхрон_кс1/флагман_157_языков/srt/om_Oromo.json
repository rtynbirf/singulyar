   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "na maraachisaa",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Bakka birraa ho'aa keessa",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Qilleensi qorraa lubbuu uwwisa",
