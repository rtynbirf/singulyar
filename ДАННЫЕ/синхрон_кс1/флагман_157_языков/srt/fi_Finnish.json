   "level": "line"
  },
  {
   "text": "surua",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hän ei sanonut, [musiikki] hän ei halannut, hänellä ei ollut aikaa",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Tämä on ikuinen motiivi",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Säästin kaiken myöhempää varten, sydämeni ei ole muita varten",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "avattu. [musiikki]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Taistelemme varjoa vastaan",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "me palamme loppuun tyhjien pikkujuttujen takia",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Etkä näe, miten pakkanen laskeutuu",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "harteillamme",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mutta onni ei ole kaupan ikkunan kimalluksessa",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musiikki] ei kasassa seteleitä, vaan hiljaisessa",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "sukulaisten totuus, heidän lämmössään myrskyjen keskellä. Mutta",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "arvostamme vain sitä, mitä [musiikki] jo on",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "mahdotonta palauttaa",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Jatkan pitkää uraani",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ja usein [musiikki] on merkityksetön polku",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "opimme arvostamaan sitä, kun menetämme [musiikin]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "kun jonkun valo sammuu oven takana",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Vilkuttelemme lähteneiden junien perässä [musiikki]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "yrittää anella menneisyydeltä vastausta",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Opimme rakastamaan [musiikkia], kun se on jäähtynyt",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kun kämmenissä on tuhkaa, [musiikkia] eikä",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "teräs. NOIN",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Jospa tietäisin etukäteen, miten se vinkuisi sisään",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "tämä läpinäkyvä suru sielussa",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Soita vanhuksille, halaa heitä",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "samalla kun pulssi lyö",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Anna valitusten mennä ohi, olen tämän puolesta tänään",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Minä rukoilen",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Koska kaikilla lauluilla on loppunsa",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "lopulta yksi",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[laulaa]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Me [musiikki] jäämme muistoihin virstanpylväistä",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "me istumme unohdettuina",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Opimme arvostamaan sitä, kun häviämme",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kun jonkun musiikki katoaa oven taakse",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "valo",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Vilkuttelemme lähtevien junien perään ja yritämme",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "pyydä menneisyydeltä vastausta",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Opimme rakastamaan, [musiikkia]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "kun se jäähtyi, kun kämmenissä oli tuhkaa ja",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "rikkinäinen [musiikki]kristalli. Minun pitäisi huolehtia siitä",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "mitä on, niin kauan kuin olemme täällä, kunnes",
