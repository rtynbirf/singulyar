 "юниты": [
  {
   "text": "[musiikki]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Uusi ilta kahvilassa",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Paksu sumu sulattaa taloja. [musiikki]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Vaellan läpi lähiöiden, joissa muistot ovat",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ajaa minut hulluksi",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Missä lämpimänä keväänä",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Talvi peittää sielun",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Missä elämä lensi kuin nuoli ohi päivämäärien, ohi",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "meille",
