   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "pyydä menneisyydeltä vastausta",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Opimme rakastamaan, kun on kylmä, [musiikki]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kun kämmenissäsi on tuhkaa, ei terästä. NOIN",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "jospa tietäisin etukäteen, [musiikki]",
