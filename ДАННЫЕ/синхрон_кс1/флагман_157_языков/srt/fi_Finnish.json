   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Hamstrasimme papereita unohtaen miksi",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "me elämme",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ja aina tuntui, [musiikki]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "edessä on vielä C-äänne",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musiikki]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Vain lainattua aikaa",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ei anna mitään",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ja yhtäkkiä [musiikki] valtaa sydämeni",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kylmää jäätä",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Opimme arvostamaan [musiikkia], kun häviämme",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kun jonkun valo sammuu oven takana",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Vilkuttelemme lähtevien junien perään ja yritämme",
