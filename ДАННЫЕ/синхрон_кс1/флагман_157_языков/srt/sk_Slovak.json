 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sk_Slovak.srt",
 "юниты": [
  {
   "text": "[hudba]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nový večer v kaviarni",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Hustá hmla rozpúšťa domy. [hudba]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Túlam sa po štvrtiach, kde sú spomienky",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "privádza ma do šialenstva",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kde v teplej jari",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Zima zahalí dušu",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kde život letel ako šíp okolo rande, okolo",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nás",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Hromadili sme papiere a zabúdali sme, prečo",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "žijeme",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "A vždy sa zdalo, [hudba]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "stále je pred nami zvuk C",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Len požičaný čas",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nedáva nič",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "A zrazu [hudba] padá na moje srdce",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "studený ľad",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Učíme sa vážiť si [hudbu], keď prehrávame",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "keď niekomu zhasne svetlo za dverami",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Mávame za odchádzajúcimi vlakmi a snažíme sa",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "prosiť minulosť o odpoveď",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Učíme sa milovať, keď je zima, [hudba]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "keď máš v dlaniach popol, nie oceľ. O",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "keby som to len vedel vopred, [hudba]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "ako tento priehľadný bude bolieť dušu",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "smútok",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nepovedal, [hudba] neobjal, nemal čas",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Toto je večný motív",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Všetko som si odložil na neskôr, moje srdce nepatrí iným",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "otvorené. [hudba]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Bojujeme s tieňom",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "vyhoríme kvôli prázdnym maličkostiam",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "A nevidíš, ako sa mráz usadzuje",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "na našich pleciach",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ale šťastie nie je v trblietaní výkladu",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[hudba] nie v zväzku bankoviek, ale v tichom",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "pravda príbuzných, v ich teple uprostred búrok. Ale",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Oceňujeme len to, čo [hudba] už je",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "nemožné vrátiť sa",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Pokračujem v mojom dlhom",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "a často je [hudba] nezmyselnou cestou",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "naučíme sa vážiť si, keď stratíme [hudbu]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "keď niekomu zhasne svetlo za dverami",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Mávame za [hudbou] odchádzajúcimi vlakmi",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "snaží sa prosiť minulosť o odpoveď",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Naučíme sa milovať [hudbu], keď vychladne",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "keď je v dlaniach popol, [hudba] a nie",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "oceľ. O",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Keby som len vedel vopred, ako to bude kňučať",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "tento priehľadný smútok v duši",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Zavolajte starým ľuďom, objímte ich",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "kým pulz bije",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Nech krivdy pominú, dnes som za to",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Modlím sa",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Pretože všetky piesne majú koniec",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "nakoniec jeden",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[spev]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "My [hudba] zostávame v pamäti míľnikov",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "sedíme zabudnutí",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[hudba]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Učíme sa vážiť si, keď prehrávame",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "keď niečia hudba znie za dverami",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "svetlo",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Mávame za odchádzajúcimi vlakmi a snažíme sa",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "prosiť minulosť o odpoveď",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Učíme sa milovať, [hudba]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "keď sa ochladilo, keď bol v palmách popol a",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "rozbitý [hudobný] krištáľ. Mal by som sa o to postarať",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "čo je, kým sme tu, až kým",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "odletel",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[hudba]",
