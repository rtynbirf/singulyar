{
 "канон": "пульс-синхрон/1",
 "songId": "tum_Tumbuka",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/tum_Tumbuka.srt",
 "юниты": [
  {
   "text": "[sumu]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Mazuŵa ghaphya pa malo ghakuguliska khofi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Chiwuvi chikuru chikusungunura nyumba. [sumu]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Nkhuyendayenda mu vigaŵa ivyo vikukumbukika",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "kunipangiska kuti niŵe wakupenga",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kuli mu nyengo yakufunda ya masika",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Chiwuvi chikubenekelera mzimu",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ku malo uko umoyo ukawuluka nga ni muvi kujumpha mazuŵa, kujumpha",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ise",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Tikawunjika mapepara, kuluwa chifukwa icho tika",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "tikukhala",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ndipo nyengo zose vikawonekanga kuti, [nyimbo]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "paliso mazgu gha C panthazi",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Nkhabwereka waka nyengo",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "wakupeleka kanthu yayi",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ndipo mwamabuci [nyimbo] zikuwira pa mtima wane",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "aisi wakuzizima",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Tikusambira kuwonga [nyimbo] para taŵavya",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "para ungweru wa munthu munyake wazima kuseri kwa mulyango",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Tikuchemerezga pamanyuma pa sitima izo zikufuma, kuyezgayezga",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "pemphani ivyo vikachitika kumanyuma kuti muzgore",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Tikusambira kutemwa para kuli mphepo, [nyimbo]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "para muli phulusa mu mawoko ghinu, chisulo yayi. PAFUPIFUPI",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "usange ningamanya pambere nyengo yindakwane, [nyimbo]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "umo wakuwonekera uyu wazamupwetekera mu mzimu",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "chitima",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Wakayowoyapo yayi, [nyimbo] wakakhumbatira yayi, wakaŵavya nyengo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ici nchilato ca muyirayira",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Nkhasunga vyose kuti nizakaviwone pamanyuma, mtima wane ngwa ŵanji yayi",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "wakajulika. [sumu]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Tikulimbana na mthunzi",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "tikuwotcha pa vinthu vichokovichoko vyawakawaka",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ndipo mukuwona yayi umo chiwuvi chikukhalira",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "pa mapewa ghithu",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Kweni chimwemwe chili mu kuwala kwa pa windo la sitoro yayi",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[nyimbo] mu mzere wa mabiliyoni yayi, kweni mu malo ghambura chiwawa",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "unenesko wa ŵabali, mu kutentha kwawo pakati pa chimphepo chikuru. Kweni",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "tikuwonga waka ivyo [nyimbo] zilipo kale",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "nchakusuzga kuwelera",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kupitilira nyengo yitali yane",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ndipo kanandi [nyimbo] ni nthowa yambura ng’anamuro",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "tikusambira kuwonga para taŵavya [nyimbo]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "para ungweru wa munthu munyake wazima kuseri kwa mulyango",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Tikuchemerezga pamanyuma pa [nyimbo] sitima izo zafumapo",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "kuyezgayezga kupempha ivyo vikachitika kumanyuma kuti ŵamuzgore",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Tikusambira kutemwa [nyimbo] para zazizima",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "para pali phulusa mu viŵegha, [nyimbo] ndipo yayi",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "chisulo. PAFUPIFUPI",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Usange ningamanya pambere nyengo yindakwane umo yizamuŵira mu 2019",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "chitima ichi chowonekera mu mzimu",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Yimbirani ŵachekuru, muŵavumbatire",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "apo mtima ukutimba",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lekani madandaulo ghajumphe, ine ndine wa ichi lero",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Nkhulomba",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Chifukwa sumu zose zikuŵa na umaliro",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "paumaliro, yumoza",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kwimba]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ife [nyimbo] tikulutilira kukumbukira vinthu vyakuzirwa",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "tikukhala ŵakuluwa",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Tikusambira kuwonga para tataya",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "para sumu za munthu munyake zafuma kuseri kwa mulyango",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ungweru",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Tikuchemerezga pamanyuma pa sitima izo zikufuma, kuyezgayezga",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "pemphani ivyo vikachitika kumanyuma kuti muzgore",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Tikusambira kutemwa, [nyimbo]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "para kwazizima, apo pakaŵa phulusa mu makuni gha mijuwa ndipo",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristalo wakuphwanyika [nyimbo]. Nkhwenera kuyipwelelera",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "nchivichi icho chili, apo tili pano, m’paka",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "wakawuluka kufumapo",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[sumu]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "mzimu mu mtunda",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[sumu]",
