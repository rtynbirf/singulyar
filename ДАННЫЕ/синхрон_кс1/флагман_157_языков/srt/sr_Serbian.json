{
 "канон": "пульс-синхрон/1",
 "songId": "sr_Serbian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sr_Serbian.srt",
 "юниты": [
  {
   "text": "[музика]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ново вече у кафићу",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Густа магла раствара куће. [музика]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Лутам кроз крајеве где су успомене",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "излуђује ме",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Где у топлом пролећу",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Зима покрива душу",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Где је живот летео као стрела поред датума, прошлости",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "нас",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Гомилали смо папире, заборављајући зашто смо",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "живимо",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "И увек се чинило, [музика]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "још увек се чује звук Ц испред",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Само позајмљено време",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "не даје ништа",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "И одједном [музика] пада на моје срце",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "хладни лед",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Учимо да ценимо [музику] када губимо",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "када се нечије светло угаси иза врата",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Машемо за одлазећим возовима, покушавајући",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "молити прошлост за одговор",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Учимо да волимо када је хладно, [музика]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "када је у твојим длановима пепео, а не челик. О",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "кад бих само знао унапред, [музика]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "како ће овај провидни да боли у души",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "туга",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Није рекао, [музика] није загрлио, није имао времена",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ово је вечни мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Све сам сачувао за касније, моје срце није за друге",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "отворено. [музика]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Боримо се са сенком",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "изгоримо због празних ситница",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "И не видиш како се мраз слега",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "на нашим раменима",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Али срећа није у сјају излога",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[музика] не у гомили новчаница, већ у тихом",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "истина рођака, у њиховој топлини међу олујама. Али",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ценимо само оно што [музика] већ јесте",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "немогуће вратити се",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Настављам свој дуги",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "и често је [музика] бесмислен пут",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "учимо да ценимо када изгубимо [музику]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "када се нечије светло угаси иза врата",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Машемо за [музиком] одлазећим возовима",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "покушавајући да молим прошлост за одговор",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Учимо да волимо [музику] када се охлади",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "када је пепео у длановима, [музика] а не",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "челик. О",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Кад бих само унапред знао како ће цвилити",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ова провидна туга у души",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Позовите старе људе, загрлите их",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "док пулс куца",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Нека прођу негодовања, ја сам за ово данас",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Молим се",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Јер све песме имају крај",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "на крају, један",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[пева]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ми [музика] остајемо у сећању на прекретнице",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "седимо заборављени",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Учимо да ценимо када губимо",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "када нечија музика одзвања иза врата",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "светлост",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Машемо за одлазећим возовима, покушавајући",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "молити прошлост за одговор",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Учимо да волимо, [музика]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "када се охладило, када је било пепела у длановима и",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "сломљени [музички] кристал. Требало би да се побринем за то",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "шта је, док смо овде, до",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "одлетео",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "душа у даљину",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
