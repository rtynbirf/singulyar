{
 "канон": "пульс-синхрон/1",
 "songId": "dv_Divehi",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/dv_Divehi.srt",
 "юниты": [
  {
   "text": "[މިއުޒިކް]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "ކޮފީ ޝޮޕްގައި އާ ހަވީރު،",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ބޯ ފޮގެއްގެ ސަބަބުން ގެތައް ގިރާލައެވެ. [މިއުޒިކް]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ހަނދާންތައް ހުންނަ އަވަށްތަކުގެ ތެރޭގައި އަހަރެން އުޅެމެވެ",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "އަހަރެން މޮޔަކޮށްލާށެވެ",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ހޫނު ބަހާރު މޫސުމުގައި ކޮންތާކު ހެއްޔެވެ",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "ވިންޓަރ އިން ނަފްސު ނިވާކޮށްދެއެވެ",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "އެތަނުގައި ދިރިއުޅުން އުދުހިގެން ދިޔައީ ތިރިއެއް ފަދައިން މާޒީގެ ތާރީޚުތަކެއް، މާޒީއެވެ",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ކަރުދާސްތައް އެއްކޮށްލީ، އަހަރެމެން ކީއްވެގެންކަން ހަނދާން ނެތިގެންނެވެ",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން އުޅެނީ",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "އަދި އަބަދުވެސް ހީވީ، [މިއުޒިކް] އެވެ",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "އަދިވެސް ކުރިއަށް އޮތީ ސީ އަޑެކެވެ",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "ހަމަ ދަރަންޏަށް ނެގި ވަގުތު",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "އެއްވެސް އެއްޗެއް ނުދެއެވެ",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "އަދި ކުއްލިއަކަށް [މިއުޒިކް] އަހަރެންގެ ހިތަށް ވެއްޓެއެވެ",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ފިނި އައިސް އެވެ",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "އަހަރެމެންނަށް [މިއުޒިކް] ގެ އަގުވަޒަން ކުރަން ދަސްކުރަނީ އަހަރެމެން ބަލިވުމުން،",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ދޮރުގެ ފަހަތުން މީހެއްގެ އަލި ނިއްވާލުމުންނެވެ",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ފުރަން އުޅޭ ރޭލުތަކުގެ ފަހަތުން ރާޅު އަޅަނީ، މަސައްކަތް ކުރަމުންނެވެ",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ޖަވާބަކަށް މާޒީ އާދޭސް ކުރާށެވެ",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ލޯބިވާން ދަސްކުރަނީ ފިނި ވަގުތެއްގައި، [މިއުޒިކް] އެވެ",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "ދަގަނޑު ނޫން، އަތްތިލަގައި އަޅި ހުންނައިރު. ގުޅިގެން،",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "ކުރިން އެނގިފައި އޮތްނަމަ، [މިއުޒިކް] އެވެ",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "މި ހާމަކަން ބޮޑު އެއްޗެއް ނަފްސުގައި ތަދުވާނެ ގޮތެވެ",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "ހިތާމައެވެ",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "އޭނާ ނުބުނޭ، [މިއުޒިކް] އޭނާ ބައްދާލީކީ ނޫން، އޭނާއަށް ވަގުތެއް ނުލިބޭ",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "މިއީ ދާއިމީ މޮޓިވްއެކެވެ",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "އަހަރެން ހުރިހާ ކަމެއް ރައްކާކުރީ ފަހުން، އަހަރެންގެ ހިތަކީ އެހެން މީހުންނަށްޓަކައެއް ނޫނެވެ",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ހުޅުވާލިއެވެ. [މިއުޒިކް]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "އަޅުގަނޑުމެން މި ހަނގުރާމަ ކުރަނީ ހިޔަނި،",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ހުސް ކުދިކުދި ކަންތައްތަކުގެ މައްޗަށް އަނދާ ހުލިވެއެވެ",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "އަދި ފިނިހޫނުމިން ޖަމާވަމުންދާ ގޮތެއް ވެސް ނުފެނެއެވެ",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "އަހަރެމެންގެ ކޮނޑުގައި",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "އެކަމަކު އުފާވެރިކަމަކީ ފިހާރައެއްގެ ކުޑަދޮރެއްގެ ވިދުވަރުގައި ނޫން،",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް] ބިލްތަކުގެ ވަޑެއްގައި ނޫން، ހަމަހިމޭން ތަނެއްގައެވެ",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ގާތްތިމާގެ މީހުންގެ ހަގީގަތް، ތޫފާންތަކުގެ ތެރޭގައި އެމީހުންގެ ހޫނުކަމުގައި. އެކަމަކު",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "އަޅުގަނޑުމެން ހަމައެކަނި އަގުވަޒަން ކުރަނީ [މިއުޒިކް] މިހާރުވެސް ހުރި އެއްޗެއް",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "އެނބުރި އައުން މުސްތަޙީލު ކަމެކެވެ",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "އަހަރެންގެ ދިގު ކުރިއަށް ގެންދަމުންނެވެ",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "އަދި ގިނަ ފަހަރަށް [މިއުޒިކަކީ] މާނައެއް ނެތް މަގެއް،",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން [މިއުޒިކް] ގެއްލޭ ވަގުތު އަގުވަޒަން ކުރަން ދަސްކުރަން،",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ދޮރުގެ ފަހަތުން މީހެއްގެ އަލި ނިއްވާލުމުންނެވެ",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން [މިއުޒިކް] އަށް ފަހު ފުރައިގެން ދިޔަ ރޭލުތަކަށް ރާޅު އަޅަނީ،",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ޖަވާބެއް ހޯދުމަށް މާޒީގައި އާދޭސް ކުރަން މަސައްކަތް ކުރަމުންނެވެ",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން [މިއުޒިކަށް] ލޯބިވާން ދަސްކުރަނީ އެ ފިނިވެއްޖެނަމަ،",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "އަތްތިލަތަކުގައި އަޅި ހުންނައިރު، [މިއުޒިކް] އަދި ނޫން",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ދަގަނޑު. ގުޅިގެން،",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "އެއީ ހީނލާނެ ގޮތް ކުރިން އެނގުނު ނަމައެވެ",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ނަފްސުގައިވާ މި ހާމަކަން ބޮޑު ހިތާމައެވެ",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "މުސްކުޅިންނަށް ގޮވާ، ބައްދާލާ،",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ނާރުތައް ތެޅެމުން ދަނިކޮށެވެ",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ޝަކުވާތައް ފާއިތުވެގެން ދާށޭ، އަޅުގަނޑު މިއަދު މިހުރީ މިކަމަށް",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "އަހަރެން ދުޢާކުރަމެވެ",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "އެހެނީ ހުރިހާ ލަވައެއްގައިވެސް ނިމުމެއް އޮންނަނީއެވެ",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "އާޚިރުގައި އެއް",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ލަވަކިޔަމުން]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "އަޅުގަނޑުމެން [މިއުޒިކް] މިތިބީ މައިލްސްޓޯންސްގެ ހަނދާނުގައި،",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން އިށީނދެގެން ތިބީ ހަނދާން ނެތިފައެވެ",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ބަލިވާ ވަގުތު އަގުވަޒަން ކުރަން ދަސްކުރަން،",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "މީހެއްގެ މިއުޒިކް ދޮރު ފަހަތުން ނުކުމެގެން ދާއިރު",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "އަލި",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ފުރަން އުޅޭ ރޭލުތަކުގެ ފަހަތުން ރާޅު އަޅަނީ، މަސައްކަތް ކުރަމުންނެވެ",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ޖަވާބަކަށް މާޒީ އާދޭސް ކުރާށެވެ",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "އަހަރެމެން ލޯބިވާން ދަސްކުރަނީ، [މިއުޒިކް] އެވެ",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "ފިނިވި އިރު، އަތްތިލައަށް އަޅިގަނޑު ހުރި އިރު އަދި",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "ފަޅައިގެން ގޮސްފައިވާ [މިއުޒިކް] ކްރިސްޓަލް. އަހަރެން އެކަން ބަލަހައްޓަންވީ",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ކޮންކަމެއްތޯ، އަޅުގަނޑުމެން މިތާ ތިއްބަވައިގެން، ދާންދެން",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "އުދުހިގެން ދިޔައެވެ",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ނަފްސު ދުރުމިނަށް ވަދެގެން ދިޔައެވެ",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[މިއުޒިކް]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
