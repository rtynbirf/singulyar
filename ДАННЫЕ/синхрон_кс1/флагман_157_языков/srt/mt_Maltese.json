   "text": "[mużika]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Lejla ġdida fil-ħanut tal-kafè",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ċpar oħxon iħoll id-djar. [mużika]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Niġġerra fil-viċinanzi fejn hemm il-memorji",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "isuqni miġnun",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Fejn fir-rebbiegħa sħuna",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ix-xitwa tgħatti r-ruħ",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[mużika]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Fejn il-ħajja tellgħet bħal vleġġa li għaddiet minn dati, passati",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "lilna",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[mużika]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Aħżenna karti, u ninsew għaliex konna",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "aħna ngħixu",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "U dejjem deher, [mużika]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "għad hemm ħoss ta' C aktar 'il quddiem",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[mużika]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Ħin misluf biss",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ma jagħti xejn",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "U f'daqqa waħda [il-mużika] taqa' fuq qalbi",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "silġ kiesaħ",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Nitgħallmu napprezzaw [il-mużika] meta nitilfu",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "meta d-dawl ta’ xi ħadd jintefa wara l-bieb",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Insellmu wara l-ferroviji li jkunu sejrin, nippruvaw",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[mużika]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "itlob tweġiba lill-passat",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Nitgħallmu nħobbu meta jkun il-bard, [mużika]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "meta jkun hemm irmied fil-pali tiegħek, mhux azzar. DWAR",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "kieku biss kont naf minn qabel, [mużika]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kif dan it-trasparenti se jweġġa’ fir-ruħ",
