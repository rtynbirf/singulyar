  },
  {
   "text": "dwejjaq",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ma qalx, [mużika] ma għannaqx, ma kellux ħin",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dan huwa motiv etern",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ħallejt kollox għal aktar tard, qalbi mhix għal ħaddieħor",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "fetaħ. [mużika]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Qed niġġieldu mad-dell",
