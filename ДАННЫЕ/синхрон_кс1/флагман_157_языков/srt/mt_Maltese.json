  },
  {
   "text": "fuq spallejna",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Imma l-hena mhix fid-dija ta’ vetrina tal-ħanut",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[mużika] mhux f'mazz ta' karti tal-flus, iżda f'post kwiet",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "il-verità tal-qraba, fis-sħana tagħhom fost il-maltempati. Imma",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "napprezzaw biss dak li diġà hu [l-mużika]",
