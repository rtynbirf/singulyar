  },
  {
   "text": "waqt li l-polz ikun qed iħabbat",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Ħalli l-ilmenti jgħaddu, jien favur dan illum",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Nitlob",
