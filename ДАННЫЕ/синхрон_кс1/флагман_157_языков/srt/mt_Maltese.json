   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[mużika]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ninħarqu fuq affarijiet żgħar",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "U ma tistax tara kif il-ġlata qed toqgħod",
