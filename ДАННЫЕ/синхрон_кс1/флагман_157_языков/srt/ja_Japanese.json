{
 "канон": "пульс-синхрон/1",
 "songId": "ja_Japanese",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ja_Japanese.srt",
 "юниты": [
  {
   "text": "[音楽]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "コーヒーショップでの新しい夜、",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "濃い霧が家々を溶かしてしまう。 [音楽]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "私は思い出が残る地域をさまよう",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "私をイライラさせる。",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "暖かい春のどこで",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "冬は魂を覆い隠す。",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "人生が矢のように過ぎ去った日付、過ぎ去った",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "私たち。",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "私たちは書類を溜め込み、なぜ",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "私たちは生きている。",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "そしていつもそう思えた、[音楽]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "この先にはまだCの音が残っています。",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "借り物の時間",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "何も与えない。",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "そして突然、音楽が私の心に降り注ぐ",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "冷たい氷。",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "私たちは負けたときに音楽の素晴らしさを知る。",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "誰かの心の灯が、ドアの向こうで消えたとき。",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "私たちは出発する列車に手を振って、",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "過去に答えを懇願する。",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "寒い時に私たちは愛することを学ぶ。[音楽]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "手のひらに鋼鉄ではなく灰が付着している時。について、",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "事前に知っていればよかったのに、[音楽]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "この透明なものが魂にどれほどの痛みをもたらすか",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "悲しみ。",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "彼は何も言わなかったし、音楽も聴かなかったし、抱きしめもしなかったし、時間もなかった。",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "これは永遠の動機である。",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "私はすべてを後にとっておいた。私の心は他人のためのものではない。",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "開いた。 [音楽]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "私たちは影と戦っている、",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "私たちは取るに足らない些細なことで燃え尽きてしまう。",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "霜がどのように降りていくかは見えない",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "私たちの肩にかかっている。",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "しかし、幸福はショーウィンドウのきらびやかさにあるのではなく、",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[音楽] 札束の中ではなく、静かな",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "嵐の中の温かさの中にある、親族の真実。しかし",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "私たちは音楽が既に持っているものだけを評価する",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "返品は不可能。",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "私の長い",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "そして多くの場合、音楽は無意味な道であり、",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "私たちは音楽を失った時に初めてその価値に気づくのです。",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "誰かの心の灯が、ドアの向こうで消えたとき。",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "私たちは去っていく列車に向かって手を振る。",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "過去に答えを懇願しようとしている。",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "私たちは音楽が冷めてから好きになるのです。",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "手のひらに灰があるとき、[音楽]ではなく",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "鋼鉄。について、",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "事前にどんな音が出るか分かっていればよかったのに",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "魂に宿る、この透明な悲しみ。",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "お年寄りに電話して、抱きしめて、",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "脈拍が動いている間。",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "不満は一旦置いておこう、私は今日はこれに賛成だ",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "私は祈ります。",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "すべての歌には終わりがあるから",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "結局、1つ。",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[歌声]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "私たち（音楽）は節目となる出来事の記憶の中に残ります。",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "私たちは忘れ去られた存在としてそこにいる。",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "私たちは負けた時に感謝することを学びます。",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "誰かの音楽がドアの向こうから聞こえてくるとき",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ライト。",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "私たちは出発する列車に手を振って、",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "過去に答えを懇願する。",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "私たちは愛することを学ぶ、[音楽]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "冷えてきたとき、ヤシの木に灰が付着し、",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "壊れた[音楽]クリスタル。私が対処しなければならない",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "私たちがここにいる間に、",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "飛び去った",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "魂は遠くへと消えていく。",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[音楽]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
