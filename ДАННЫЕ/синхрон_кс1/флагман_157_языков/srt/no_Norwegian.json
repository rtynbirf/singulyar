{
 "канон": "пульс-синхрон/1",
 "songId": "no_Norwegian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/no_Norwegian.srt",
 "юниты": [
  {
   "text": "[musikk]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ny kveld på kaffebaren",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Tykk tåke løser opp hus. [musikk]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Jeg vandrer gjennom nabolagene der minnene er",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "gjøre meg gal",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Hvor i den varme våren",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Vinteren dekker sjelen",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Der livet fløy som en pil forbi datoer, forbi",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "oss",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Vi hamstret papirer og glemte hvorfor vi",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vi lever",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Og det virket alltid som, [musikk]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "det er fortsatt en C-lyd foran",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Bare lånt tid",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "gir ingenting",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Og plutselig faller [musikk] på hjertet mitt",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kald is",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Vi lærer å sette pris på [musikk] når vi taper",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "når noens lys slukkes bak døren",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Vi vinker etter de avgående togene og prøver",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "be fortiden om et svar",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Vi lærer å elske når det er kaldt, [musikk]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "når det er aske i håndflatene dine, ikke stål. OM",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "om jeg bare visste det på forhånd, [musikk]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hvordan denne gjennomsiktige vil verke i sjelen",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristhet",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Han sa ikke, [musikk] at han ikke klemte, han hadde ikke tid",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dette er et evigvarende motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Jeg sparte alt til senere, hjertet mitt er ikke for andre",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "åpnet. [musikk]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Vi kjemper mot skyggen",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "vi brenner ut over tomme bagateller",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Og du kan ikke se hvordan frosten legger seg",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "på våre skuldre",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Men lykken ligger ikke i glitteret i et butikkvindu",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musikk] ikke i en bunke med sedler, men i et stille",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "slektningenes sannhet, i deres varme blant stormene. Men",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "vi setter bare pris på det [musikk] allerede er",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "umulig å returnere",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Fortsetter min lange",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "og ofte er [musikk] en meningsløs vei",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "vi lærer å sette pris på når vi mister [musikk]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "når noens lys slukkes bak døren",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Vi vinker etter [musikk] de avgåtte togene",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "prøver å be fortiden om et svar",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Vi lærer å elske [musikk] når den har kjølnet ned",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "når det er aske i håndflatene, [musikk] og ikke",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stål. OM",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Hvis jeg bare visste på forhånd hvordan den ville klynke inn",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "denne gjennomsiktige tristheten i sjelen",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ring de gamle, klem dem",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mens pulsen slår",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "La klagene passere, jeg er for dette i dag",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Jeg ber",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Fordi alle sanger har en slutt",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "til slutt, én",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[sang]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Vi [musikk] forblir i minnet om milepæler",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "vi sitter glemt",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Vi lærer å sette pris på når vi taper",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "når noens musikk går ut bak døren",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lys",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Vi vinker etter de avgående togene og prøver",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "be fortiden om et svar",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Vi lærer å elske, [musikk]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "da det avkjølte seg, da det var aske i håndflatene og",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "knust [musikk] krystall. Jeg burde ta vare på det",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "hva er, mens vi er her, inntil",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "fløy bort",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "sjel i det fjerne",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[musikk]",
   "startMs": 220082,
