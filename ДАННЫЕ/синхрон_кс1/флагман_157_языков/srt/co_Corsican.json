 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/co_Corsican.srt",
 "юниты": [
  {
   "text": "musica",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nova sera à u caffè",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Una spessa nebbia dissolve e case. musica",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Vagu per i quartieri induve sò i ricordi",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "fà mi impazzisce",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Induve in a primavera calda",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "L'inguernu copre l'anima",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Induve a vita hà vulatu cum'è una freccia passate date, passate",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "noi",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Avemu accumulatu carte, scurdenduci perchè avemu",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "campemu",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "È sempre paria, [musica]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Ci hè sempre un sonu C più avanti",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Solu tempu prestatu",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ùn dà nunda",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "È di colpu [a musica] mi casca nantu à u core",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ghjacciu fretu",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Amparamu à apprezzà [a musica] quandu perdemu",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "quandu a luce di qualchissia si spegne daretu à a porta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Facemu signe dopu à i treni chì partenu, pruvendu",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "implorà una risposta à u passatu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Amparamu à amà quandu face fretu, [musica]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "quandu ci hè cendra in e palme, micca acciaio. À PROPOSITU",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "s'e sapessi solu in anticipu, [musica]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "cum'è questu trasparente ferà male in l'anima",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristezza",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ùn hà micca dettu, [musica] ùn hà micca abbracciatu, ùn avia micca tempu",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Questu hè un mutivu eternu",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Aghju salvatu tuttu per dopu, u mo core ùn hè micca per l'altri",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "apertu. musica",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Luttemu cù l'ombra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Ci brusgiamu per insignificanze viote",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "È ùn pudete micca vede cumu a brina si stalla",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "nantu à e nostre spalle",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ma a felicità ùn hè micca in u scintilliu di una vetrina",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "musica micca in un fasciu di biglietti, ma in un silenziu",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "a verità di i parenti, in u so calore trà e timpeste. Ma",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "apprezzemu solu ciò chì [a musica] hè digià",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "impussibile di vultà",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Continuendu u mo longu",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "è spessu [a musica] hè una via senza significatu",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Amparamu à apprezzà quandu perdemu [a musica]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "quandu a luce di qualchissia si spegne daretu à a porta",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Facemu signe dopu à [musica] i treni partiti",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "pruvendu à implorà u passatu per una risposta",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Amparamu à amà [a musica] quandu s'hè rinfriscata",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "quandu ci hè cennere in e palme, [musica] è micca",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acciaio. À PROPOSITU",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Sì solu sapessi in anticipu cumu si lagnerebbe",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "sta tristezza trasparente in l'anima",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Chjamate i vechji, abbracciateli",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mentre u pulsu batte",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lasciate passà i lamenti, sò per questu oghje",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Pregu",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Perchè tutte e canzone anu una fine",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "à a fine, unu",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "cantendu",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Noi [a musica] restemu in a memoria di e tappe impurtanti",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "stemu dimenticati",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Amparamu à apprezzà quandu perdemu",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "quandu a musica di qualchissia esce daretu à a porta",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "luce",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Facemu signe dopu à i treni chì partenu, pruvendu",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "implorà una risposta à u passatu",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Amparamu à amà, [musica]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "quandu s'hè rinfriscatu, quandu ci era cennere in e palme è",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristallu [musicale] rottu. Devu piglià cura di questu",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ciò chì hè, mentre simu quì, finu à",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "hè vulatu via",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "l'anima in a distanza",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "musica",
   "startMs": 220082,
