 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/es_Spanish.srt",
 "юниты": [
  {
   "text": "[música]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nueva noche en la cafetería",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "La espesa niebla disuelve las casas. [música]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Deambulo por los barrios donde los recuerdos son",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Me vuelven loco",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "¿Dónde en la cálida primavera?",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "El invierno cubre el alma",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Donde la vida voló como una flecha, fechas pasadas, pasado",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "a nosotros",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Acumulamos papeles, olvidando por qué",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "nosotros vivimos",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Y siempre parecía, [música]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Todavía hay un sonido C más adelante",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Solo tiempo prestado",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "no da nada",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Y de repente [la música] cae sobre mi corazón",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "hielo frío",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Aprendemos a apreciar [la música] cuando perdemos",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "cuando se apaga la luz de alguien detrás de la puerta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Saludamos con la mano a los trenes que parten, intentando",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "Suplicarle al pasado que dé una respuesta",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Aprendemos a amar cuando hace frío, [música]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "Cuando tienes ceniza en las palmas de las manos, no acero. ACERCA DE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Si tan solo lo hubiera sabido de antemano, [música]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "cómo este ser transparente dolerá en el alma",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristeza",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "No dijo, [música] no abrazó, no tuvo tiempo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Este es un motivo eterno",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Lo guardé todo para después, mi corazón no es para los demás",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "abierto. [música]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Estamos luchando contra la sombra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Nos agotamos por nimiedades vacías",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Y no puedes ver cómo se está asentando la escarcha",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sobre nuestros hombros",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Pero la felicidad no está en el brillo de un escaparate",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[música] no en un fajo de billetes, sino en un silencio",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "La verdad de los parientes, en su calidez en medio de las tormentas. Pero",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Solo apreciamos lo que [la música] ya existe",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "Imposible regresar",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Continuando con mi largo",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "y a menudo [la música] es un camino sin sentido",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "aprendemos a apreciar cuando perdemos [la música]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "cuando se apaga la luz de alguien detrás de la puerta",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Saludamos con la mano a los trenes que se han ido [música]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "Intentando suplicarle al pasado que dé una respuesta",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Aprendemos a amar [la música] cuando se ha enfriado",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "cuando hay cenizas en las palmas, [música] y no",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acero. ACERCA DE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Si tan solo supiera de antemano cómo se quejaría",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "esta tristeza transparente en el alma",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Llama a los ancianos, abrázalos",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mientras el pulso sigue latiendo",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Dejemos atrás los resentimientos, hoy estoy a favor de esto",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Rezo",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Porque todas las canciones tienen un final",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "al final, uno",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[cantando]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Nosotros [la música] permanecemos en la memoria de los hitos",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "Nos sentamos olvidados",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Aprendemos a apreciar cuando perdemos",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "cuando la música de alguien se va detrás de la puerta",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "luz",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Saludamos con la mano a los trenes que parten, intentando",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "Suplicarle al pasado que dé una respuesta",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Aprendemos a amar, [música]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "cuando se enfrió, cuando había cenizas en las palmas y",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristal [música] roto. Debería encargarme de ello",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "lo que es, mientras estamos aquí, hasta",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "Se fue volando",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "alma en la distancia",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
