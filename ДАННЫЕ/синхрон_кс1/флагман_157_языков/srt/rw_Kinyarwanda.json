 "юниты": [
  {
   "text": "[umuziki]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Umugoroba mushya muri cafe",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Igihu kinini gishongesha amazu. [umuziki]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Nzenguruka mu duce aho ibintu byibukwa",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "untere umusazi",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Aho mu mpeshyi ishyushye",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ubukonje butwikiriye roho",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Aho ubuzima bwagurutse nk'umwambi, hashize iminsi",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "twe",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Twabitse impapuro, twibagirwa impamvu twabitse",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "tubaho",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Kandi byasaga nkaho buri gihe, [umuziki]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Haracyari ijwi rya C imbere",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Igihe cyo gufata gusa",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ntacyo atanga",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Maze mu buryo butunguranye [umuziki] ugwa ku mutima wanjye",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "urubura rukonje",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Twiga kwishimira [umuziki] iyo dutsinzwe",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "iyo urumuri rw'umuntu ruzimye inyuma y'urugi",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Turasuhuza amaboko nyuma ya gari ya moshi zigenda, tugerageza",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "Saba igisubizo ku byahise",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Twiga gukunda iyo hakonje, [umuziki]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "iyo hari ivu mu biganza byawe, ntabwo ari icyuma. IBYEREKEYE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Iyo nza kuba mbizi mbere y'igihe, [umuziki]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "uburyo iyi igaragara izababara mu mutima",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "agahinda",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ntiyavuze ngo, [umuziki] ntiyamuhoberaga, nta mwanya yari afite",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Iyi ni impamvu ihoraho",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Nabitse byose kugira ngo nzabikoreshe nyuma, umutima wanjye ntabwo ushyigikiye abandi",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "yafunguwe. [umuziki]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Turi kurwana n'igicucu",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "turashya kubera utuntu duto dudafite umumaro",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Kandi ntushobora kubona uko imbeho irimo gutuza",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ku bitugu byacu",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ariko ibyishimo ntibiri mu idirishya ry'iduka",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[umuziki] ntabwo uri mu gikombe cy'amanota, ahubwo uri mu ituze",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ukuri kw'abavandimwe, mu bushyuhe bwabo hagati y'inkubi z'umuyaga. Ariko",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "twishimira gusa icyo [umuziki] usanzwe uri cyo",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "bidashoboka kugaruka",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Gukomeza igihe cyanjye kirekire",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "kandi akenshi [umuziki] ni inzira idafite icyo ivuze",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "twiga kwishimira iyo dutakaje [umuziki]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "iyo urumuri rw'umuntu ruzimye inyuma y'urugi",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Nyuma y'umuziki, turasuhuza gari ya moshi zagiye",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "kugerageza gusaba igisubizo ku byahise",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Twiga gukunda [umuziki] iyo umaze gukonja",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "iyo hari ivu mu biganza, [umuziki] atari",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "icyuma. IBYEREKEYE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Iyo nza kumenya mbere y'igihe uburyo bizarira",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "aka gahinda kagaragara mu mutima",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Hamagara abasaza, ubahobere",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mu gihe umutima urimo utera",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Reka ibibazo bishire, uyu munsi ndabishyigikiye",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ndasenga",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kuko indirimbo zose zifite iherezo",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "amaherezo, kimwe",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kuririmba]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Twe [umuziki] turacyari mu kwibuka ibintu by'ingenzi",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "twicaye twibagiwe",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Twiga kwishimira iyo dutsinzwe",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "iyo umuziki w'umuntu usohotse inyuma y'umuryango",
