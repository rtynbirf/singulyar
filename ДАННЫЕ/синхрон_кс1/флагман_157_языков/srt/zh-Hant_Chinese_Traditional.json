{
 "канон": "пульс-синхрон/1",
 "songId": "Traditional",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/zh-Hant_Chinese_Traditional.srt",
 "юниты": [
  {
   "text": "[音樂]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "在咖啡館度過一個全新的夜晚，",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "濃霧籠罩著房屋。 [音樂]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "我漫步在那些充滿回憶的街區。",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "快把我逼瘋了。",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "在溫暖的春天裡",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "寒冬籠罩靈魂。",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "生命如箭般飛逝，逝去的歲月，逝去的時光",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "我們。",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "我們囤積文件，忘記了為什麼我們",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "我們活著。",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "而且似乎總是，[音樂]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "前面還有一個C音。",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "只是藉來的時間",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "什麼也不給。",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "突然間，音樂落入我的心底。",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "冰冷的冰塊。",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "我們只有在失敗中才會學會欣賞音樂。",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "當有人身後的燈熄滅了。",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "我們向駛離的列車揮手道別，努力",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "向過去尋求答案。",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "我們在寒冷中學會了愛，[音樂]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "你的掌心是灰燼，不是鋼鐵。關於，",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "如果我事先知道就好了，[音樂]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "這透明的靈魂將如何痛徹心扉",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "悲傷。",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "他沒說，（音樂）他沒擁抱，他沒時間。",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "這是一個永恆的動機。",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "我把一切都留到以後再說，我的心只屬於我自己。",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "已開啟。 [音樂]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "我們正在與陰影作鬥爭，",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "我們為一些無關緊要的小事而精疲力竭。",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "你根本看不到霜是如何凝結的。",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "扛在我們肩上。",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "但幸福並不在於商店櫥窗的華麗裝飾，",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "音樂不是藏在一疊鈔票裡，而是藏在一片靜謐之中。",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "親人之間的真情實感，在暴風雨中，在他們溫暖的懷抱裡。但",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "我們只欣賞音樂本身已經具備的特質。",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "無法退貨。",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "繼續我的長篇報道",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "而音樂往往是一條毫無意義的道路，",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "當我們失去音樂時，我們才學會珍惜。",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "當有人身後的燈熄滅了。",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "我們揮手告別駛離的列車（音樂聲），",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "試圖向過去尋求答案。",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "我們學會欣賞那些已經冷卻的音樂。",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "當手掌中滿是灰燼時，[音樂]而不是",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "鋼。關於，",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "如果我事先知道它會如何嗚咽就好了",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "靈魂深處那份透明的悲傷。",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "給老人家打電話，擁抱他們，",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "當脈搏跳動時。",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "讓那些不滿過去吧，我今天支持這件事。",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "我祈禱。",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "因為所有歌曲都有結尾。",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "最終，只有一個。",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[歌唱]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "我們（音樂）將留在人們的記憶中，成為里程碑事件的一部分。",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "我們被遺忘了。",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "我們從失敗中學習珍惜。",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "當有人把音樂從門後傳出去的時候",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "光。",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "我們向駛離的列車揮手道別，努力",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "向過去尋求答案。",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "我們學會了熱愛音樂。",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "當天氣轉涼，手掌上沾滿了灰燼時，",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "破碎的[音樂]水晶。我應該處理這件事。",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "在我們身處此地之時，直到",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "飛走了",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "靈魂飄向遠方。",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[音樂]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
