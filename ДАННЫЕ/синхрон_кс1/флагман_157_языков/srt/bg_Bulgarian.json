{
 "канон": "пульс-синхрон/1",
 "songId": "bg_Bulgarian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/bg_Bulgarian.srt",
 "юниты": [
  {
   "text": "[музика]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Нова вечер в кафенето",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Гъста мъгла разтваря къщите. [музика]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Скитам се из кварталите, където са спомените",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "подлудява ме",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Където през топлата пролет",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Зимата покрива душата",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Където животът летеше като стрела покрай дати, покрай миналото",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "нас",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Трупахме документи, забравяйки защо",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ние живеем",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "И винаги изглеждаше, [музика]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "все още има звук „C“ напред",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Просто време назаем",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "не дава нищо",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "И изведнъж [музика] пада върху сърцето ми",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "студен лед",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Научаваме се да ценим [музиката], когато губим",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "когато нечия светлина угасне зад вратата",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Махаме след заминаващите влакове, опитвайки се",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "молете миналото за отговор",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Учим се да обичаме, когато е студено, [музика]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "когато в дланите ти има пепел, а не стомана. ЗА",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "само ако знаех предварително, [музика]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "как ще боли душата този прозрачен",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "тъга",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Той не каза, [музика] не прегърна, нямаше време",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Това е вечен мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Запазих всичко за по-късно, сърцето ми не е за други",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "отворено. [музика]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Борим се със сянката",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Изгаряме за празни дреболии",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "И не можеш да видиш как сланата се утаява",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "на нашите рамене",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Но щастието не е в блясъка на витрината",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[музика] не в пачка банкноти, а в тиха",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "истината на роднините, в топлината им сред бурите. Но",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ние ценим само това, което [музиката] вече е",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "невъзможно за връщане",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Продължавайки дългото си",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "и често [музиката] е безсмислен път",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Научаваме се да ценим, когато губим [музика]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "когато нечия светлина угасне зад вратата",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Махаме след [музика] на заминалите влакове",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "опитвайки се да умолява миналото за отговор",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Научаваме се да обичаме [музиката], когато е изстинала",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "когато има пепел в дланите, [музика] и не",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "стомана. ЗА",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Само да знаех предварително как ще вие",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "тази прозрачна тъга в душата",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Обадете се на старите хора, прегърнете ги",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "докато пулсът бие",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Нека оплакванията отминат, аз съм за това днес",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Моля се",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Защото всички песни имат край",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "накрая, едно",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[пеене]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ние [музиката] оставаме в паметта на важните събития",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "седим забравени",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Учим се да ценим, когато губим",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "когато нечия музика изчезне зад вратата",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "светлина",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Махаме след заминаващите влакове, опитвайки се",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "молете миналото за отговор",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Учим се да обичаме, [музика]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "когато се охлади, когато имаше пепел в дланите и",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "счупен [музикален] кристал. Трябва да се погрижа за това",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "какво е, докато сме тук, докато",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "отлетя",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "душа в далечината",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
