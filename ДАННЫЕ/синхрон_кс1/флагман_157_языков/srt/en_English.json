  {
   "text": "this transparent sadness would ache in my soul",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Call the old folks, hug them",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "while the pulse beats",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Let the grievances pass, I pray for this today",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Because all the songs have the",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "same ending",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
