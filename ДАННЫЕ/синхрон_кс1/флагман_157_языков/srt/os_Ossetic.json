{
 "канон": "пульс-синхрон/1",
 "songId": "os_Ossetic",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/os_Ossetic.srt",
 "юниты": [
  {
   "text": "[музыкæ]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ног изæр къафетты",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Бæзджын мит хæдзæрттæ ныппырх кæны. [музыкæ]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Æз рацу-бацу кæнын сыхбæсты, цыран сты мысинæгтæ",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "æдылы мæ кæн",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Кæм хъарм уалдзæджы",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Зымæг уд æмбæрзы",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Цард æрдынау кæм атахт датæты сæрты, ивгъуыд",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "мах",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Мах æмбырд кодтам гæххæттытæ, ферох кодтам, цæмæн",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "цæрæм",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Æмæ æдзухдæр афтæ каст, [музыкæ]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "разæй ма ис хъæлæс С",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Æрмæст æфстау райстон рæстæг",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ницы дæтты",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Æмæ æвиппайды [музыкæ] мæ зæрдæйыл æрхауы",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "уазал их",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Мах ахуыр кæнæм аргъ кæнын [музыкæйæн], куы фесæфæм, уæд",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "дуары фæстæ искæй рухс куы ахуыссы, уæд",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Мах æрбакæнæм ацæуæг поездты фæдыл, архайгæйæ",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ивгъуыдæй дзуапп курын",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Уарзын ахуыр кæнæм, уазал куы вæййы, уæд",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "дæ къухты æфсæйнаг куы уа, уæд. ТЫХХÆЙ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "рагацау куы зыдтаин",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "куыд риссдзæн ацы æргом уды",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "хъыг",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Нæ загъта, [музыкæ] нæ хъæбыстæ кодта, рæстæг ын нæ уыд",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Уый у æнусон мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Алцыдæр фæстæдæрмæ бахъахъхъæдтон, мæ зæрдæ иннæтæм нæу",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "байгом. [музыкæ]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Аууонимæ тох кæнæм",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "мах басудзæм дзæгъæл лыстæг хъуыддæгтыл",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Æмæ уазал куыд æрбынат кæны, уый нæ уыныс",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "нæ уæхсчытыл",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Фæлæ амонд дуканийы рудзынджы æрттивгæ нæу",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[музыкæ] нæ, фæлæ æнцад",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "хæстæджыты æцæгдзинад, сæ хъармдзинады дымгæты æхсæн. Фæлæ",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "мах аргъ кæнæм æрмæстдæр, [музыкæ] ныридæгæн цы у, уымæн",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "æрыздæхын нæй гæнæн",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Дарддæр кæнын мæ даргъ",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "æмæ арæх [музыкæ] вæййы æнæнысаниуæгджын фæндаг",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "мах ахуыр кæнæм аргъ кæнын, [музыкæ] куы фесафæм, уæд",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "дуары фæстæ искæй рухс куы ахуыссы, уæд",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Мах æрбакæнæм [музыкæйы] ацæуæг поездты фæстæ",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ивгъуыдæй дзуапп курынмæ хъавы",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "[Музыкæ] уарзын ахуыр кæнæм, куы ныууазал вæййы, уæд",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "къухты æфсæйнæгтæ куы вæййы, уæд [музыкæ] æмæ нæ",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "æндон. ТЫХХÆЙ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Рагацау куы зыдтаин, куыд хъынцъым кæндзæн",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "уыцы æргом хъыг уды",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Зæронд адæммæ фæдзур, ныхъхъæбыс сæ кæн",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "цалынмæ пульс ныццæвы, уæдмæ",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Уадз æмæ хъаст ахиза, æз абон дæн уый фарс",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Æз кувын",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Уымæн æмæ алы зарæгæн дæр ис кæрон",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "кæронбæттæны, иу",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[заргæ]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Мах [музыкæ] баззайæм ахсджиаг цауты мысынады",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "бадæм рохуаты",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Куы фесæфæм, уæд аргъ кæнын ахуыр кæнæм",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "дуары фæстæ искæй музыкæ куы ахуыссы",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "рæуæг",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Мах æрбакæнæм ацæуæг поездты фæдыл, архайгæйæ",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ивгъуыдæй дзуапп курын",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ахуыр кæнæм уарзын, [музыкæ]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "куы ныууазал, пальмæты æртæхтæ куы уыд æмæ",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "ныппырхгонд [музыкæйы] кристалл. Æз æм хъуамæ мæ цæст дарон",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "цы у, цалынмæ ам стæм, уæдмæ",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "атахт",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "уд дардмæ",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[музыкæ]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
