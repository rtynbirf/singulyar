 "юниты": [
  {
   "text": "[সঙ্গীত]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "কফি শপে নতুন সন্ধ্যা",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ঘন কুয়াশা ঘরবাড়ি গলিয়ে দেয়। [সঙ্গীত]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "আমি সেই পাড়াগুলোতে ঘুরে বেড়াই যেখানে স্মৃতিগুলো রয়েছে",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "আমাকে পাগল করে দেয়।",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "উষ্ণ বসন্তে কোথায়",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "শীত আত্মাকে আবৃত করে।",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[সঙ্গীত]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "যেখানে জীবন তীরের মতো ছুটে যেত তারিখ পেরিয়ে, অতীত।",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "আমাদেরকে।",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[সঙ্গীত]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "আমরা কাগজপত্র জমা করেছিলাম, ভুলে গিয়েছিলাম কেন আমরা",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "আমরা বেঁচে থাকি।",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "আর সবসময়ই মনে হতো, [সঙ্গীত]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "সামনে এখনও একটি 'C' ধ্বনি রয়েছে।",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[সঙ্গীত]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "শুধু ধার করা সময়",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "কিছুই দেয় না।",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "আর হঠাৎ [সঙ্গীত] আমার হৃদয়ে এসে পড়ে।",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
