  },
  {
   "text": "uagut qanoq",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Kisianni nuannaarneq pisiniarfiup igalaani qinngornermiinngilaq",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musik] bill-inik wad-imiunngitsoq, kisiannili quiet-imi",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ilaqutariit piviusunngornerat, silap pissusaata akornanni qiimmassarnerminni. Kisianni",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
