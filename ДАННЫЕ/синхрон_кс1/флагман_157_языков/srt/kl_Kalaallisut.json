  },
  {
   "text": "pulsi pissangatillugu",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Naammagittaalliuutit qaangiutissapput, uanga ullumikkut tamanna tapersersorpara",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Qinnuteqarpunga",
