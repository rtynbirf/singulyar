 "юниты": [
  {
   "text": "[nipilersuut]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Unnuk nutaaq kaffisortarfimmi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Pujoq qaqutigoortoq illut aserortarpai. [nipilersuut]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Eqqaamasat najugaqarfigisaanni najugaqarfiit aqqusaartarpakka",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ajoquserpaanga",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ukiakkut kiassutsimi sumi",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ukioq uummammik qalipaavoq",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Tassani inuuneq qarsutsinertut timmisartuussivoq ullut qaangiuttut, qaangiuttut",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "uagut",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Pappialanik katersuisarpugut, sooq puigorlugu",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "inuuvugut",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Aammalu isumaqartarsimavoq, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "suli C-mik nipilersortoqarpoq siumut",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Piffissaq låneqarsimasoq",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "sumik tunniussisarnani",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Aammalu tassanngaannaq [musik] uummammut nakkarpoq",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "siku nilleq",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "[Nipilersorneq] qujamasuutiginiarlugu ilinniartarpugut annaasaqartarnitsinni",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "inuup qinngornera illup tunuani qaminneqarpat",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Togtit aallarunneqartussat kingorna allaffigaarput, misiliilluta",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "qinnuigiuk siornatigut akissuteqarnissaq",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Nillertoqartillugu asanninneq ilinniartarparput, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "palmiini askertoqarpat, stål-iunngitsoq. TUNNGASSUTEQARPOQ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "siusinnerusukkut ilisimagaluarlugu, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "qanoq ersarissumik una uummatimi anniarsinnaanersoq",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "aliasunneq",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Oqanngilaq, [musik] taanna hug’inngilaq, taanna piffissaqarfiginngilaa",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Tamanna naassaanngitsumik motiviuvoq",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Suna tamaat kingusinnerusukkut annaasimavara, uummammi allanut tunngassuteqanngilaq",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ammarneqarpoq. [nipilersuut]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Tarnikkut sorsuuteqarpugut",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "uagut triflit imaqanngitsut pillugit ikuallattarpugut",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Aammalu qanoq qillertoq takusinnaanngilat",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[nipilersuut]",
   "startMs": 113316,
   "endMs": 116960,
