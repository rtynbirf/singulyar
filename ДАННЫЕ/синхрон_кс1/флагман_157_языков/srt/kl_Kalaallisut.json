  {
   "text": "sisak. TUNNGASSUTEQARPOQ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Siusinnerusukkut ilisimagaluarpara qanoq qisuariaateqassanersoq",
