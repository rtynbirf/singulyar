{
 "канон": "пульс-синхрон/1",
 "songId": "mk_Macedonian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/mk_Macedonian.srt",
 "юниты": [
  {
   "text": "[музика]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Нова вечер во кафетеријата",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Густата магла ги раствора куќите. [музика]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Талкам низ населбите каде што се спомените",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ме излудува",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Каде во топлата пролет",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Зимата ја покрива душата",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Каде што животот леташе како стрела низ датуми, минато",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "нас",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Собиравме документи, заборавајќи зошто",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ние живееме",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "И секогаш изгледаше, [музика]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "сè уште се слуша звук на буквата Ц напред",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Само позајмено време",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "не дава ништо",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "И одеднаш [музиката] ми паѓа на срцето",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ладен мраз",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Учиме да ја цениме [музиката] кога губиме",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "кога нечие светло ќе се изгасне зад вратата",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Мавтаме по возовите што заминуваат, обидувајќи се",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "моли го минатото за одговор",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Учиме да сакаме кога е ладно, [музика]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "кога има пепел во дланките, а не челик. ЗА",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "само да знаев однапред, [музика]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "како ова проѕирно ќе боли во душата",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "тага",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Тој не рече, [музика] не прегрна, немаше време",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ова е вечен мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Сè зачував за подоцна, моето срце не е за другите",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "отворено. [музика]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Се бориме со сенката",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "се прегоруваме над празни ситници",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "И не можеш да видиш како се смирува мразот",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "на нашите рамена",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Но среќата не е во сјајот на излогот",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[музика] не во куп банкноти, туку во тивок",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "вистината на роднините, во нивната топлина меѓу бурите. Но",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ние цениме само она што [музиката] е веќе",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "невозможно да се врати",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Продолжувам со моето долго",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "и честопати [музиката] е бесмислен пат",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "учиме да цениме кога губиме [музика]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "кога нечие светло ќе се изгасне зад вратата",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Ги мавтаме по [музиката] заминатите возови",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "обидувајќи се да го молам минатото за одговор",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Учиме да ја сакаме [музиката] кога ќе се олади",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "кога има пепел во дланките, [музика] и не",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "челик. ЗА",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Само да знаев однапред како ќе завива внатре",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "оваа проѕирна тага во душата",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Јавете им се на старите луѓе, прегрнете ги",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "додека пулсот чука",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Нека поминат поплаките, јас сум за ова денес",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Се молам",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Затоа што сите песни имаат крај",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "на крајот, еден",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[пеење]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ние [музиката] остануваме во сеќавањето на пресвртниците",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "седиме заборавени",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Учиме да цениме кога губиме",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "кога нечија музика излегува зад вратата",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "светлина",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Мавтаме по возовите што заминуваат, обидувајќи се",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "моли го минатото за одговор",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Учиме да сакаме, [музика]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "кога се олади, кога имаше пепел во дланките и",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "скршен [музички] кристал. Треба да се погрижам за тоа",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "што е, додека сме тука, сè додека",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "одлета",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "душата во далечината",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
