 "юниты": [
  {
   "text": "[musik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Sore anyar ing warung kopi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Kabut kandel ngilangake omah-omah. [musik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Aku mlaku-mlaku ing lingkungan sekitar sing kebak kenangan",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "nggawe aku edan",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ing endi ing musim semi sing anget",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Mangsa adhem nutupi jiwa",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ing ngendi urip mabur kaya panah ngliwati tanggal, kepungkur",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "kita",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Kita numpuk kertas, lali kenapa kita",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "kita urip",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Lan mesthi katon, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "isih ana swara C ing ngarep",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Mung nyilih wektu",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ora menehi apa-apa",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Lan dumadakan [musik] tiba ing atiku",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "es adhem",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Kita sinau ngapresiasi [musik] nalika kita kelangan",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "nalika lampune wong mati ing mburi lawang",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Kita nglambai sawise sepur sing budhal, nyoba",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "njaluk wangsulan saka masa lalu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Kita sinau tresna nalika hawane adhem, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "nalika ana awu ing telapak tanganmu, dudu waja. BABAGAN",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "saupama aku ngerti luwih dhisik, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kepiye sing transparan iki bakal lara ing jiwa",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sedhih",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Dhèwèké ora kandha, [musik] dhèwèké ora ngrangkul, dhèwèké ora duwé wektu",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Iki minangka motif langgeng",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Aku nyimpen kabeh kanggo mengko, atiku ora kanggo wong liya",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "dibukak. [musik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Kita lagi perang karo bayangan",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "kita kesel banget mung amarga barang-barang sepele sing ora ana gunane",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Lan sampeyan ora bisa ndeleng kepiye embun beku kasebut mandheg",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ing pundhak kita",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Nanging rasa seneng ora ana ing kilauan etalase toko",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musik] ora ing gumpalan dhuwit kertas, nanging ing sepi",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "bebeneré sedulur-seduluré, ing sajroning anget-angeté ing antarane badai. Nanging",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "kita mung ngapresiasi apa sing wis ana [musik]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ora mungkin bali",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Terusake dawaku",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "lan asring [musik] minangka dalan sing ora ana artine",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "kita sinau ngapresiasi nalika kelangan [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "nalika lampune wong mati ing mburi lawang",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Kita nglambaikake tangan sawise [musik] sepur sing wis mangkat",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "nyoba njaluk wangsulan saka masa lalu",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Kita sinau tresna marang [musik] nalika wis adhem",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "nalika ana awu ing telapak tangan, [musik] lan ora",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "baja. BABAGAN",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Saupama aku ngerti luwih dhisik kepiye bakal sambat ing",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "rasa sedhih sing cetha iki ana ing njero ati",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ngundang wong tuwa, ngrangkul dheweke",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "nalika denyut nadi lagi deg-degan",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Ayo keluhan iki liwati, aku setuju dina iki",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Aku ndedonga",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Amarga kabeh lagu nduweni pungkasan",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "pungkasane, siji",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[nyanyi]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Kita [musik] tetep ana ing memori tonggak sejarah",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "kita lungguh dilalekake",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Kita sinau ngormati nalika kita kalah",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "nalika musik wong metu saka mburi lawang",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "cahya",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Kita nglambai sawise sepur sing budhal, nyoba",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "njaluk wangsulan saka masa lalu",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Kita sinau tresna, [musik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "nalika wis adhem, nalika ana awu ing wit palem lan",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [musik] sing rusak. Aku kudune ngurus iku",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "apa sing kedadeyan, nalika kita ana ing kene, nganti",
