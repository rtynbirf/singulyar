{
 "канон": "пульс-синхрон/1",
 "songId": "mn_Mongolian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/mn_Mongolian.srt",
 "юниты": [
  {
   "text": "[хөгжим]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Кофены дэлгүүрт шинэ үдэш",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Зузаан манан байшингуудыг нураадаг. [хөгжим]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Би дурсамжууд байдаг хорооллуудаар тэнүүчилдэг",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "намайг галзууруулах",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Халуун хавар хаана байна",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Өвөл сэтгэлийг бүрхдэг",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Амьдрал өнгөрсөн өдрүүд, өнгөрсөн өдрүүдийн сум шиг нисэн одсон газар",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "биднийг",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Бид яагаад гэдгийг нь мартчихсан, цааснуудаа хураачихсан байсан",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "бид амьдардаг",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Тэгээд үргэлж л [хөгжим] мэт санагддаг байсан",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "урд нь С авиа байсаар л байна",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Зүгээр л цаг зээлсэн",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "юу ч өгдөггүй",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Тэгээд гэнэт [хөгжим] миний зүрх сэтгэлд унав",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "хүйтэн мөс",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Бид ялагдах үедээ [хөгжмийг] үнэлж сурдаг",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "хэн нэгний гэрэл хаалганы цаана унтарч байхад",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Бид хөдлөх галт тэрэгнүүдийн араас даллаж, оролдож байна",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "өнгөрсөн үеэс хариулт гуй",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Бид хүйтэн үед хайрлаж сурдаг, [хөгжим]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "алган дээр чинь ган биш, үнс байхад. ТУХАЙ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Хэрэв би урьдчилан мэдэж байсан бол, [хөгжим]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "энэ тунгалаг хүн сэтгэлд хэрхэн өвдөх вэ",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "гуниг",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Тэр [хөгжим] тэврээгүй, цаг завгүй гэж хэлээгүй",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Энэ бол мөнхийн сэдэл юм",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Би бүх зүйлээ дараа нь зориулж хадгалсан, миний зүрх сэтгэл бусдын төлөө биш",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "нээгдсэн. [хөгжим]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Бид сүүдэртэй тэмцэж байна",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Бид хоосон зүйлсээс болж шатаж дуусдаг",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Хүйтэн хэрхэн тогтож байгааг та харж чадахгүй",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "бидний мөрөн дээр",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Гэхдээ аз жаргал дэлгүүрийн цонхны гялтганасан гэрэлд байдаггүй",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[хөгжим] дэвсгэртүүдийн багц дотор биш, харин чимээгүй орчинд",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "шуурганы дундах дулаан сэтгэлдээ хайртай хамаатан садныхаа үнэн. Гэхдээ",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "бид зөвхөн [хөгжим] аль хэдийн байгааг л үнэлдэг",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "буцах боломжгүй",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Миний урт удаан үргэлжилсээр байна",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "мөн [хөгжим] нь ихэвчлэн утгагүй зам байдаг",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "бид [хөгжмөө] алдсан үедээ талархаж сурдаг",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "хэн нэгний гэрэл хаалганы цаана унтарч байхад",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Бид хөдөлсөн галт тэрэгнүүдийн дараа [хөгжим] даллаж",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "өнгөрсөн үеэс хариулт гуйхыг хичээж байна",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Бид [хөгжим] хөрсний дараа хайрлаж сурдаг",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "алган дээр үнс байх үед [хөгжим] биш",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ган. ТУХАЙ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Хэрэв би үүнийг хэрхэн гонгинохыг урьдчилан мэдэж байсан бол",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "сэтгэл дэх энэ тунгалаг гуниг",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Хөгшин хүмүүсийг дуудаж, тэврээрэй",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "судасны цохилт цохилж байх үед",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Гомдлыг өнгөрүүлээрэй, би өнөөдөр үүний төлөө байна",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Би залбирч байна",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Учир нь бүх дуу төгсгөлтэй байдаг",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "эцэст нь, нэг",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[дуулж байна]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Бид [хөгжим] түүхэн үйл явдлуудын дурсамжинд үлддэг",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "бид мартагдсан байдалтай сууж байна",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Бид алдах үедээ талархаж сурдаг",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "хэн нэгний хөгжим хаалганы цаана сонсогдох үед",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "гэрэл",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Бид хөдлөх галт тэрэгнүүдийн араас даллаж, оролдож байна",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "өнгөрсөн үеэс хариулт гуй",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Бид хайрлаж сурдаг, [хөгжим]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "хөрж, алган дээр үнс байх үед болон",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "эвдэрсэн [хөгжим] болор. Би үүнийг хариуцах ёстой",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "бид энд байх хооронд, хүртэл юу байна",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "нисээд одлоо",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "сүнс алсын зайд",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[хөгжим]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
