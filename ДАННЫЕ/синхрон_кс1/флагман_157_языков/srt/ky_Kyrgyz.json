{
 "канон": "пульс-синхрон/1",
 "songId": "ky_Kyrgyz",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ky_Kyrgyz.srt",
 "юниты": [
  {
   "text": "Кофеканадагы жаңы кеч",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Коюу туман үйлөрдү эритип жиберет",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Мен эскерүүлөр жаткан райондорду кыдырып жүрөм",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "мени жинди кылат",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Жылуу жазда кайда",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Кыш жан дүйнөнү каптайт",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "Өмүр жебедей учкан даталардан, өткөн күндөрдөн",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "бизди",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "Эмне үчүн экенин унутуп, кагаздарды чогултуп койдук",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "биз жашайбыз",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Жана ал ар дайым сезилчү",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "алдыда дагы эле С тыбышы бар",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Жөн гана карызга алынган убакыт",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "эч нерсе бербейт",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Анан күтүлбөгөн жерден жүрөгүмө түшөт",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "муздак муз",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Биз утулуп калганда [музыканы] баалоону үйрөнөбүз",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "эшиктин артында бирөөнүн жарыгы өчүп калганда",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Биз жөнөп жаткан поезддердин артынан кол булгалап, аракет кылып жатабыз",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "өткөндөн жооп сурап",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Суук болгондо сүйүүнү үйрөнөбүз",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "алаканыңда болот эмес, күл болгондо. ЖӨНҮНДӨ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Эгер мен алдын ала билгенде гана",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "бул тунук жан дүйнөнү кандай оорутат",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "кайгы",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ал кучакташкан жокмун, убактысы жок деп айткан жок",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Бул түбөлүктүү мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Баарын кийинчерээк сактап койдум, жүрөгүм башкаларга арналбайт",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ачылды",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Биз көлөкө менен күрөшүп жатабыз",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "биз бош нерселерге күйүп кетебиз",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ал эми үшүктүн кантип басылып жатканын көрө албайсың",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "биздин мойнубузда",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Бирок бакыт дүкөндүн терезесинин жаркыроосунда эмес",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "купюралардын үймөгүндө эмес, тынч жерде",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "бороон-чапкындардын арасындагы жылуу мамилесиндеги туугандарынын чындыгы. Бирок",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "биз мурунтан эле бар экенин гана баалайбыз",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "кайтарып алуу мүмкүн эмес",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Узундугумду улантып жатам",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "жана көп учурда маанисиз жол",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "биз [музыканы] жоготкондо баалоону үйрөнөбүз",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "эшиктин артында бирөөнүн жарыгы өчүп калганда",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Биз жөнөп кеткен поезддердин артынан кол булгалайбыз",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "өткөн чактардан жооп сураганга аракет кылат",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Биз [музыканы] ал муздаганда сүйүүнү үйрөнөбүз",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "алакандарда күл болгондо, жана жок",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "болот. ЖӨНҮНДӨ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Анын кантип онтоп жатканын алдын ала билсем кана",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "жан дүйнөмдөгү бул тунук кайгы",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Карыларды чакыр, кучактап ал",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "пульс согуп жатканда",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Таарынычтар өтүп кетсин, мен бүгүн муну колдойм",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Мен тиленем",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "Анткени ар бир ырдын аягы бар",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "акырында, бирөө",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ырдоо]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Биз маанилүү окуялардын эсинде калабыз",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "унутуп отурабыз",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "Жоготкондо баалоону үйрөнөбүз",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "эшиктин артында кимдир бирөөнүн музыкасы жаңырып калганда",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "жарык",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Биз жөнөп жаткан поезддердин артынан кол булгалап, аракет кылып жатабыз",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "өткөндөн жооп сурап",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Биз сүйүүнү үйрөнөбүз",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "муздаганда, алакандарда күл болгондо жана",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "сынган хрусталь. Мен ага кам көрүшүм керек",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "эмне, биз бул жерде турганда, чейин",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "учуп кетти",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "жан алыска",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  }
 ]
}
