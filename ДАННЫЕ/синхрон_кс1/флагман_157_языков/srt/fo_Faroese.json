{
 "канон": "пульс-синхрон/1",
 "songId": "fo_Faroese",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/fo_Faroese.srt",
 "юниты": [
  {
   "text": "[tónleikur]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nýtt kvøld á kaffistovuni",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Tjúkkur mjørki upploysir hús. [tónleikur]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Eg reiki ígjøgnum grannaløgini, har minnini eru",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "koyra meg í ørviti",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Har í heita várið",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Veturin fjalir sálina",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Har lívið fleyg sum ein pílur framvið datum, framvið",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "okkum",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Vit goymdu pappír og gloymdu, hví vit",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vit liva",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Og tað virkaði altíð, [tónleikur]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "enn er eitt C-ljóð frammanfyri",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Bara lænt tíð",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "gevur einki",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Og knappliga fellur [tónleikur] á hjarta mítt",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kaldan ís",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Vit læra at virðismeta [tónleik], tá vit missa",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "tá ljósið hjá onkrum sløknar aftan fyri hurðina",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Vit vinka eftir farandi togunum, royna",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "biðja fortíðina um svar",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Vit læra at elska, tá tað er kalt, [tónleikur]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "tá ið øska er í lómunum, ikki stál. UM",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "um eg bara visti frammanundan, [tónleikur]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hvussu hesin gjøgnumskygdi fer at pína í sálini",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sorg",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hann segði ikki, [tónleik] hann klemmaði ikki, hann tímdi ikki",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Hetta er eitt ævigt motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Eg goymdi alt til seinni, mítt hjarta er ikki fyri øðrum",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "opnað. [tónleikur]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Vit stríðast við skugganum",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "vit brenna út yvir tómar smálutir",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Og tú sært ikki, hvussu frostið setur seg",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "á okkara herðum",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Men eydnan er ikki í glitrinum í einum handilsvindeyga",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[tónleikur] ikki í einum rúgvu av rokningum, men í einum stillum",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "sannleikan hjá ættfólkum, í teirra hita millum ódnirnar. Men",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "vit meta bara um tað, sum [tónleikur] longu er",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ógjørligt at venda aftur",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Haldi fram við mínum langa",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "og ofta er [tónleikur] ein meiningsleys leið",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "vit læra at virðismeta, tá vit missa [tónleik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "tá ljósið hjá onkrum sløknar aftan fyri hurðina",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Vit vinka eftir [tónleiki] teimum farnu togunum",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "royna at biðja fortíðina um svar",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Vit læra at elska [tónleik], tá hann er kølnaður",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "tá ið øska er í lómunum, [tónleikur] og ikki",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "sjala. UM",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Um eg bara visti frammanundan, hvussu tað fór at hvína í",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "hesa gjøgnumskygdu sorg í sálini",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ring til tey gomlu, klemma tey",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "meðan pulsurin slær",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lat kærurnar ganga, eg eri fyri hesum í dag",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Eg biði",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Tí allir sangir hava ein enda",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "at enda, eitt",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[syngja]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Vit [tónleikur] eru eftir í minninum um málsteinar",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "vit sita gloymd",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Vit læra at virðismeta, tá vit missa",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "tá tónleikurin hjá onkrum fer út aftan fyri hurðina",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ljós",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Vit vinka eftir farandi togunum, royna",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "biðja fortíðina um svar",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Vit læra at elska, [tónleikur]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "tá tað kólnaði, tá øska var í lómunum og",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "brotin [tónleika] kristallur. Eg skuldi tikið mær av tí",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "hvat er, meðan vit eru her, til",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "fleyg avstað",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "sál inn í fjarsýnið",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[tónleikur]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
