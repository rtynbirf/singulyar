  },
  {
   "text": "locoyachiway",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Maypitaq q’uñi pukyupi",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Inviernoqa almata tapan",
