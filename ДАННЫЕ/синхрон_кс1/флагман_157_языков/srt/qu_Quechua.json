   "level": "line"
  },
  {
   "text": "[taki]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Maypichus kawsayqa flecha hina phalarqan pasaq fechakunata, pasaq",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
