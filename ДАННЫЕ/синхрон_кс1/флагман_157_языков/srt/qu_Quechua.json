   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[taki]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Papelkunatan huñuq kayku, qonqaspayku imarayku chayta",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "kawsanchik",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Hinaspapas sapa kutinmi rikch’akurqan, [musiku]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ñawpaqninpiqa C t’uqyayraqmi kachkan",
