 "юниты": [
  {
   "text": "[ᓂᔾᔭᐅᑦ]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Thick fog dissolves houses. [ᓂᔾᔭᐅᑦ]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "ᕿᓚᒥᑯᓗᒃ ᕿᓚᒥᑯᓗᒃ ᕿᓚᒥᑯᓗᒃ ᐃᖅᑲᐅᒪᓇᖅᑐᖃᖅᑎᓪᓗᒍ",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ᓯᕘᕋᓕᖅᑎᑉᐸᙵ",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ᓇᓂ ᐅᖅᑰᔪᒥ ᐅᐱᕐᖔᒥ",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "ᐅᑭᐅᖅ ᑕᕐᓂᕐᒥᒃ ᒪᑐᓯᕙᒻᒪᑦ",
