 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/it_Italian.srt",
 "юниты": [
  {
   "text": "[musica]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nuova serata al bar",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Una fitta nebbia fa scomparire le case. [musica]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Vago per i quartieri dove sono i ricordi",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "mi fai impazzire",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Dove nella calda primavera",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "L'inverno avvolge l'anima",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Dove la vita è volata come una freccia oltre le date, oltre",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "noi",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Abbiamo accumulato documenti, dimenticando il motivo per cui",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "viviamo",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "E sembrava sempre, [musica]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "c'è ancora un suono C davanti",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Tempo preso in prestito",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "non dà nulla",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "E all'improvviso [la musica] mi arriva al cuore",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ghiaccio freddo",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Impariamo ad apprezzare [la musica] quando perdiamo",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "quando la luce di qualcuno si spegne dietro la porta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Salutiamo con la mano i treni in partenza, cercando",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "implorare il passato per una risposta",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Impariamo ad amare quando fa freddo, [musica]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "quando hai cenere nei palmi delle mani, non acciaio. DI",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "se solo lo sapessi in anticipo, [musica]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "come questa trasparente farà male nell'anima",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristezza",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Non ha detto, [musica] non ha abbracciato, non aveva tempo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Questo è un motivo eterno",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ho conservato tutto per dopo, il mio cuore non appartiene agli altri",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "aperto. [musica]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Stiamo combattendo contro l'ombra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Ci consumiamo per inezie insignificanti",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "E non si può vedere come si deposita il gelo",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sulle nostre spalle",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ma la felicità non sta nello scintillio di una vetrina",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musica] non in una mazzetta di banconote, ma in un silenzio",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "la verità dei parenti, nel loro calore in mezzo alle tempeste. Ma",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "apprezziamo solo ciò che [la musica] è già",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "Impossibile restituirlo",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Continuando il mio lungo",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "e spesso [la musica] è un percorso senza senso",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "impariamo ad apprezzare quando perdiamo [la musica]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "quando la luce di qualcuno si spegne dietro la porta",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Salutiamo con la mano [musica] i treni partiti",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "Cercando di implorare il passato per ottenere una risposta",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Impariamo ad amare [la musica] quando si è raffreddata",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "quando ci sono ceneri nei palmi, [musica] e non",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acciaio. DI",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Se solo sapessi in anticipo come si lamenterebbe",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "questa tristezza trasparente nell'anima",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Chiama gli anziani, abbracciali",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mentre il polso batte",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lasciamo passare i rancori, oggi sono a favore di questo",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Io prego",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Perché tutte le canzoni hanno una fine",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "alla fine, uno",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[canto]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Noi [la musica] restiamo nel ricordo delle pietre miliari",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "siamo seduti dimenticati",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Impariamo ad apprezzare quando perdiamo",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "quando la musica di qualcuno esce da dietro la porta",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "leggero",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Salutiamo con la mano i treni in partenza, cercando",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "implorare il passato per una risposta",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Impariamo ad amare, [la musica]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "quando si raffreddò, quando c'erano ceneri nei palmi e",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristallo rotto [musica]. Dovrei occuparmene",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "cosa è, mentre siamo qui, fino a",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "volò via",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "anima in lontananza",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
