 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ht_Haitian_Creole.srt",
 "юниты": [
  {
   "text": "[mizik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nouvo sware nan kafe a",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Bwouya epè fonn kay yo. [mizik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mwen mache nan katye kote souvni yo ye a",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "rann mwen fou",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ki kote nan sezon prentan cho a",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ivè kouvri nanm nan",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kote lavi te vole tankou yon flèch, dat ki pase",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nou",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Nou te anpile papye, nou te bliye poukisa nou te",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "nou viv",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Epi li te toujou sanble, [mizik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "toujou gen yon son C pi devan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Jis tan prete",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "pa bay anyen",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Epi toudenkou [mizik] tonbe nan kè m",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "glas frèt",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Nou aprann apresye [mizik] lè nou pèdi",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "lè limyè yon moun etenn dèyè pòt la",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Nou fè siy ak men nou apre tren k ap pati yo, n ap eseye",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "sipliye tan lontan an pou yon repons",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Nou aprann renmen lè l fè frèt, [mizik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "lè gen sann nan pla men ou, pa asye. SOU",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "si sèlman m te konnen davans, [mizik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kijan transparan sa a pral fè mal nan nanm nan",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristès",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Li pa t di, [mizik] li pa t anbrase, li pa t gen tan",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Sa a se yon motivasyon etènèl",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Mwen sere tout bagay pou pita, kè m pa pou lòt moun",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "louvri. [mizik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "N ap goumen ak lonbray la",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "nou boule sou bagay ki pa gen valè",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Epi ou pa ka wè kijan jèl la ap tonbe",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sou zepòl nou yo",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Men, bonè pa nan briye yon vitrin magazen",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[mizik] pa nan yon pakèt biyè, men nan yon trankilite",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "verite fanmi yo, nan chalè yo nan mitan tanpèt yo. Men",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Nou sèlman apresye sa [mizik] ye deja",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "enposib pou retounen",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kontinye tan mwen an",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "e souvan [mizik] se yon chemen san sans",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "nou aprann apresye lè nou pèdi [mizik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "lè limyè yon moun etenn dèyè pòt la",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Nou fè siy ak men nou apre [mizik] tren ki pati yo",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ap eseye sipliye tan lontan an pou yon repons",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Nou aprann renmen [mizik] lè li fin kalme",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "lè gen sann nan pla men yo, [mizik] epi non pa",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "asye. SOU",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Si sèlman m te konnen davans kijan li t ap plenyen anndan",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "tristès transparan sa a nan nanm nan",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Rele granmoun yo, anbrase yo",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "pandan batman kè a ap bat",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Kite plent yo pase, mwen la pou sa jodi a",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Mwen priye",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Paske tout chante gen yon fen",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "nan fen a, youn",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[chante]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Nou [mizik] rete nan memwa gwo evènman yo",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "nou chita bliye",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Nou aprann apresye lè nou pèdi",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "lè mizik yon moun ap jwe dèyè pòt la",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "limyè",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Nou fè siy ak men nou apre tren k ap pati yo, n ap eseye",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "sipliye tan lontan an pou yon repons",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Nou aprann renmen, [mizik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "lè li te refwadi, lè te gen sann nan pla men yo ak",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [mizik] kase. Mwen ta dwe pran swen li",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "kisa ki ye, pandan nou isit la, jiskaske",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "vole ale",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[mizik]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "nanm nan distans la",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[mizik]",
