   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Madzulo atsopano ku shopu ya khofi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Utsi wokhuthala umasungunula nyumba. [nyimbo]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ndimayendayenda m'madera omwe pali zokumbukira",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "kundipangitsa misala",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kumene kuli masika ofunda",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Nyengo yozizira imaphimba moyo",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[nyimbo]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kumene moyo unayenda ngati muvi, masiku akale, akale",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ife",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[nyimbo]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Tinasunga mapepala, tikuiwala chifukwa chake tinali",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "tikukhala",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ndipo nthawi zonse zinkaoneka ngati, [nyimbo]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "patsogolo pake pakadali phokoso la C",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[nyimbo]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Nthawi yobwereka yokha",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "sapereka chilichonse",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ndipo mwadzidzidzi [nyimbo] zimagwera pamtima panga",
