 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/oc_Occitan.srt",
 "юниты": [
  {
   "text": "[musica]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Novèla serada al cafè",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "La nèbla espessa dissòlv los ostals. [musica]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Vagui pels quartièrs ont son los sovenirs",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "me far fòl",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ont dins la cauda prima",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "L'ivèrn cobrís l'alma",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ont la vida volèt coma una sageta passadas de datas, passadas",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nosautres",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Amassèrem de papièrs, oblidant perqué",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vivèm",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "E semblava totjorn, [musica]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "i a encara un son C davant",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Veni d'empruntar de temps",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "dona pas res",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "E d'un còp [la musica] tomba sus mon còr",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "glaç freg",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Aprenèm a apreciar [la musica] quand perdèm",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "quand la lutz de qualqu'un s'apaga darrièr la pòrta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Brandissèm après los trens que partisson, en ensajar",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "pregar lo passat per una responsa",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Aprenèm a aimar quand fa fred, [musica]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "quand i a de cendres dins vòstras palmas, pas d'acièr. A PREPAUS",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "se solament o sabiái d'avança, [musica]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "cossí aquel transparent farà mal dins l'èime",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristesa",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Diguèt pas, [musica] s'abracèt pas, aviá pas lo temps",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Aquò's un motiu eternal",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ai gardat tot per mai tard, mon còr es pas pels autres",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "dobèrt. [musica]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Lucham amb l'ombra",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "nos cremam per de bagatèlas vuèjas",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "E podètz pas veire cossí la gelada s'installa",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sus nòstras espatlas",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mas lo bonur es pas dins lo lusor d'una vitrina",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musica] pas dins un fum de bilhets, mas dins un silenci",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "la vertat de parents, dins lor calor demest las tempèstas. Mas",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "apreciam pas que çò que [la musica] es ja",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "impossible de tornar",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "En contunhant mon long",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "e sovent [la musica] es un camin sens sens",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "aprenèm a apreciar quand pèrdèm [la musica]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "quand la lutz de qualqu'un s'apaga darrièr la pòrta",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Brandissèm après [musica] los trens partits",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ensajar de pregar lo passat per una responsa",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Aprenèm a aimar [la musica] quand s'es refregida",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "quand i a de cendres dins las paumas, [musica] e pas",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acièr. A PREPAUS",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Se solament sabiái d'avança cossí roncariá dins",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "aquela tristesa transparenta dins l'alma",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Apelatz los vièlhs, abraçatz-los",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "del temps que lo pols bat",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Daissatz passar las grèvas, soi per aquò uèi",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Pregui",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Perque totas las cançons an una fin",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "a la fin, un",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[cantant]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Nosautres [la musica] demoram dins la memòria de las fitas",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "sèm oblidats",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Aprenem a apreciar quand perdèm",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "quand la musica de qualqu'un s'apaga darrièr la pòrta",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lum",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Brandissèm après los trens que partisson, en ensajar",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "pregar lo passat per una responsa",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Aprenèm a aimar, [musica]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "quand se refregissiá, quand i aviá de cendres dins las paumas e",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristal [musica] trencat. Me deuriái ocupar d'aquò",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "çò qu'es, del temps que sèm aquí, fins a",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "s'envolèt",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musica]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "èime dins lo luènh",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
