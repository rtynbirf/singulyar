 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sv_Swedish.srt",
 "юниты": [
  {
   "text": "[musik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ny kväll på kaféet",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Tjock dimma upplöser hus. [musik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Jag vandrar genom kvarteren där minnen finns",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "göra mig galen",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Var i den varma källan",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Vintern täcker själen",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Där livet flög som en pil förbi datum, förflutna",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "oss",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Vi hamstrade papper och glömde varför vi",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vi lever",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Och det verkade alltid, [musik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "det finns fortfarande ett C-ljud framme",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Bara lånad tid",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ger ingenting",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Och plötsligt faller [musik] på mitt hjärta",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kall is",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Vi lär oss att uppskatta [musik] när vi förlorar",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "när någons ljus slocknar bakom dörren",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Vi vinkar efter de avgående tågen och försöker",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "be det förflutna om ett svar",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Vi lär oss att älska när det är kallt, [musik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "när det finns aska i dina handflator, inte stål. OM",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "om jag bara visste i förväg, [musik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hur denna genomskinliga kommer att värka i själen",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sorg",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Han sa inte, [musik] att han inte kramade, han hade inte tid",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Detta är ett evigt motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Jag sparade allt till senare, mitt hjärta är inte för andra",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "öppnad. [musik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Vi kämpar mot skuggan",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "vi brinner ut över tomma bagateller",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Och du kan inte se hur frosten lägger sig",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "på våra axlar",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Men lyckan finns inte i glitteret i ett skyltfönster",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "inte i en bunt sedlar, utan i ett tyst",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "släktingarnas sanning, i deras värme bland stormarna. Men",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "vi uppskattar bara det [musik] som redan är",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "omöjlig att återvända",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Fortsätter min långa",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "och ofta är [musik] en meningslös väg",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "vi lär oss att uppskatta när vi förlorar [musik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "när någons ljus slocknar bakom dörren",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Vi vinkar efter [musik] de avgående tågen",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "försöker be det förflutna om ett svar",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Vi lär oss att älska [musik] när den har svalnat",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "när det finns aska i handflatorna, [musik] och inte",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stål. OM",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Om jag bara visste i förväg hur det skulle gnälla i",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "denna genomskinliga sorg i själen",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Ring de gamla, krama dem",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "medan pulsen slår",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Låt klagomålen passera, jag är för detta idag",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Jag ber",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "För alla låtar har ett slut",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "till slut, en",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[sång]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Vi [musik] bevarar milstolpar i minnet",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "vi sitter bortglömda",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Vi lär oss att uppskatta när vi förlorar",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
