   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "pe rod sipliy lepase pou enn repons",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Nou aprann kontan [lamizik] kan li finn refroidi",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kan ena lasann dan palmie, [lamizik] ek pa",
