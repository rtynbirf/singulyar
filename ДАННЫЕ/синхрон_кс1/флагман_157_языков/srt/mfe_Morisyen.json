   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "sa tristes transparan dan lam",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Apel bann vie dimoun, anbras zot",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "pandan ki batman leker pe bate",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Les bann doleans pase, mo pou sa zordi",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Mo priye",
