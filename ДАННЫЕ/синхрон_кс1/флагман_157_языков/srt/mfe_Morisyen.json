  {
   "text": "[lamizik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nouvo sware dan kafeterya",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Brouyar epe fonn bann lakaz. [lamizik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mo promne dan bann kartie kot ena bann souvenir",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "fer mwa vinn fou",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kot dan printan bien so",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Liver kouver lam",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kot lavi finn anvole kouma enn fles pas bann dat, pas",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nou",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Nou finn ramas bann papie, finn bliye kifer nou",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "nou viv",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ek li ti touletan paret, [lamizik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ena ankor enn son C devan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Zis finn pret letan",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "pa donn nanie",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ek enn kout [lamizik] tom lor mo leker",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "glason fre",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Nou aprann apresie [lamizik] kan nou perdi",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kan lalimier kikenn tengn deryer laport",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Nou fer enn sign apre bann trin ki pe ale, pe sey",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "sipliy lepase pou enn repons",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Nou aprann kontan kan fer fre, [lamizik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kan ena lasann dan to lapat, pa lasie. LOR",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "si selman mo ti kone alavans, [lamizik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kouma sa enn transparan la pou fermal dan lam",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristes",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Li pa finn dir, [lamizik] li pa finn anbrase, li pa finn gagn letan",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Sa li enn motif eternel",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Mo finn gard tou pou taler, mo leker pa pou lezot",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "finn ouver. [lamizik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Nou pe lager ar lonbraz",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "nou fatige lor bann bagatel vid",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ek ou pa trouve kouma sa glason-la pe desann",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[lamizik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "lor nou zepol",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Me boner pa dan briyans enn vitrinn",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[lamizik] pa dan enn ta biye, me dan enn plas trankil",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "laverite bann fami, dan zot lasaler parmi bann siklonn. Me",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "nou zis apresie seki [lamizik] ete deza",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "inposib pou retourne",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kontign mo long",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ek souvan [lamizik] se enn sime ki pena sans",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "nou aprann apresie kan nou perdi [lamizik]",
   "startMs": 135760,
   "endMs": 143480,
