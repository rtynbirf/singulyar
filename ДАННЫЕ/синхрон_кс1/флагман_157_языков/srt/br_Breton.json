{
 "канон": "пульс-синхрон/1",
 "songId": "br_Breton",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/br_Breton.srt",
 "юниты": [
  {
   "text": "[sonerezh]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Abadenn nevez er c'hafedi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Brumenn tev a zizolo an tiez. [sonerezh]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mont a ran dre ar c'harterioù ma vez eñvorennoù",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "lakaat ac'hanon da vezañ sot",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Pelec'h er prantad tomm",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ar goañv a c’holo an ene",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "E-lec'h ma nijas ar vuhez evel ur bir dreist deiziadoù, tremenet",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "deomp",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Dastum a reomp paperioù, o ankounac'haat perak e",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "bevañ a reomp",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ha seblantout a rae bepred, [sonerezh]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ez eus c'hoazh ur son C a-raok",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Amprestet am eus amzer",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ne ro netra",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Hag a-daol-trumm e kouezh [ar sonerezh] war ma c'halon",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "skorn yen",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Desket hon eus priziañ [ar sonerezh] pa gollomp",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "pa vez lazhet gouloù unan bennak a-dreñv an nor",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Hejañ a reomp hon dorn war-lerc'h an trenioù o vont kuit, o klask",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "goulenn digant an amzer dremenet kaout ur respont",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Deskiñ a reomp karout pa vez yen, [sonerezh]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "pa vez ludu en ho taouarn, n'eo ket dir. DIWAR-BENN",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "ma ouien en a-raok, [sonerezh]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "penaos e vo poan gant an hini treuzwelus-se en ene",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristidigezh",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "N'en deus ket lavaret, [sonerezh] n'en deus ket brasaet, n'en deus ket bet amzer",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ur mennozh peurbadus eo hemañ",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Miret em eus pep tra evit diwezhatoc'h, va c'halon n'emañ ket evit ar re all",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "digoret. [sonerezh]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Stourm a reomp gant ar skeud",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "skuizh omp gant traoù dister",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ha ne weler ket penaos emañ ar skorn o tiskuizhañ",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "war hon divskoaz",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Met an eürusted n'emañ ket e sked ur prenestr",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[sonerezh] n'eo ket en ur bern bilhedoù, met en ur sioulder",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "gwirionez kerent, en o tommder e-touez ar gorventennoù. Met",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ne blij deomp nemet ar pezh a zo [ar sonerezh] dija",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "dibosupl da zistreiñ",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "O kenderc'hel gant ma amzer hir",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ha peurliesañ eo [ar sonerezh] un hent hep ster",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "deskiñ a reomp priziañ pa gollomp [sonerezh]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "pa vez lazhet gouloù unan bennak a-dreñv an nor",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Hejañ a reomp hon dorn war-lerc'h [sonerezh] an trenioù aet kuit",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "o klask goulenn ur respont digant an amzer dremenet",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Desket hon eus karet [ar sonerezh] pa vez freskaet",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "pa vez ludu er palmez, [sonerezh] ha n'eo ket",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "dir. DIWAR-BENN",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Ma ouien en a-raok penaos e vije o c'hoarzhin en",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "an tristidigezh treuzwelus-se en ene",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Gervel ar re goz, braga anezo",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "e-keit ma vez ar pols o skeiñ",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Ra dremeno ar c'hlemmoù, me a zo evit se hiziv",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Pediñ a ran",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Rak an holl ganaouennoù o deus un dibenn",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "a-benn ar fin, unan",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kanañ]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Chom a reomp [ar sonerezh] e memor ar palioù",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "azezet omp ankounac'haet",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Desket hon eus priziañ pa gollomp",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "pa vez klevet sonerezh unan bennak a-dreñv an nor",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "skañv",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Hejañ a reomp hon dorn war-lerc'h an trenioù o vont kuit, o klask",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "goulenn digant an amzer dremenet kaout ur respont",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Deskiñ a reomp karout, [sonerezh]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "pa yenae, pa oa ludu er palmez ha",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal [sonerezh] torret. Ret eo din ober war-dro anezhañ",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "petra eo, epad m’emaomp amañ, betek",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "nijal kuit",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ene er pellder",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[sonerezh]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
