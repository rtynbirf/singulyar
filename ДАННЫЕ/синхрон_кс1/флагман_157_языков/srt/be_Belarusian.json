{
 "канон": "пульс-синхрон/1",
 "songId": "be_Belarusian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/be_Belarusian.srt",
 "юниты": [
  {
   "text": "Новы вечар у кавярні",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "густы туман растварае дома",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Я па кварталах блукаю, дзе ўспаміны",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "зводзяць з розуму",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Дзе цёплай вясной",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "душу накрывае зіма",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "Дзе жыццё ляцела стралой міма дат, міма",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "нас",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "Мы збіралі паперкі, забываючы, навошта мы",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "жывем",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "І здавалася заўсёды",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "наперадзе яшчэ гучыць да",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Толькі час у доўг",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "нічога не дае",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "І раптам на сэрца кладзецца",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "халодны лёд",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Мы вучымся шанаваць, калі губляем",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "калі за дзвярыма згасае нечае святло",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Мы махаем услед якія пайшлі цягнікам, спрабуючы",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "вымаліць у мінулага адказ",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Мы вучымся любіць, калі астыла",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "калі ў далонях попел, а не сталь. О",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "калі б ведаць загадзя",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "як будзе ныць у душы гэтая празрыстая",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "смутак",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Не сказаў, не абняў, не паспеў",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Гэта вечны матыў",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Усё бераг на пасля, сэрца для іншых не",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "адчыніў",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Мы змагаемся з ценем",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "згараем у пустых дробязях",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "І не відаць, як іней садзіцца",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "на нашых плячах",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Толькі шчасце не ў бляску вітрыны",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "не ў пачку купюр, а ў ціхай",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "праўдзе родных, у іх цяпле сярод бур. Але",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "мы шануем толькі тое, што ужо",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "немагчыма вярнуць",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Працягваючы свой доўгі",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "і часта бессэнсоўны шлях",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "мы вучымся шанаваць, калі губляем",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "калі за дзвярыма згасае нечае святло",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Мы махаем услед якія пайшлі цягнікам",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "спрабуючы вымаліць у мінулага адказ",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Мы вучымся любіць, калі астыла",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "калі ў далонях попел, а не",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "сталь. О",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "калі б ведаць загадзя, як будзе ныць у",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "душы гэты празрысты смутак",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Патэлефануй старым, абдымі",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "пакуль б'ецца пульс",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Няхай крыўды пройдуць, я за гэта сёння",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "малюся",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "Таму што фінал ва ўсіх песень",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "у выніку адзін",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[спевы]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Мы застаемся ў памяці вех",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "забытых сядзім",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "Мы вучымся шанаваць, калі губляем",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "калі за дзвярыма згасае нечый",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "святло",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Мы махаем услед якія пайшлі цягнікам, спрабуючы",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "вымаліць у мінулага адказ",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Мы вучымся любіць",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "калі астыла, калі ў далонях попел і",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "разбітая крышталь. Берагчы б",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "тое, што ёсць, пакуль мы тут, пакуль не",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "паляцела",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "душа ўдалячынь",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  }
 ]
