  },
  {
   "text": "irin. NÍPA",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Tí mo bá mọ̀ tẹ́lẹ̀ bí yóò ṣe máa kùn nínú",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ibanujẹ kedere yii ninu ọkan",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Pe àwọn arúgbó, gbá wọn mọ́ra",
