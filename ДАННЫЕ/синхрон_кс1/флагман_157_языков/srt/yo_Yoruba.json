   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[orin]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "nígbà tí ìlù ọkàn náà ń lù",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Jẹ́ kí àwọn ẹ̀dùn náà kọjá, mo wà fún èyí lónìí",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Mo gbadura",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[orin]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Nítorí gbogbo orin ló ní òpin",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "nígbẹ̀yìn-gbẹ́yín, ọ̀kan",
