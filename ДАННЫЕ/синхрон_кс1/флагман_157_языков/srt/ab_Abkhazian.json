{
 "канон": "пульс-синхрон/1",
 "songId": "ab_Abkhazian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ab_Abkhazian.srt",
 "юниты": [
  {
   "text": "[амузыка]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Ахәылԥаз ҿыц акаҳуажәырҭаҿы",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Аԥсҭҳәа жәпа аҩнқәа арӡаауеит. [амузыка]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Агәалашәарақәа ахьыҟоу аҳаблақәа срылсуеит",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "сеилагоит",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Иабаҟоу ааԥын ԥха",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Аӡын аԥсы хнаҩоит",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Аԥсҭазаара ахыц еиԥш иахьԥыруаз арыцхәқәа ирхысыз, ииасхьоу",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ҳара ҳзы",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Ақьаадқәа еизаҳгеит, ҳзыхҟьаз ҳхашҭны",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ҳанхоит",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Иара еснагь еиԥш иҟан, [амузыка]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ԥхьаҟа уажәгьы С абжьы ыҟоуп",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Аамҭа ԥсахны",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "акгьы анаҭом",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Иаалырҟьаны [амузыка] сгәы иқәҳауеит",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "аҵаа хьҭа",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Ҳара иаҳҵоит [амузыка] ахә ашьара ҳанцәыӡуа",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ашә ашьҭахь аӡәы илашара аныцәо",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Идәықәло адәыӷбақәа ҳрышьҭаланы ҳнапқәа ҟьоит, ҳҽазаҳшәоит",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ииасхьоу аамҭа аҭак азыҳәа",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Ҳара иаҳҵоит абзиабара ахьҭа аныҟоу, [амузыка]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "унапқәа рҿы ашәындыҟәра аныҟоу, аџыр акәымкәа. АЗЫ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "заа издыруазҭгьы, [амузыка]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "Абри иҵәцаны аԥсы шԥахьаауа",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "алахьеиқәра",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Имҳәеит, [амузыка] дгәыдикылеит, аамҭа имамызт",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ари наӡаӡатәи мотивуп",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Зегь еиқәсырхеит уашьҭан, сгәы егьырҭ рзы акәӡам",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "аатит. [амузыка]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ҳаибашьуеит ашәшьы",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ҭацәу амаҭәахәқәа рзы ҳгәы ҭҟьоит",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Насгьы иубаӡом аҵаа шҭатәо",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ҳмахәҿақәа рҿы",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Аха анасыԥ адәқьан аԥенџьыр аҿы иҟаӡам",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[амузыка] абиллқәа рыла акәымкәа, ҭынч",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "аҭынхацәа рыҵабырг, аԥшацәгьақәа рыбжьара рыԥхарраҿы. Аха",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Ҳара ҳаҭыр зқәу [амузыка] иҟоу мацара ауп",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ҳхынҳәыр залшом",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Иацҵаны сызҿу",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "насгьы лассы-лассы [амузыка] ҵакы змам мҩоуп",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "[амузыка] анаҳцәыӡуа, уи ахә ашьара ҳҵоит",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ашә ашьҭахь аӡәы илашара аныцәо",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Идәықәлаз адәыӷбақәа ҳнапқәа рышьҭаҳхуеит",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ииасхьоу аҭак азы аҳәара рҽазыршәоит",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Ҳара [амузыка] бзиа абара ҳҵоит уи анхьшәашәалак",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "анапқәа рҿы ашәындыҟәра аныҟоу, [амузыка] акәымкәа",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "аџыр. АЗЫ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Заа издыруазҭгьы уи шҵәыуоз",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "аԥсы иҭоу абри иҵәцароу алахьеиқәра",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Аҭаҳмадацәа шәрыԥхьа, шәрыгәӡ",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "апульс еисуа аамҭазы",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Агәынамӡарақәа мҩасааит, сара иахьа абри азы сыҟоуп",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Сныҳәоит",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Избанзар ашәақәа зегьы анҵәамҭа рымоуп",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "аҵыхәтәан, акы",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ашәаҳәара]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ҳара [амузыка] ҳгәалашәараҿы ҳаанхоит",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ҳхашҭны ҳатәоуп",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Ҳара иаҳҵоит ахә ашьара ҳанцәыӡуа",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "Аӡәы имузыка ашә ашьҭахь ианҭыҵлак",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "алашара",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Идәықәло адәыӷбақәа ҳрышьҭаланы ҳнапқәа ҟьоит, ҳҽазаҳшәоит",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ииасхьоу аамҭа аҭак азыҳәа",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ҳара абзиабара ҳҵоит, [амузыка]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "аныхьшәашәаха, анапқәа рҿы ашәҭқәа аныҟаз, насгьы",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "еиҟәыҷҷоу [амузыка] акристалл. Уи сара сахылаԥшроуп",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "Иҟоузеи, ара ҳаҟанаҵы",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "Иԥырны ицеит",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "аԥсы хараӡа",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[амузыка]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
