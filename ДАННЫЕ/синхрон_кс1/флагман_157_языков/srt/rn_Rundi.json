 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/rn_Rundi.srt",
 "юниты": [
  {
   "text": "[umuziki]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Umugoroba mushasha ku kafe",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Igihu gikomeye kirasenyura amazu. [umuziki]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ndagendagenda mu mihana aho ivyibukwa biri",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "kuntera ubusazi",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Aho mu mpera z’umwaka ushushe",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Imbeho irapfuka umutima",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Aho ubuzima bwagurutse nk’umwampi buheze amatariki, buheze",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "twebwe",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Twararundanije impapuro, twibagirwa igituma",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "turabaho",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Kandi vyama bisa n’uko, [umuziki]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "haracariho ijwi rya C imbere",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Igihe naguze gusa",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nta co atanga",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Kandi bukwi na bukwi [umuziki] uragwa ku mutima wanje",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "barafu ikanye",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Twiga gukenguruka [umuziki] iyo dutakaje",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "iyo umuco w’umuntu uzimye inyuma y’umuryango",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Turazunguza amaboko inyuma y’amagariyamoshi ariko aragenda, tugerageza",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "gusaba kahise inyishu",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Twiga gukunda iyo hakanye, [umuziki]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "iyo hari ivu mu biganza vyawe, atari ivyuma. HAFI",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "iyo menya imbere y’igihe, [umuziki]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "ingene uwubonerana azobabara mu mutima",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "umubabaro",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ntiyavuze, [umuziki] ntiyahobera, nta mwanya yari afise",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ivyo ni imvo y’ibihe bidahera",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Vyose nabikiye kugira ngo bizoza, umutima wanje ntabwo ari uw'abandi",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ryarafunguwe. [umuziki]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Turarwana n’igitutu",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "turasha kubera utuntu dutoduto tw’ubusa",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Kandi ntushobora kubona ingene igihuhusi kiriko kirahagarara",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ku bitugu vyacu",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ariko umunezero ntuba mu gukayangana kw’idirisha ry’iduka",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[umuziki] si mu gipfukisho c’amahera, ahubwo mu gacerere",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ukuri kw’incuti, mu bushuhe bwazo hagati y’ibihuhusi. Ariko",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "dushima gusa ivyo [umuziki] usanzwe uri",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ntibishoboka ko umuntu asubirayo",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Gukomeza igihe kirekire",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "kandi kenshi [umuziki] ni inzira itagira ico isobanura",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "twiga gukenguruka iyo dutakaje [umuziki]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "iyo umuco w’umuntu uzimye inyuma y’umuryango",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Turazunguza inyuma [umuziki] amagariyamoshi yagiye",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "kugerageza gusaba kahise ngo karonke inyishu",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Twiga gukunda [umuziki] iyo umaze gukonja",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "iyo hari ivu mu biganza, [umuziki] nta",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ivyuma. HAFI",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Iyo menya imbere y’igihe ingene izoboroga mu 2019",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "uwo mubabaro ugaragara mu mutima",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Hamagara abasaza, ubahobere",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "mu gihe umutima uriko uratera",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Reka ivyo kwidodomba bigende, ndi ku bw'ivyo uno musi",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ndasenga",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kuko indirimbo zose zifise iherezo",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "mu mpera, umwe",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kuririmba]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Twebwe [umuziki] turaguma mu ciyumviro c’ibintu bihambaye",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "twicara twibagiwe",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[umuziki]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Twiga gukenguruka iyo dutakaje",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "iyo umuziki w'umuntu usohotse inyuma y'umuryango",
   "startMs": 191760,
