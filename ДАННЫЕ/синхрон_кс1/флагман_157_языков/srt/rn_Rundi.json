   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "gusaba kahise inyishu",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Twiga gukunda, [umuziki]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "igihe cakonja, igihe hari ivu mu bikeni kandi",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "[umuziki] wavunitse. Nkwiye kuvyitaho",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
