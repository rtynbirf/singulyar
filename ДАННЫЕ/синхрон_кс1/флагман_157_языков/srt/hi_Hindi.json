{
 "канон": "пульс-синхрон/1",
 "songId": "hi_Hindi",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/hi_Hindi.srt",
 "юниты": [
  {
   "text": "[संगीत]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "कॉफी शॉप में एक नई शाम",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "घने कोहरे में घर धुंधले पड़ जाते हैं। [संगीत]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "मैं उन मोहल्लों में घूमता हूँ जहाँ यादें बसी हैं।",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "मुझे पागल कर दो।",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "गर्म वसंत में कहाँ",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "सर्दी आत्मा को ढक लेती है।",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "जहां जीवन तीर की तरह समय के पार, अतीत के पार उड़ता चला गया",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "हम।",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "हम कागजों का ढेर लगाते रहे, यह भूलकर कि हम ऐसा क्यों कर रहे थे।",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "हम रहते हैं।",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "और ऐसा हमेशा लगता था, [संगीत]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "अभी आगे C की ध्वनि आनी बाकी है।",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "बस उधार का समय",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "कुछ नहीं देता।",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "और अचानक [संगीत] मेरे दिल पर छा जाता है",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "ठंडी बर्फ।",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "हम हारने पर ही संगीत की कद्र करना सीखते हैं।",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "जब दरवाजे के पीछे किसी की बत्ती बुझ जाती है।",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "हम जाती हुई ट्रेनों को हाथ हिलाकर विदा करते हैं, कोशिश करते हुए",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "अतीत से उत्तर मांगो।",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "हम ठंड के मौसम में प्यार करना सीखते हैं, [संगीत]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "जब आपकी हथेलियों में राख हो, स्टील नहीं। के बारे में",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "काश मुझे पहले से पता होता, [संगीत]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "यह पारदर्शी आत्मा को कितना कष्ट देगा!",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "दुख।",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "उन्होंने कुछ नहीं कहा, [संगीत] उन्होंने गले नहीं लगाया, उनके पास समय नहीं था।",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "यह एक शाश्वत प्रेरणा है।",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "मैंने सब कुछ बाद के लिए बचा लिया, मेरा मन दूसरों के लिए नहीं है।",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "खोला गया। [संगीत]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "हम परछाई से लड़ रहे हैं।",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "हम तुच्छ बातों पर ही थक जाते हैं।",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "और आप यह नहीं देख सकते कि पाला कैसे जम रहा है।",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "हमारे कंधों पर।",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "लेकिन खुशी किसी दुकान की चमक-दमक में नहीं होती।",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[संगीत] नोटों के गट्ठे में नहीं, बल्कि एक शांत वातावरण में",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "तूफानों के बीच रिश्तेदारों की गर्मजोशी में ही उनकी सच्चाई छिपी होती है। लेकिन",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "हम केवल उसी चीज़ की सराहना करते हैं जो [संगीत] पहले से मौजूद है।",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "वापस करना असंभव है।",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "अपनी लंबी यात्रा जारी रखते हुए",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "और अक्सर [संगीत] एक अर्थहीन मार्ग होता है।",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "जब हम [संगीत] खो देते हैं तो हम उसकी सराहना करना सीखते हैं।",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "जब दरवाजे के पीछे किसी की बत्ती बुझ जाती है।",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "हम गुजरते हुए ट्रेनों को [संगीत] के साथ हाथ हिलाकर विदाई देते हैं।",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "अतीत से जवाब पाने की गुहार लगाने की कोशिश कर रहा है।",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "जब संगीत थोड़ा ठंडा हो जाता है, तब हम उससे प्यार करना सीखते हैं।",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "जब हथेलियों में राख होती है, [संगीत] और नहीं",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "इस्पात। के बारे में",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "काश मुझे पहले से पता होता कि यह कैसे रोएगा",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "आत्मा में व्याप्त यह स्पष्ट उदासी।",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "बुजुर्गों को बुलाओ, उन्हें गले लगाओ",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "जब नाड़ी धड़क रही हो।",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "शिकायतों को भूल जाइए, मैं आज इसके पक्ष में हूँ।",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "मैं प्रार्थना करता हूं।",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "क्योंकि सभी गानों का एक अंत होता है",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "अंत में, एक।",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[गायन]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "हम [संगीत] महत्वपूर्ण उपलब्धियों की स्मृति में बने रहते हैं",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "हम भुला दिए गए हैं।",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "हम हार से ही उसकी कद्र करना सीखते हैं।",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "जब किसी का संगीत दरवाजे के पीछे से बाहर चला जाता है",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "रोशनी।",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "हम जाती हुई ट्रेनों को हाथ हिलाकर विदा करते हैं, कोशिश करते हुए",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "अतीत से उत्तर मांगो।",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "हम प्यार करना सीखते हैं, [संगीत]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "जब वह ठंडा हो गया, जब ताड़ के पत्तों में राख रह गई और",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "टूटा हुआ [संगीत] क्रिस्टल। मुझे इसका ध्यान रखना चाहिए",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "जब तक हम यहां हैं, तब तक क्या है?",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "उड़ गया",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "आत्मा दूर तक विचरण करती हुई।",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
