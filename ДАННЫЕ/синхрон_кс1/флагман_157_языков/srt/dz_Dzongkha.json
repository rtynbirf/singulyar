 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/dz_Dzongkha.srt",
 "юниты": [
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "ཀོ་ཕི་ཚོང་ཁང་ནང་དགོང་མོ་གསརཔ།",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "སྨུག་སྤྲིན་སྦོམ་གྱིས་ཁྱིམ་ཚུ་བཞུ་བཅུགཔ་ཨིན། [སྙན༌ཆ]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "དྲན་ཤེས་ཡོད་སའི་ཉེ་འདབས་བརྒྱུད་ནས་འཁྱམས་བཞིན་ཡོད།",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ང་སྨྱོ་བཅུག།",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "གང་དུ་དྲོ་བའི་དཔྱིད་ལུ།",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "དགུན་ཁ་རྣམ་ཤེས་ཁྱབ་ཡོད།",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "ཚེ་སྲོག་འདས་ཟིན་པའི་ཚེས་གྲངས་མདའ་ལྟར་གང་དུ་འཕུར་སོང་།",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ང༌བཅས།",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "ང་བཅས་ཀྱིས་ ཤོག་གུ་བསྡུ་གསོག་འབད་ཡི་ ག་ཅི་འབད་ཨིན་ན་ བརྗེད་སོང་ནུག།",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ང་བཅས་སྡོདཔ་ཨིན།",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "དེ་ལས་རྟག་བུ་རང་ [རོལ་དབྱངས།]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ད་ལྟོ་ཡང་གདོང་ཁར་ C སྒྲ་ཡོད།",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "དུས་ཚོད་གཡར་ཡི།",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "གང་ཡང་མི་བྱིན།",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "གློ་བུར་དུ་ [རོལ་དབྱངས།] ངའི་སེམས་ལ་ལྷུང་།",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "འཁྱགས་རོམ་བསིལ་པོ།",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ཕམ་པའི་སྐབས་ [རོལ་དབྱངས།] བཀའ་དྲིན་ཆེ་ཞུ་བར་སྦྱང་།",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "མི་གཅིག་གི་འོད་འདི་སྒོ་རྒྱབ་ཁར་འགྱོ་བའི་སྐབས།",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "ང་བཅས་ཀྱིས་ རེ་ལི་ཚུ་འགྱོ་བའི་ཤུལ་ལས་ ལགཔ་བརྐྱབ་སྟེ་ འབད་རྩོལ་བསྐྱེདཔ་ཨིན།",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ལན་ཅིག་གི་དོན་ལུ་ འདས་པའི་དུས་ལུ་ཞུ་བ་འབད།",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་བསིལ་དུས་བརྩེ་བ་སྦྱངས།",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "ཁྱོད་ཀྱི་ལགཔ་ནང་ལུ་ ལྕགས་མེན་པར་ གོ་ཐལ་ཡོད་པའི་སྐབས། སྐོར་ལས",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "གལ་ཏེ་ངས་སྔོན་ནས་ཤེས་ན། [རོལ་དབྱངས།]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "དྭངས་གསལ་འདི་སེམས་ཁར་ག་དེ་སྦེ་ན་འོང་།",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "བློ་འགྱོད།",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "ཁོ་གིས་མ་སླབ་པར་ [རོལ་དབྱངས་] ཁོ་གིས་ འཐམ་མ་བཏུབ་པར་ དུས་ཚོད་མེདཔ་ཨིན།",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "།འདི་ནི་རྟག་པའི་ཀུན་སློང་ཡིན།",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "ག་ར་ཤུལ་ལས་བསགས་བཞག་ཡི།ངེ་གི་སེམས་འདི་གཞན་གྱི་དོན་ལུ་མེན།",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ཁ་ཕྱེ་ཡོདཔ། [སྙན༌ཆ]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ང་བཅས་གྱིབ་མ་དང་གཅིག་ཁར་འཐབ་དོ།",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་སྟོངམ་ཆུང་ཆུང་ཚུ་གུ་འཚིག་འོང་།",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "འཁྱགས་རོམ་འདི་ག་དེ་སྦེ་གཞི་ཆགས་དོ་ཡོདཔ་ཨིན་ན་ ཁྱོད་ཀྱིས་མཐོང་མི་ཚུགས།",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "ང་བཅས་ཀྱི་དཔུང་པ་གུ་ལུ།",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "འོན་ཀྱང་དགའ་སྐྱིད་ནི་ཚོང་ཁང་གི་སྒེའུ་ཁུང་གི་འོད་མདངས་ནང་མེད།",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[རོལ་དབྱངས།] དངུལ་འཛིན་གྱི་སྒམ་ནང་མིན་པར་ཁུ་སིམ་སིམ་གྱི་ནང་དུ།",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ཉེ་ཚན་གྱི་བདེན་པ། རླུང་འཚུབ་ཀྱི་བར་ན་ཁོང་ཚོའི་དྲོད་ཁོལ། དེ་འབདཝ་ད",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ [རོལ་དབྱངས།] གང་ཡིན་པ་དེ་ལ་དགའ་བསུ་ཞུ་གི་ཡོད།",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ལོག་འོང་མི་ཚུགས།",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "ངའི་ཡུན་རིང་འཕྲོ་མཐུད།",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "དང་ཡང་ཡང་ [རོལ་དབྱངས་] དོན་མེད་ཀྱི་ལམ་ཡིན།",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ [རོལ་དབྱངས] བརླག་པའི་སྐབས་བཀའ་དྲིན་ཆེ་ཟེར་ལྷབ།",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "མི་གཅིག་གི་འོད་འདི་སྒོ་རྒྱབ་ཁར་འགྱོ་བའི་སྐབས།",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ [རོལ་དབྱངས] འགྲོ་བའི་མེ་འཁོར་གྱི་རྗེས་སུ་ལག་གཡུག་བྱེད།",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ལན་ཅིག་གི་དོན་ལུ་ འདས་པའི་དུས་ལུ་ ཞུ་བ་འབད་ནི་གི་དཔའ་བཅམ་དོ་ཡོདཔ་ཨིན།",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་ [རོལ་དབྱངས་] ལུ་དགའ་བ་ལྷབ་པའི་སྐབས་ བསིལ་དྲགས་སོང་།",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "ལག་མཐིལ་ན་གོ་ཐལ་ཡོད་པའི་ཚེ།[རོལ་དབྱངས་]དང་མིན།",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ལྕགས། སྐོར་ལས",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "གལ་ཏེ་ང་གིས་སྔོན་ལས་ཤེས་པ་ཅིན་ ག་དེ་སྦེ་ ངུ་སྐད་རྐྱབ་འོང་ག་",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "འདི་དྭངས་གསལ་གྱི་སེམས་ཁར་སྡུག་བསྔལ་ཡོད།",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "རྒས་ཤོས་ཚུ་འབོ་སྟེ་ འཐམ་འཁྱུད་འབད།",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "འཕར་རྩ་འཕར་བའི་སྐབས།",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ཉོགས་བཤད་ཚུ་ བརྒལ་བཅུག ང་ད་རེས་འདི་གི་དོན་ལུ་ཨིན།",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "སྨོན་ལམ་བཏབ།",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "ག་ཅི་འབད་ཟེར་བ་ཅིན་ གླུ་གཞས་ཆ་མཉམ་ལུ་ མཇུག་བསྡུ་ཡོདཔ་ཨིན།",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "མཐའ་མར་ གཅིག །",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[གཞས་གཏོང་བ།]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་ [རོལ་དབྱངས་] ལམ་ཚད་ཀྱི་དྲན་ཤེས་ནང་ལུས་ཡོད།",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ང་ཚོ་བརྗེད་སོང།",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "ང་བཅས་ཀྱིས་ཕམ་པའི་སྐབས་བཀའ་དྲིན་ཆེ་ཟེར་ལྷབ།",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "མི་ཞིག་གི་རོལ་དབྱངས་སྒོའི་རྒྱབ་ཏུ་འགྲོ་སྐབས།",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ཡང་འཕྲོས་འཕྲོས།",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "ང་བཅས་ཀྱིས་ རེ་ལི་ཚུ་འགྱོ་བའི་ཤུལ་ལས་ ལགཔ་བརྐྱབ་སྟེ་ འབད་རྩོལ་བསྐྱེདཔ་ཨིན།",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "ལན་ཅིག་གི་དོན་ལུ་ འདས་པའི་དུས་ལུ་ཞུ་བ་འབད།",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "ང་ཚོས་བརྩེ་བ་སྦྱངས།, [རོལ་དབྱངས།]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "བསིལ་དྲགས་པའི་སྐབས་ ལགཔ་གི་མཐེ་བོང་ནང་ གོ་ཐལ་ཡོད་པའི་སྐབས།",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "broken [རོལ་དབྱངས་] ཕྲེང་བ། ང་གིས་བདག་འཛིན་འཐབ་དགོ།",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ག་ཅི་སྨོ་ཟེར་བ་ཅིན་ ང་བཅས་འདི་ཁར་སྡོད་པའི་སྐབས་ལུ་",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "འཕུར་སོང།",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "སེམས་འདི་ཐག་རིང་ནང་ལུ་འགྱོ།",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[སྙན༌ཆ]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
