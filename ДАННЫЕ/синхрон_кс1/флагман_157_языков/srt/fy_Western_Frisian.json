 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/fy_Western_Frisian.srt",
 "юниты": [
  {
   "text": "[muzyk]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nije jûn yn 'e kofjeshop",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Dikke mist ferneatiget huzen. [muzyk]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ik dwaal troch de buerten dêr't oantinkens binne",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "my gek meitsje",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Wêr yn 'e waarme maitiid",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "De winter bedekt de siel",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Wêr't it libben as in pylk foarby datums, ferline fleach",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ús",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Wy hawwe papieren opspoard, en fergetten wêrom't wy",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "wy libje",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "En it like altyd, [muzyk]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "der is noch in C-lûd foarút",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Gewoan liende tiid",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "jout neat",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "En ynienen falt [muzyk] op myn hert",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kâld iis",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Wy leare [muzyk] te wurdearjen as wy ferlieze",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "as immen syn ljocht efter de doar útgiet",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Wy winke nei de fertrekkende treinen, en besykje",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "freegje it ferline om in antwurd",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Wy leare leaf te hawwen as it kâld is, [muzyk]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "as der jiske yn jo hannen sit, net stiel. OER",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "as ik it mar fan tefoaren wist, [muzyk]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hoe't dizze transparante ien yn 'e siel sear dwaan sil",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "fertriet",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hy sei net, [muzyk] hy knuffelde net, hy hie gjin tiid",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dit is in ivich motyf",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ik haw alles foar letter bewarre, myn hert is net foar oaren",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "iepene. [muzyk]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Wy fjochtsje mei de skaad",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "wy baarne út oer lege lytsichheden",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "En jo kinne net sjen hoe't de froast him delset",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "op ús skouders",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mar lok sit net yn 'e glitter fan in winkelrút",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzyk] net yn in bondel biljetten, mar yn in rêstige",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "de wierheid fan sibben, yn harren waarmte tusken de stoarmen. Mar",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "wy wurdearje allinnich wat [muzyk] al is",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ûnmooglik om werom te jaan",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Trochgean mei myn lange",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "en faak is [muzyk] in sinleas paad",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "wy leare te wurdearjen as wy [muzyk] ferlieze",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "as immen syn ljocht efter de doar útgiet",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Wy winkje nei de fertrokken treinen [muzyk]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "besykje it ferline om in antwurd te freegjen",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Wy leare fan muzyk te hâlden as it wat ôfkuolle is",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "as der jiske yn 'e palmen sit, [muzyk] en net",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stiel. OER",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "As ik mar fan tefoaren wist hoe't it yn jammerje soe",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "dit transparante fertriet yn 'e siel",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Rop de âlde minsken, knuffel se",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "wylst de pols kloppet",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lit de klachten foarby gean, ik bin hjir hjoed foar",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ik bid",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Want alle ferskes hawwe in ein",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "úteinlik, ien",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[sjongen]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Wy [muzyk] bliuwe yn it ûnthâld fan mylpeallen",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "wy sitte fergetten",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muzyk]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Wy leare te wurdearjen as wy ferlieze",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "as immen syn muzyk efter de doar útgiet",
   "startMs": 191760,
   "endMs": 194959,
