   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "volveme tolo/a",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Onde na cálida primavera",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "O inverno cobre a alma",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Onde a vida voou coma unha frecha pasadas as datas, pasadas",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nós",
