  },
  {
   "text": "[música]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Acumulamos papeis, esquecendo por que",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vivimos",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "E sempre parecía, [música]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "aínda hai un son C máis adiante",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Só tempo prestado",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "non dá nada",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "E de súpeto [a música] cae no meu corazón",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "xeo frío",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Aprendemos a apreciar [a música] cando perdemos",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "cando se apaga a luz de alguén detrás da porta",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Saudamos despois dos trens que parten, intentando",
