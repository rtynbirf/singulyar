  {
   "text": "tristeza",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Non dixo, [música] non abrazou, non tivo tempo",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Este é un motivo eterno",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Gardeino todo para máis tarde, o meu corazón non está para os demais",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "aberto. [música]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Estamos loitando coa sombra",
