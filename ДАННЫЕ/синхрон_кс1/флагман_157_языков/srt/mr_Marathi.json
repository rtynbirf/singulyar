  },
  {
   "text": "आम्ही",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "आम्ही कागदपत्रे साठवली, आम्ही का साठवली हेच विसरून",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "आपण जगतो",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "आणि मला नेहमीच असं वाटायचं, [संगीत]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "पुढे अजून 'C' चा उच्चार आहे",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[संगीत]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "हा केवळ उधार घेतलेला वेळ आहे",
