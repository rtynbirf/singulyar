   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "मी अशा परिसरांमधून भटकतो जिथे आठवणी जपलेल्या आहेत",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "माझं डोकं फिरवा",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "उबदार झऱ्यात कुठे",
