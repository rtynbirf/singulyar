 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sw_Swahili.srt",
 "юниты": [
  {
   "text": "[muziki]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Jioni mpya katika duka la kahawa",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ukungu mzito huyeyusha nyumba. [muziki]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ninazunguka-zunguka katika vitongoji ambapo kumbukumbu ziko",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "kunifanya niwe mwendawazimu",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ambapo katika chemchemi ya joto",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Baridi hufunika roho",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ambapo maisha yaliruka kama mshale tarehe zilizopita, zilizopita",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "sisi",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Tulihifadhi karatasi, tukisahau kwa nini",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "tunaishi",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Na ilionekana kila wakati, [muziki]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "bado kuna sauti ya C mbele",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Muda uliokopwa tu",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "haitoi chochote",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Na ghafla [muziki] unaingia moyoni mwangu",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "barafu baridi",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Tunajifunza kuthamini [muziki] tunapopoteza",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "taa ya mtu inapozimika nyuma ya mlango",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Tunapunga mkono baada ya treni zinazoondoka, tukijaribu",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "Omba jibu la yaliyopita",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Tunajifunza kupenda wakati kuna baridi, [muziki]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "wakati kuna majivu mikononi mwako, si chuma. KUHUSU",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "kama ningejua mapema, [muziki]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "jinsi hii ya uwazi itakavyouma rohoni",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "huzuni",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Hakusema, [muziki] hakukumbatiana, hakuwa na muda",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Hii ni nia ya milele",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Niliweka akiba kila kitu kwa ajili ya baadaye, moyo wangu si kwa ajili ya wengine",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "imefunguliwa. [muziki]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Tunapigana na kivuli",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Tunachoma kwa vitu vidogo vidogo",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Na huwezi kuona jinsi baridi inavyotulia",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "kwenye mabega yetu",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Lakini furaha haiko kwenye pambo la dirisha la duka",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muziki] si katika kijiti cha noti, bali katika utulivu",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ukweli wa jamaa, katika joto lao kati ya dhoruba. Lakini",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "tunathamini tu kile ambacho [muziki] tayari upo",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "haiwezekani kurudi",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kuendelea na muda wangu mrefu",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "na mara nyingi [muziki] ni njia isiyo na maana",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Tunajifunza kuthamini tunapopoteza [muziki]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "taa ya mtu inapozimika nyuma ya mlango",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Tunapungia mkono treni zilizoondoka baada ya [muziki]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "kujaribu kuomba jibu kutoka zamani",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Tunajifunza kupenda [muziki] wakati hali imetulia",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "wakati kuna majivu kwenye viganja vya mikono, [muziki] na si",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "chuma. KUHUSU",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Laiti ningejua mapema jinsi itakavyokuwa ikilia",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "huzuni hii ya wazi katika nafsi",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Waite wazee, wakumbatie",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "huku mapigo ya moyo yakipiga",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Acha malalamiko yapite, mimi niko kwa ajili ya hili leo",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Naomba",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kwa sababu nyimbo zote zina mwisho wake",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "mwishowe, moja",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kuimba]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Sisi [muziki] tunabaki katika kumbukumbu ya matukio muhimu",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "tumekaa tumesahaulika",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muziki]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Tunajifunza kuthamini tunapopoteza",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "muziki wa mtu unapotoka nje ya mlango",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "mwanga",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Tunapunga mkono baada ya treni zinazoondoka, tukijaribu",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "Omba jibu la yaliyopita",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Tunajifunza kupenda, [muziki]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "ilipopoa, majivu yalipoingia kwenye viganja vya mikono na",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kioo [cha muziki] kilichovunjika. Ninapaswa kuishughulikia",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ni nini, tunapokuwa hapa, hadi",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "akaruka mbali",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
