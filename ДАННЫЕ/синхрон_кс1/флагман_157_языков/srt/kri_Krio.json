{
 "канон": "пульс-синхрон/1",
 "songId": "kri_Krio",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/kri_Krio.srt",
 "юниты": [
  {
   "text": "[myuzik]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nyu ivintɛm na di kɔfi shɔp",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Tik tik fɔg kin sɔlv os dɛn. [myuzik]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "A kin waka waka na di neba dɛn usay mɛmori dɛn de",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "drayv mi krayzi",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Usay insay di wam spring",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Winta kin kɔba di sol",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Usay layf bin de flay lɛk aro pas deti, pas",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "wi",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Wi bin de gɛda pepa dɛn, ɛn fɔgɛt wetin mek wi",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "wi de liv",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ɛn i bin tan lɛk ɔltɛm, [myuzik]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "wan C sawnd stil de bifo",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Jɔs lɛnt tɛm",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nɔ de gi natin",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ɛn wantɛm wantɛm [myuzik] kin fɔdɔm na mi at",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kol ays",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Wi kin lan fɔ gladi fɔ [myuzik] we wi lɔs",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "we pɔsin in layt go ɔt biɛn di domɔt",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Wi de wev afta di tren dɛn we de kɔmɔt, ɛn tray",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "beg di past fɔ gɛt ansa",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Wi kin lan fɔ lɛk we i kol, [myuzik]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "we ashis de na yu an, nɔto stɛl. BƆT",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "if nɔmɔ a bin no bifo tɛm, [myuzik]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "aw dis transparent wan go pen na di sol",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "sɔri-at",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "I nɔ bin se, [myuzik] i nɔ bin ɔg, i nɔ bin gɛt tɛm",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Dis na sɔntin we de mek pɔsin want fɔ du sɔntin sote go",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "A bin kip ɔltin fɔ leta, mi at nɔ de fɔ ɔda pipul dɛn",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "opin. [myuzik]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Wi de fɛt wit di shado",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "wi kin bɔn ɔt pan ɛmti smɔl smɔl tin dɛn",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ɛn yu nɔ ebul fɔ si aw di frɔst de setul",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "na wi sholda dɛn",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Bɔt gladi-at nɔ de insay di glita we de shayn na wan shɔp winda",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[myuzik] nɔto insay wan wad fɔ bil, bɔt insay wan kwayɛt",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "di trut bɔt fambul dɛn, insay dɛn wam wam bitwin di big big briz. Bɔt",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "wi jɔs gladi fɔ wetin [myuzik] dɔn ɔlrɛdi bi",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "i nɔ pɔsibul fɔ kam bak",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kɔntinyu fɔ du mi lɔng",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ɛn bɔku tɛm [myuzik] na rod we nɔ gɛt wan minin",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "wi kin lan fɔ gladi we wi lɔs [myuzik]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "we pɔsin in layt go ɔt biɛn di domɔt",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Wi de wev afta [myuzik] di tren dɛn we de kɔmɔt",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "tray fɔ beg di tin dɛn we dɔn pas fɔ gɛt ansa",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Wi kin lan fɔ lɛk [myuzik] we i dɔn kol",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "we ashis de na di palm, [myuzik] ɛn nɔ",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ayɛn. BƆT",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "If a bin no bifo tɛm aw i go whine in",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "dis transparent sadness in di sol",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Kɔl di ol pipul dɛn, ɔg dɛn",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "we di puls de bit",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Mek di grɔj dɛn pas, a de fɔ dis tide",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "A de pre",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Na bikɔs ɔl di siŋ dɛn gɛt ɛnd",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "na di ɛnd, wan",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[we de siŋ]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Wi [myuzik] stil de mɛmba di maylston dɛn",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "wi sidɔm fɔgɛt",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Wi kin lan fɔ gladi we wi lɔs",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "we pɔsin in myuzik de kɔmɔt biɛn di domɔt",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "layt",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Wi de wev afta di tren dɛn we de kɔmɔt, ɛn tray",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "beg di past fɔ gɛt ansa",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Wi kin lan fɔ lɛk, [myuzik]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "we i kol, we ashis bin de na di palm ɛn",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "brok [myuzik] kristal. A fɔ tek kia ɔf am",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "wetin de, we wi de ya, te",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "bin flay go",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[myuzik]",
   "startMs": 213532,
   "endMs": 216720,
