{
 "канон": "пульс-синхрон/1",
 "songId": "tg_Tajik",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/tg_Tajik.srt",
 "юниты": [
  {
   "text": "[мусиқӣ]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Шаби нав дар қаҳвахона",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Тумани ғафс хонаҳоро пароканда мекунад. [мусиқӣ]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ман дар маҳаллаҳое сайр мекунам, ки дар он ҷо хотираҳо ҳастанд",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "маро девона мекунад",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Дар куҷо дар баҳори гарм",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Зимистон рӯҳро фаро мегирад",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ҷое, ки зиндагӣ мисли тир парвоз мекард, гузашта аз санаҳо, гузашта",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "мо",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Мо коғазҳоро ҷамъ кардем ва фаромӯш кардем, ки чаро",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "мо зиндагӣ мекунем",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ва ҳамеша чунин менамуд, [мусиқӣ]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ҳанӯз садои С дар пеш аст",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Танҳо вақти қарзӣ",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ҳеҷ чиз намедиҳад",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ва ногаҳон [мусиқӣ] ба дилам афтид",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "яхи хунук",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Вақте ки мо мағлуб мешавем, қадр кардани [мусиқиро] меомӯзем",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "вақте ки чароғи касе дар паси дар хомӯш мешавад",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Мо пас аз қатораҳои рафтан даст афшонда, кӯшиш мекунем",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "аз гузашта посух пурс",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Мо дӯст доштанро вақте ки сард аст, меомӯзем, [мусиқӣ]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "вақте ки дар кафи дастат хокистар ҳаст, на пӯлод. ДАР БОРАИ",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Кошки ман пешакӣ медонистам, [мусиқӣ]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "чӣ гуна ин шаффоф дар ҷон дард хоҳад кард",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "ғамгинӣ",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ӯ нагуфт, [мусиқӣ], ба оғӯш нагирифт, вақт надошт",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ин ангезаи абадӣ аст",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ҳама чизро барои баъдтар нигоҳ доштам, дилам барои дигарон нест",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "кушода шуд. [мусиқӣ]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Мо бо соя мубориза мебарем",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "мо аз чизҳои бефоида сӯхта мешавем",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ва шумо наметавонед бубинед, ки чӣ гуна сармо ором мешавад",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "бар дӯши мо",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Аммо хушбахтӣ дар дурахши тирезаи мағоза нест",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[мусиқӣ] на дар як даста пулҳои коғазӣ, балки дар оромӣ",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ҳақиқати хешовандон, дар гармии онҳо дар миёни тӯфонҳо. Аммо",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "мо танҳо он чизеро қадр мекунем, ки [мусиқӣ] аллакай аст",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "баргардонидан ғайриимкон аст",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Идомаи тӯлонии ман",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ва аксар вақт [мусиқӣ] роҳи бемаънӣ аст",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "мо қадр кардани онро меомӯзем, вақте ки [мусиқиро] аз даст медиҳем",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "вақте ки чароғи касе дар паси дар хомӯш мешавад",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Мо пас аз [мусиқӣ] қатораҳои рафтанд, даст афшондем",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "кӯшиш мекунад, ки аз гузашта посух пурсад",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Мо дӯст доштани [мусиқиро] вақте меомӯзем, ки он хунук шавад",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "вақте ки хокистар дар кафҳост, [мусиқӣ] ва на",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "пӯлод. ДАР БОРАИ",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Кошки ман пешакӣ медонистам, ки чӣ тавр он нолиш мекунад",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ин ғамгинии шаффоф дар рӯҳ",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Пиронсолонро даъват кунед, онҳоро ба оғӯш гиред",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "дар ҳоле ки набз мезанад",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Бигзор шикоятҳо гузаранд, ман имрӯз барои ин ҳастам",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ман дуо мекунам",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Чунки ҳама сурудҳо анҷом доранд",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "дар ниҳоят, яке",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[сурудхонӣ]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Мо [мусиқӣ] дар хотираи марҳилаҳои муҳим боқӣ мемонем",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "фаромӯшшуда нишастаем",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Вақте ки аз даст медиҳем, қадр карданро ёд мегирем",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "вақте ки мусиқии касе аз паси дар садо медиҳад",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "рӯшноӣ",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Мо пас аз қатораҳои рафтан даст афшонда, кӯшиш мекунем",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "аз гузашта посух пурс",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Мо дӯст доштанро меомӯзем, [мусиқӣ]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "вақте ки он хунук шуд, вақте ки хокистар дар кафҳо буд ва",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "булӯри шикаста [мусиқӣ]. Ман бояд аз он нигоҳубин кунам",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "чӣ аст, дар ҳоле ки мо дар ин ҷо ҳастем, то он даме",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "парвоз кард",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ҷон ба масофа",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[мусиқӣ]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
