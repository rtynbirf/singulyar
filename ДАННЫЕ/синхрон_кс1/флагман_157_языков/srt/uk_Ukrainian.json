 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/uk_Ukrainian.srt",
 "юниты": [
  {
   "text": "[музика]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Новий вечір у кав'ярні",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "густий туман розчиняє вдома. [музика]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Я по кварталах блукаю, де спогади",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "зводять з розуму",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Де теплою весною",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "душу накриває зима",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Де життя летіло стрілою повз дати, повз",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "нас",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Ми збирали папірці, забуваючи, навіщо ми",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "живемо",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "І здавалося завжди, [музика]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "попереду ще звучить до",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Тільки час у борг",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "нічого не дає",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "І раптом на серці лягає [музика]",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "холодний лід",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Ми вчимося [музика] цінувати, коли втрачаємо",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "коли за дверима гасне чиєсь світло",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Ми махаємо вслід поїздам, що пішли, намагаючись",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "вимолити у минулого відповідь",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Ми вчимося любити, коли охололо, [музика]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "коли в долонях попіл, а не сталь. О",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "якби знати заздалегідь, [музика]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "як буде нити в душі ця прозора",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "смуток",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Не сказав, [музика] не обійняв, не встиг",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Це вічний мотив",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Все берег на після, серце для інших не",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "відчинив. [музика]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ми боремося з тінню",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "згораємо в порожніх дрібницях",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "І не видно, як іній сідає",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "на наших плечах",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Тільки щастя не в блиску вітрини",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[музика] не в пачці купюр, а в тихій",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "правді рідних, у тому теплі серед бур. Але",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ми цінуємо лише те, що [музика] вже",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "неможливо повернути",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Продовжуючи свій довгий",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "і часто [музика] безглуздий шлях",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ми вчимося цінувати, коли [музика] втрачаємо",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "коли за дверима гасне чиєсь світло",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Ми махаємо вслід [музика] поїздам, що пішли",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "намагаючись вимолити у минулого відповідь",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Ми вчимося [музика] любити, коли охолола",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "коли в долонях попіл, [музика] а не",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "сталь. О",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "якби знати заздалегідь, як буде нити в",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "душі цей прозорий сум",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Подзвони старим, обійми",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "доки б'ється пульс",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Нехай образи пройдуть, я за це сьогодні",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "молюся",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Тому що фінал у всіх пісень",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "у результаті один",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[спів]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ми [музика] залишаємось у пам'яті віх",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "забутих сидимо",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Ми вчимося цінувати, коли втрачаємо",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "коли за дверима [музика] гасне чийсь",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "світло",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Ми махаємо вслід поїздам, що пішли, намагаючись",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "вимолити у минулого відповідь",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ми вчимося любити, [музика]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "коли охолола, коли в долонях попіл і",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "розбита [музика] кришталь. Берегти б",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "те, що є, поки ми тут, поки не",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "відлетіла",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "душа в далечінь",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[музика]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
