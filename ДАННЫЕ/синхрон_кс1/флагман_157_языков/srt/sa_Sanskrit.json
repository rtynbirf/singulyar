 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sa_Sanskrit.srt",
 "юниты": [
  {
   "text": "[संगीतं]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "कॉफी-दुकाने नूतन-सन्ध्या, २",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "घनः नीहारः गृहाणि विलीयते। [संगीतं]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "अहं तेषु परिसरेषु भ्रमामि यत्र स्मृतयः सन्ति",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "मां उन्मत्तं कुरुत।",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "उष्णवसन्ते यत्र",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "शिशिरः आत्मानं आच्छादयति।",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "यत्र जीवनं बाणवत् उड्डीयत तिथयः अतीताः",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "वयम्‌।",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "वयं कागदानि सञ्चितवन्तः, विस्मृतवन्तः यत् वयं किमर्थम्",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "वयं जीवामः।",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "सदा च प्रतीयते स्म, [संगीतम्]।",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "अद्यापि पुरतः C शब्दः अस्ति।",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "केवलं समयं ऋणं गृहीतवान्",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "न किमपि ददाति।",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "सहसा च [संगीतं] मम हृदये पतति",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "शीतहिमः ।",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "वयं हारिते [सङ्गीतस्य] प्रशंसाम् कर्तुं शिक्षेम",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "यदा कस्यचित् प्रकाशः द्वारस्य पृष्ठतः निष्क्रान्तः भवति।",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "वयं प्रस्थायमाणानां रेलयानानां पश्चात् तरङ्गं कुर्मः, प्रयासं कुर्वन्तः",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "उत्तरं याचत अतीतं।",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "वयं यदा शीतं भवति तदा प्रेम्णः शिक्षेम, [संगीतम्]।",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "यदा भवतः हस्ततलयोः भस्म भवति, न तु इस्पातः। विषये",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "यदि अहं पूर्वमेव जानामि स्म, [संगीतम्]।",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "कथं एषः पारदर्शी आत्मायां पीडयिष्यति",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "दुःखम् ।",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "सः न अवदत्, [सङ्गीतम्] सः न आलिंगितवान्, तस्य समयः नासीत्।",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "एषः शाश्वतः प्रेरणा अस्ति।",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "अहं सर्वं पश्चात् कृते रक्षितवान्, मम हृदयं परेषां कृते नास्ति",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "उद्घाटितम् । [संगीतं]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "छायाया सह वयं युद्धं कुर्मः",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "वयं शून्यानां तुच्छानां उपरि दहामः।",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "तथा च भवन्तः न पश्यन्ति यत् हिमः कथं निवसति",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "अस्माकं स्कन्धेषु ।",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "परन्तु सुखं न दुकानजालकस्य स्फुरणे",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[सङ्गीतम्] न तु बिलसमूहे, अपितु शान्तस्थाने",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "बान्धवानां सत्यं, तूफानानां मध्ये तेषां उष्णतायां। किन्तु",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "वयं केवलं तत् एव प्रशंसयामः यत् [सङ्गीतम्] पूर्वमेव अस्ति",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "असम्भवं प्रत्यागन्तुम् ।",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "मम दीर्घं निरन्तरं कुर्वन्",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "प्रायः च [सङ्गीतम्] निरर्थकः मार्गः भवति",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "वयं यदा [संगीतं] नष्टं कुर्मः तदा प्रशंसितुं शिक्षेम",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "यदा कस्यचित् प्रकाशः द्वारस्य पृष्ठतः निष्क्रान्तः भवति।",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "वयं [संगीतस्य] अनन्तरं प्रस्थितानि रेलयानानि तरङ्गयामः",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "अतीतं उत्तरं याचयितुम् प्रयतमानो।",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "वयं [सङ्गीतस्य] प्रेम्णः शिक्षेम यदा तत् शीतलं जातम्",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "यदा तालयोः भस्म भवति, [सङ्गीतम्] न च",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "अय। विषये",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "यदि अहं पूर्वमेव जानामि यत् कथं अन्तः कूजति",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "आत्मायां एतत् पारदर्शकं दुःखम्।",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "वृद्धान् आहूय आलिंगयतु",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "यदा नाडी ताडयति।",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "आक्रोशाः गच्छन्तु, अहम् अद्य अस्य कृते अस्मि",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "अहं प्रार्थयामि।",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "यतः सर्वेषां गीतानां अन्त्यः भवति",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "अन्ते एकः ।",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[गायन्] २",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "वयं [सङ्गीतं] माइलस्टोन्स् स्मृतौ तिष्ठामः",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "वयं विस्मृताः उपविशामः।",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "वयं यदा हास्यामः तदा प्रशंसा कर्तुं शिक्षेम",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "यदा कस्यचित् सङ्गीतं द्वारस्य पृष्ठतः बहिः गच्छति",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "प्रकाशः।",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "वयं प्रस्थायमाणानां रेलयानानां पश्चात् तरङ्गं कुर्मः, प्रयासं कुर्वन्तः",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "उत्तरं याचयतु अतीतं।",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "वयं प्रेम्णः शिक्षेम, [संगीतम्]।",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "यदा शीतलं जातम्, यदा तालयोः भस्म आसीत् तथा च",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "भग्न [संगीत] स्फटिक। मया तस्य पालनं कर्तव्यम्",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "किम् अस्ति, यावत् वयम् अत्र स्मः, यावत्",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "उड्डीयत",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "आत्मा दूरं प्रति ।",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[संगीतं]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
