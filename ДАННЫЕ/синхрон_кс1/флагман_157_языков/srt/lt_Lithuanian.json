   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "varyti mane iš proto",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kur šiltą pavasarį",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Žiema užvaldo sielą",
