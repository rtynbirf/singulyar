   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Kaupėme dokumentus, pamiršdami, kodėl",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "mes gyvename",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ir visada atrodė, [muzika]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Priekyje vis dar girdisi C garsas",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Tiesiog pasiskolintas laikas",
   "startMs": 52600,
   "endMs": 58520,
