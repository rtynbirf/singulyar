  },
  {
   "text": "[muzika]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "prašyti praeities atsakymo",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Mes išmokstame mylėti, kai šalta, [muzika]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kai delnuose pelenai, o ne plienas. APIE",
