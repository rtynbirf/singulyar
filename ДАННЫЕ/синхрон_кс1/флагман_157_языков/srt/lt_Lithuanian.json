   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Tai amžinas motyvas",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Viską pasilikau vėlesniam laikui, mano širdis ne skirta kitiems",
