  },
  {
   "text": "[muzika]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kur gyvenimas skriejo kaip strėlė pro datas, pro",
   "startMs": 33320,
   "endMs": 38645,
