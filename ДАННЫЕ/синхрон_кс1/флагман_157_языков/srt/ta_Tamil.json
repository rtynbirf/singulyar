{
 "канон": "пульс-синхрон/1",
 "songId": "ta_Tamil",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ta_Tamil.srt",
 "юниты": [
  {
   "text": "[இசை]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "காபி கடையில் ஒரு புதிய மாலைப் பொழுது",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "அடர்ந்த பனிமூட்டம் வீடுகளைக் கரைத்துவிடுகிறது. [இசை]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "நினைவுகள் நிறைந்திருக்கும் சுற்றுப்புறங்களில் நான் அலைந்து திரிகிறேன்",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "என்னை பைத்தியம் பிடிக்க வைக்கிறது",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "வெதுவெதுப்பான வசந்த காலத்தில் எங்கே",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "குளிர்காலம் ஆன்மாவை மூடுகிறது",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "தேதிகளைக் கடந்து, அம்பைப் போல வாழ்க்கை பறந்த இடத்தில்",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "எங்களை",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "நாம் ஏன் காகிதங்களைச் சேமித்து வைத்தோம் என்பதை மறந்து, அவற்றைச் சேமித்தோம்",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "நாம் வாழ்கிறோம்",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "மேலும் அது எப்போதும் தோன்றியது, [இசை]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "இன்னும் ஒரு C ஒலி முன்னால் இருக்கிறது",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "வெறும் கடன் வாங்கிய நேரம்",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "எதுவும் தருவதில்லை",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "திடீரென்று [இசை] என் இதயத்தில் விழுகிறது",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "குளிர்ந்த பனிக்கட்டி",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "நாம் இழக்கும்போதுதான் [இசையின்] அருமையை உணரக் கற்றுக்கொள்கிறோம்",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "கதவுக்குப் பின்னால் ஒருவரின் விளக்கு அணைந்துவிடும்போது",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "புறப்படும் ரயில்களுக்குப் பின்னால் நாங்கள் கையசைத்து, முயற்சி செய்கிறோம்",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "பதிலுக்காக கடந்த காலத்திடம் மன்றாடு",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "குளிராக இருக்கும்போது நாம் நேசிக்கக் கற்றுக்கொள்கிறோம், [இசை]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "உங்கள் உள்ளங்கைகளில் சாம்பல் இருக்கும்போது, ​​எஃகு அல்ல. பற்றி",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "எனக்கு முன்பே தெரிந்திருந்தால், [இசை]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "இந்த ஒளிபுகும் ஒன்று ஆன்மாவை எப்படி வலிக்கச் செய்யும்",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "சோகம்",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "அவன் எதுவும் சொல்லவில்லை, [இசை] அவன் அணைக்கவில்லை, அவனுக்கு நேரமும் இல்லை",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "இது ஒரு நித்தியமான நோக்கம்",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "நான் எல்லாவற்றையும் பிற்காலத்திற்காகச் சேமித்து வைத்தேன், என் இதயம் மற்றவர்களுக்காக அல்ல",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "திறக்கப்பட்டது. [இசை]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "நாம் நிழலுடன் போராடுகிறோம்",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "அர்த்தமற்ற அற்ப விஷயங்களுக்காக நாம் சோர்வடைந்து விடுகிறோம்",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "மேலும், பனி எப்படிப் படிகிறது என்பதை உங்களால் பார்க்க முடியாது",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "எங்கள் தோள்களில்",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "ஆனால் மகிழ்ச்சி என்பது கடை ஜன்னலின் பளபளப்பில் இல்லை",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[இசை] பணக்கட்டுகளில் அல்ல, அமைதியில்",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "புயல்களுக்கு மத்தியிலும் உறவினர்களின் அரவணைப்பில் வெளிப்படும் உண்மை. ஆனால்",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "[இசை] ஏற்கனவே என்னவாக இருக்கிறதோ அதை மட்டுமே நாம் பாராட்டுகிறோம்",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "திரும்புவது இயலாத காரியம்",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "எனது நீண்ட தொடர்ச்சி",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "மேலும் பெரும்பாலும் [இசை] ஒரு அர்த்தமற்ற பாதையாகும்",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "[இசையை] இழக்கும்போதுதான் அதன் அருமையை நாம் கற்றுக்கொள்கிறோம்",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "கதவுக்குப் பின்னால் ஒருவரின் விளக்கு அணைந்துவிடும்போது",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "புறப்பட்டுச் செல்லும் ரயில்களுக்குப் பின்னால் [இசையுடன்] நாங்கள் கையசைக்கிறோம்",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "பதிலுக்காக கடந்த காலத்திடம் கெஞ்ச முயல்வது",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "இசை தணிந்த பிறகுதான் அதை நேசிக்கக் கற்றுக்கொள்கிறோம்",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "உள்ளங்கைகளில் சாம்பல் இருக்கும்போது, ​​[இசை] மற்றும் இல்லை",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "எஃகு. பற்றி",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "அது எப்படி முனகும் என்று மட்டும் எனக்கு முன்பே தெரிந்திருந்தால்",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ஆன்மாவில் உள்ள இந்தத் தெளிவான சோகம்",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "பெரியவர்களை அழையுங்கள், அவர்களை அணைத்துக் கொள்ளுங்கள்",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "நாடித்துடிப்பு துடிக்கும் போது",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "குறைகள் கடந்து போகட்டும், இன்று நான் இதற்கு ஆதரவாக இருக்கிறேன்",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "நான் பிரார்த்திக்கிறேன்",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "ஏனென்றால் எல்லாப் பாடல்களுக்கும் ஒரு முடிவு உண்டு",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "இறுதியில், ஒன்று",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[பாடுகிறார்]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "நாங்கள் [இசை] மைல்கற்களின் நினைவில் நிலைத்திருக்கிறோம்",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "நாம் மறக்கப்பட்டவர்களாக அமர்ந்திருக்கிறோம்",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "நாம் இழக்கும்போது, ​​அதன் அருமையை உணரக் கற்றுக்கொள்கிறோம்",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "கதவுக்குப் பின்னால் ஒருவரின் இசை நின்றுபோகும்போது",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "ஒளி",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "புறப்படும் ரயில்களுக்குப் பின்னால் நாங்கள் கையசைத்து, முயற்சி செய்கிறோம்",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "பதிலுக்காக கடந்த காலத்திடம் மன்றாடு",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "நாம் நேசிக்கக் கற்றுக்கொள்கிறோம், [இசை]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "அது ஆறியபோது, ​​உள்ளங்கைகளில் சாம்பல் இருந்தபோது மற்றும்",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "உடைந்த [இசை] படிகம். நான் அதை கவனித்துக் கொள்ள வேண்டும்",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "நாம் இங்கே இருக்கும் வரை, என்ன நடக்கிறது",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "பறந்து சென்றது",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "ஆன்மா தொலைதூரம் செல்கிறது",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[இசை]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
