  },
  {
   "text": "na našim ramenima",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ali sreća nije u sjaju izloga",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
