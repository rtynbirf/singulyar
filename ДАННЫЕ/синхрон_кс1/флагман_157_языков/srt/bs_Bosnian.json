   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "izluđuje me",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Gdje u toplom proljeću",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Zima prekriva dušu",
