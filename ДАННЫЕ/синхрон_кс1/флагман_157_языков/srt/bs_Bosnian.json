   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Gomilali smo papire, zaboravljajući zašto",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "mi živimo",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "I uvijek se činilo, [muzika]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Još uvijek se čuje glas C",
