  },
  {
   "text": "Novo veče u kafiću",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Gusta magla rastvara kuće. [muzika]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Lutam kroz kvartove gdje su uspomene",
