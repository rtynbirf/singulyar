  {
   "text": "tuga",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nije rekao, [muzika] nije zagrlio, nije imao vremena",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ovo je vječni motiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Sve sam sačuvao za kasnije, moje srce nije za druge",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "otvoreno. [muzika]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Borimo se sa sjenom",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Izgorimo zbog praznih sitnica",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "I ne vidiš kako se mraz smiruje",
