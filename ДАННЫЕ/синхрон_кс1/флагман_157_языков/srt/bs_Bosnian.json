   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Gdje je život letio poput strijele, pored datuma, prošlosti",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nas",
