   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzika]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Samo posuđeno vrijeme",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ne daje ništa",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "I odjednom [muzika] pada na moje srce",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "hladan led",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Naučimo cijeniti [muziku] kada gubimo",
