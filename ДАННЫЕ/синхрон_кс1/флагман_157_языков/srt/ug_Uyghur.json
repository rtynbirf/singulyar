   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "ئاخىرىدا، بىر",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[ناخشا ئېيتىش]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "بىز [مۇزىكا] مۇھىم نۇقتىلارنىڭ خاتىرىسىدە قالىمىز،",
   "startMs": 181320,
   "endMs": 186022,
