 "юниты": [
  {
   "text": "[مۇزىكا]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "قەھۋەخانىدا يېڭى كەچ،",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "قېلىن تۇمان ئۆيلەرنى ئېرىتىپ تاشلايدۇ. [مۇزىكا]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "مەن خاتىرىلەر بار مەھەللىلەردە ئايلىنىپ يۈرىمەن",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "مېنى جىننى قىلىۋەتتىڭ",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "ئىللىق باھاردا قەيەردە",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "قىش روھنى قاپلايدۇ",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "ھايات ئوققا ئوخشاش ئۇچۇپ ئۆتكەن ۋاقىتلار، ئۆتكەن ۋاقىتلار",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "بىز",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "بىز قەغەزلەرنى يىغىۋېلىپ، نېمىشقا بۇنداق قىلغانلىقىمىزنى ئۇنتۇپ قالدۇق",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "بىز ياشايمىز",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ۋە ئۇ ھەمىشە شۇنداق كۆرۈنەتتى، [مۇزىكا]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ئالدىدا يەنىلا C تاۋۇشى بار",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "پەقەت ۋاقىت قەرز ئالدىم",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ھېچ نەرسە بەرمەيدۇ",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ۋە تۇيۇقسىز [مۇزىكا] يۈرىكىمگە چۈشۈپ قالدى",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "سوغۇق مۇز",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "بىز ئۇتتۇرۇپ قويغاندا [مۇزىكا] نىڭ قەدىرىنى بىلىشنى ئۆگىنىمىز،",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "ئىشىكنىڭ ئارقىسىدا بىرەيلەننىڭ چىرىغى ئۆچۈپ قالغاندا",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "بىز يولغا چىققان پويىزلارنىڭ كەينىدىن قول سىلكىپ، تىرىشىۋاتىمىز",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "ئۆتمۈشتىن جاۋاب تىلەڭ",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "سوغۇق بولغاندا سۆيۈشنى ئۆگىنىمىز، [مۇزىكا]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "قولىڭىزدا پولات ئەمەس، بەلكى كۈل بولغاندا. ھەققىدە،",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "ئەگەر مەن ئالدىن بىلگەن بولسام، [مۇزىكا]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "بۇ شەفاف روھتا قانداق ئازابلىنىدۇ",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "قايغۇ",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "ئۇ [مۇزىكا] قۇچاقلىمىدىم دېمىدى، ۋاقتى يوق ئىدى",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "بۇ مەڭگۈلۈك ھەرىكەت",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "ھەممە نەرسىنى كېيىن ئۈچۈن ساقلىدىم، قەلبىم باشقىلارغا ئەمەس",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ئېچىلدى. [مۇزىكا]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "بىز سايە بىلەن كۈرەش قىلىۋاتىمىز،",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "بىز بىكار نەرسىلەر ئۈچۈن كۆيۈپ كېتىمىز",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "ۋە سىز مۇزنىڭ قانداق چۆكۈۋاتقانلىقىنى كۆرەلمەيسىز",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "بىزنىڭ مۈرىمىزدە",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "لېكىن بەخت دۇكاننىڭ كۆزنىكىنىڭ يالتىراقلىقىدا ئەمەس،",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[مۇزىكا] بىر توپ پۇلنىڭ ئىچىدە ئەمەس، بەلكى جىمجىتلىقتا",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "تۇغقانلارنىڭ ھەقىقىتى، بوران-چاپقۇنلار ئارىسىدىكى ئىللىقلىقى بىلەن. لېكىن",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "بىز پەقەت [مۇزىكا] نىڭ ئاللىقاچان مەۋجۇت ئىكەنلىكىنىلا قەدىرلەيمىز",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "قايتىش مۇمكىن ئەمەس",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "ئۇزۇن ئۆمۈرۈمنى داۋاملاشتۇرىمەن",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ۋە كۆپىنچە ۋاقىتلاردا [مۇزىكا] مەنىسىز يول،",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "بىز [مۇزىكىنى] يوقاتقان ۋاقتىمىزدا قەدىرلەشنى ئۆگىنىمىز،",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "ئىشىكنىڭ ئارقىسىدا بىرەيلەننىڭ چىرىغى ئۆچۈپ قالغاندا",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "بىز يولغا چىققان پويىزلارنىڭ ئارقىسىدىن قول سىلكىدۇق، [مۇزىكا]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ئۆتمۈشتىن جاۋاب يالۋۇرۇشقا تىرىشىۋاتىدۇ",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "بىز [مۇزىكا] سوۋۇغاندا ئۇنى سۆيۈشنى ئۆگىنىمىز،",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "قوللاردا كۈل بولغاندا، [مۇزىكا] ۋە ئەمەس",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "پولات. ھەققىدە،",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "ئەگەر مەن ئۇنىڭ قانداق قىلىپ نالە قىلىدىغانلىقىنى ئالدىن بىلسەم ئىدى",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "روھتىكى بۇ شەفاف قايغۇ",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "قېرىلارنى چاقىرىڭ، ئۇلارنى قۇچاقلاڭ،",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[مۇزىكا]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "تومۇر سوقۇۋاتقاندا",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ئاغرىنىشلار ئۆتۈپ كەتسۇن، مەن بۈگۈن بۇنىڭ تەرەپدارى",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "مەن دۇئا قىلىمەن",
