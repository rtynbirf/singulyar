{
 "канон": "пульс-синхрон/1",
 "songId": "fr_French",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/fr_French.srt",
 "юниты": [
  {
   "text": "[musique]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nouvelle soirée au café",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Un épais brouillard fait disparaître les maisons. [musique]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Je flâne dans les quartiers où sont les souvenirs",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "me rendre fou",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Où, au printemps chaud",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "L'hiver enveloppe l'âme",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Là où la vie filait comme une flèche, dépassant les dates, le passé",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nous",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Nous avons accumulé des papiers, oubliant pourquoi nous",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Nous vivons",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Et il semblait toujours, [musique]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "Il y a encore un son C à venir",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Du temps emprunté",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ne donne rien",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Et soudain, [la musique] me touche le cœur",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "Glace froide",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "On apprend à apprécier [la musique] quand on perd",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "quand la lumière s'éteint derrière la porte",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Nous faisons signe aux trains qui partent, en essayant",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "implorer le passé de lui répondre",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "On apprend à aimer quand il fait froid, [musique]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "quand il y a de la cendre dans vos paumes, et non de l'acier. À PROPOS DE",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Si seulement j'avais su à l'avance, [musique]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "comment cette transparence va faire souffrir l'âme",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "tristesse",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Il n'a rien dit, [musique] il n'a pas fait d'accolade, il n'avait pas le temps",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "C'est un motif éternel",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "J'ai tout gardé pour plus tard, mon cœur n'est pas pour les autres",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "ouvert. [musique]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Nous luttons contre l'ombre",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "On s'épuise pour des broutilles",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Et on ne voit pas comment le gel se dépose",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sur nos épaules",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Mais le bonheur ne se trouve pas dans les paillettes d'une vitrine",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musique] non pas en liasse de billets, mais dans un silence",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "la vérité des proches, dans leur chaleur au milieu des tempêtes. Mais",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Nous n'apprécions que ce que la musique est déjà",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "Impossible de revenir",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Poursuivant ma longue",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "et souvent [la musique] est un chemin sans signification",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "on apprend à apprécier quand on perd [la musique]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "quand la lumière s'éteint derrière la porte",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Nous faisons signe aux trains qui partent [musique]",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "essayer de trouver une réponse dans le passé",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "On apprend à aimer [la musique] quand elle s'est calmée",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "quand il y a des cendres dans les palmiers, [musique] et non",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acier. À PROPOS DE",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Si seulement j'avais su à l'avance comment il allait gémir",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "cette tristesse transparente dans l'âme",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Appelez les personnes âgées, embrassez-les",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "pendant que le pouls bat",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Laissons les griefs s'estomper, je suis pour aujourd'hui",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Je prie",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Parce que toutes les chansons ont une fin",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "Au final, un seul",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[chant]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Nous [la musique] restons dans la mémoire des moments marquants",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "Nous restons assis, oubliés",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "On apprend à apprécier quand on perd",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "quand la musique de quelqu'un sort derrière la porte",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lumière",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Nous faisons signe aux trains qui partent, en essayant",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "implorer le passé de lui répondre",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Nous apprenons à aimer, [musique]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "quand la température a baissé, quand il y avait des cendres dans les palmiers et",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "cristal [musical] brisé. Je devrais m'en occuper",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "ce qui est, pendant que nous sommes ici, jusqu'à",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "s'envola",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "l'âme au loin",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[musique]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
