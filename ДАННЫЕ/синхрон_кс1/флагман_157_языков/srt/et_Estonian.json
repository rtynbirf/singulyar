  },
  {
   "text": "[muusika]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Me kogusime pabereid, unustades, miks me seda tegime",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "me elame",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ja alati tundus, [muusika]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ees on ikka veel C-häälik",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muusika]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Lihtsalt laenatud aeg",
   "startMs": 52600,
   "endMs": 58520,
