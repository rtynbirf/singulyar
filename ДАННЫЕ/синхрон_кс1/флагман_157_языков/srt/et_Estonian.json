   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "külm jää",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Me õpime [muusikat] hindama siis, kui kaotame",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kui kellegi tuli ukse taga kustub",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Me lehvitame lahkuvatele rongidele järele, püüdes",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muusika]",
