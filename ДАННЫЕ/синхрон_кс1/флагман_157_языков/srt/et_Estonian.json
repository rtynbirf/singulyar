   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Talv katab hinge",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muusika]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kus elu lendas nagu nool mööda kuupäevadest, mööda",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "meid",
