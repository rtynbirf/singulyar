   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ta ei öelnud, [muusika] ta ei kallistanud, tal polnud aega",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "See on igavene motiiv",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
