 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/pl_Polish.srt",
 "юниты": [
  {
   "text": "[muzyka]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nowy wieczór w kawiarni",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Gęsta mgła rozpuszcza domy. [muzyka]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Wędruję po dzielnicach, w których są wspomnienia",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "doprowadzają mnie do szaleństwa",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Gdzie w ciepłą wiosnę",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Zima okrywa duszę",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Gdzie życie przeleciało jak strzała, mijając daty, mijające",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nas",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Gromadziliśmy papiery, zapominając, dlaczego",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "żyjemy",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "I zawsze wydawało się, [muzyka]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "nadal słychać dźwięk C",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Po prostu pożyczony czas",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nic nie daje",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "I nagle [muzyka] spada mi na serce",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "zimny lód",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Uczymy się doceniać [muzykę], gdy przegrywamy",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "gdy za drzwiami gaśnie światło",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Machamy za odjeżdżającymi pociągami, próbując",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "błagać przeszłość o odpowiedź",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Uczymy się kochać, gdy jest zimno, [muzyka]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "gdy masz w dłoniach popiół, a nie stal. O",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "gdybym tylko wiedział wcześniej, [muzyka]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "jak ta przejrzysta będzie boleć w duszy",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "smutek",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nie powiedział [muzyki], nie przytulił, nie miał czasu",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "To jest wieczny motyw",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Wszystko odkładam na później, moje serce nie jest dla innych",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "otwierany. [muzyka]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Walczymy z cieniem",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "wypalamy się przez błahostki",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "I nie widać jak szron opada",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "na naszych barkach",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Ale szczęście nie kryje się w blasku witryny sklepowej",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzyka] nie w pliku banknotów, ale w cichym",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "prawda o krewnych, w ich cieple pośród burz. Ale",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "doceniamy tylko to, czym [muzyka] jest już",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "niemożliwy do powrotu",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Kontynuując moją długą",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "i często [muzyka] jest ścieżką pozbawioną sensu",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "uczymy się doceniać, kiedy tracimy [muzykę]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "gdy za drzwiami gaśnie światło",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Machamy po [muzyce] odjeżdżającym pociągom",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "próbując prosić przeszłość o odpowiedź",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Uczymy się kochać [muzykę], gdy ostygnie",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "gdy w palmach jest popiół, [muzyka] i nie",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "stal. O",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Gdybym tylko wiedział wcześniej, jak to będzie jęczeć",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ten przejrzysty smutek w duszy",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Zadzwoń do starszych ludzi, przytul ich",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "dopóki puls bije",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Niech żale przeminą, ja jestem za tym dzisiaj",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Modlę się",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Ponieważ wszystkie piosenki mają zakończenie",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "na koniec, jeden",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[śpiew]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Pozostajemy [muzyka] w pamięci kamieni milowych",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "siedzimy zapomniani",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muzyka]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Uczymy się doceniać, gdy przegrywamy",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kiedy czyjaś muzyka znika za drzwiami",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "światło",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Machamy za odjeżdżającymi pociągami, próbując",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "błagać przeszłość o odpowiedź",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Uczymy się kochać, [muzyka]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "gdy się ochłodziło, gdy na palmach był popiół i",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "rozbity [muzyczny] kryształ. Powinienem się tym zająć",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "co jest, póki tu jesteśmy, dopóki",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "odleciał",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[muzyka]",
