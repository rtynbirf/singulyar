{
 "канон": "пульс-синхрон/1",
 "songId": "eo_Esperanto",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/eo_Esperanto.srt",
 "юниты": [
  {
   "text": "[muziko]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Nova vespero ĉe la kafejo",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Densa nebulo dissolvas domojn. [muziko]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mi vagas tra la kvartaloj kie memoroj estas",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "frenezigi min",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Kie en la varma printempo",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Vintro kovras la animon",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Kie la vivo flugis kiel sago preter datoj, preter",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "nin",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Ni amasigis paperojn, forgesante kial ni",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ni vivas",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Kaj ĉiam ŝajnis, [muziko]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "estas ankoraŭ C-sono antaŭe",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Nur pruntita tempo",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "donas nenion",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Kaj subite [muziko] falas sur mian koron",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "malvarma glacio",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Ni lernas aprezi [muzikon] kiam ni perdas",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kiam ies lumo estingiĝas malantaŭ la pordo",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Ni mansvingas post la forirantaj trajnoj, provante",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "petegi la pasintecon por respondo",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Ni lernas ami kiam estas malvarme, [muziko]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kiam estas cindro en viaj manplatoj, ne ŝtalo. PRI",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "se nur mi scius anticipe, [muziko]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "kiel ĉi tiu travidebla doloros en la animo",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "malĝojo",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Li ne diris, [muzikon] li ne brakumis, li ne havis tempon",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Jen eterna motivo",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Mi konservis ĉion por poste, mia koro ne estas por aliaj",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "malfermiĝis. [muziko]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ni batalas kontraŭ la ombro",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ni bruliĝas pro malplenaj bagateloj",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Kaj vi ne povas vidi kiel la frosto trankviliĝas",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sur niaj ŝultroj",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Sed feliĉo ne estas en la brilo de butikfenestro",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muziko] ne en amaso da biletoj, sed en kvieta",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "la vero de parencoj, en ilia varmo inter la ŝtormoj. Sed",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "ni nur aprezas tion, kio [muziko] jam estas",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "neeble reveni",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Daŭrigante mian longan",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "kaj ofte [muziko] estas sensignifa vojo",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ni lernas aprezi kiam ni perdas [muzikon]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "kiam ies lumo estingiĝas malantaŭ la pordo",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Ni mansvingas post [muziko] la forirantajn trajnojn",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "provante petegi la pasintecon por respondo",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Ni lernas ami [muzikon] kiam ĝi malvarmiĝis",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kiam estas cindro en la palmoj, [muziko] kaj ne",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ŝtalo. PRI",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Se nur mi scius anticipe kiel ĝi ĝemus enen",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ĉi tiu travidebla malĝojo en la animo",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Voku la maljunulojn, brakumu ilin",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "dum la pulso batas",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Lasu la plendojn pasi, mi estas por ĉi tio hodiaŭ",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Mi preĝas",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Ĉar ĉiuj kantoj havas finon",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "fine, unu",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[kantante]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ni [muziko] restas en la memoro de mejloŝtonoj",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ni sidas forgesitaj",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Ni lernas aprezi kiam ni perdas",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kiam ies muziko eliras malantaŭ la pordon",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "lumo",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Ni mansvingas post la forirantaj trajnoj, provante",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "petegi la pasintecon por respondo",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ni lernas ami, [muzikon]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "kiam ĝi malvarmiĝis, kiam estis cindro en la palmoj kaj",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "rompita [muzika] kristalo. Mi devus prizorgi ĝin",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "kio estas, dum ni estas ĉi tie, ĝis",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "forflugis",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "animon en la distancon",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[muziko]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
}
