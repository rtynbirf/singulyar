  {
   "text": "tristesa",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "No va dir, [música] no va abraçar, no va tenir temps",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Aquest és un motiu etern",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Ho guardat tot per més tard, el meu cor no és per als altres",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "obert. [música]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Estem lluitant contra l'ombra",
