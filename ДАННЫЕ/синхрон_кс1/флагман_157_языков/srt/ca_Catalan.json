  {
   "text": "Nova nit a la cafeteria",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Una boira espessa dissol les cases. [música]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Vago pels barris on hi ha records",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "em torna boig",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "On a la càlida primavera",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "L'hivern cobreix l'ànima",
