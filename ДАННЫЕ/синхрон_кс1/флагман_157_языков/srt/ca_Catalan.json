   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Vam acumular papers, oblidant per què ho fèiem",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "vivim",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "I sempre semblava, [música]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "encara hi ha un so de C més endavant",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[música]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Només temps prestat",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "no dóna res",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "I de sobte [la música] em cau al cor",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "gel fred",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Aprenem a apreciar [la música] quan perdem",
