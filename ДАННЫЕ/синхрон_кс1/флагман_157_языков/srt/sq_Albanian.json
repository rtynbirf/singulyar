{
 "канон": "пульс-синхрон/1",
 "songId": "sq_Albanian",
 "версия": 1,
 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/sq_Albanian.srt",
 "юниты": [
  {
   "text": "[muzikë]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Mbrëmje e re në kafene",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Mjegulla e dendur shkrin shtëpitë. [muzikë]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Endem nëpër lagjet ku janë kujtimet",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "më çmend",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ku në pranverën e ngrohtë",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Dimri mbulon shpirtin",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ku jeta fluturoi si shigjetë përtej datave, përtej të kaluarës",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "ne",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Ne grumbulluam dokumente, duke harruar pse",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "ne jetojmë",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Dhe gjithmonë dukej, [muzikë]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "ka ende një tingull C përpara",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Thjesht kohë e huazuar",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "nuk jep asgjë",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Dhe papritmas [muzika] bie në zemrën time",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "akull i ftohtë",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Ne mësojmë ta vlerësojmë [muzikën] kur humbasim",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kur drita e dikujt fiket pas derës",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Ne përshëndetim trenat që nisen, duke u përpjekur",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "i lute të kaluarës për një përgjigje",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Ne mësojmë të duam kur është ftohtë, [muzikë]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kur ka hi në pëllëmbët e tua, jo çelik. RRETH",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "sikur ta dija paraprakisht, [muzikë]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "si do të dhembë në shpirt kjo e tejdukshme",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "trishtim",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Ai nuk tha, [muzikë] nuk përqafoi, nuk kishte kohë",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ky është një motiv i përjetshëm",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "I ruajta të gjitha për më vonë, zemra ime nuk është për të tjerët",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "u hap. [muzikë]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Ne po luftojmë me hijen",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "ne digjemi mbi gjëra të vogla boshe",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Dhe nuk mund ta shihni se si po qetësohet ngrica",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "mbi supet tona",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Por lumturia nuk është në shkëlqimin e një vitrine dyqani",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[muzikë] jo në një tufë kartëmonedhash, por në një qetësi",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "e vërteta e të afërmve, në ngrohtësinë e tyre midis stuhive. Por",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Ne vlerësojmë vetëm atë që [muzika] është tashmë",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "e pamundur të kthehet",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Duke vazhduar gjatësinë time",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "dhe shpesh [muzika] është një rrugë e pakuptimtë",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "ne mësojmë të vlerësojmë kur humbasim [muzikën]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "kur drita e dikujt fiket pas derës",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Ne përshëndetim pas [muzikës] trenat e nisur",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "duke u përpjekur t'i lutet të kaluarës për një përgjigje",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Ne mësojmë ta duam [muzikën] kur ajo është ftohur",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kur ka hi në pëllëmbë, [muzikë] dhe jo",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "çelik. RRETH",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Sikur ta dija paraprakisht se si do të gjëmonte brenda",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "këtë trishtim transparent në shpirt",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Thirrni të moshuarit, përqafojini",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "ndërsa pulsi po rreh",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Le të kalojnë ankesat, unë jam për këtë sot",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Unë lutem",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Sepse të gjitha këngët kanë një fund",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "në fund, një",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[duke kënduar]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Ne [muzika] mbetemi në kujtesën e momenteve kryesore",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "ne rrimë të harruar",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Ne mësojmë të vlerësojmë kur humbasim",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kur muzika e dikujt del pas derës",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "dritë",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Ne përshëndetim trenat që nisen, duke u përpjekur",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "i lute të kaluarës për një përgjigje",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Ne mësojmë të duam, [muzikë]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "kur u ftoh, kur kishte hi në palma dhe",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "kristal i thyer [muzikë]. Duhet të kujdesem për të",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "çfarë është, ndërsa jemi këtu, derisa",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "fluturoi larg",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "shpirtin në distancë",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "[muzikë]",
   "startMs": 220082,
   "endMs": 222102,
   "level": "line"
  }
 ]
