 "юниты": [
  {
   "text": "[zene]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Új este a kávézóban",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Sűrű köd oszlatja el a házakat. [zene]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Átkóstolok a környékeken, ahol emlékek laknak",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "megőrjít",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Hol a meleg tavasszal",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "A tél beborítja a lelket",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Ahol az élet nyílként repült el dátumokon, múlton túl",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "minket",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Papírokat halmoztunk fel, elfelejtve, miért",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "élünk",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "És mindig úgy tűnt, [zene]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "még mindig van egy C hang elöl",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Csak kölcsönvett idő",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "semmit sem ad",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "És hirtelen [a zene] megszólal a szívemben",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "hideg jég",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Akkor tanuljuk meg értékelni [a zenét], amikor veszítünk",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "amikor valakinek a fénye kialszik az ajtó mögött",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Integetünk a távozó vonatok után, próbálunk",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "könyörögj a múltnak válaszért",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Megtanulunk szeretni, amikor hideg van, [zene]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "amikor hamu van a tenyeredben, nem acél. KÖRÜLBELÜL",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "ha csak előre tudnám, [zene]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "hogy fog fájni ez az átlátszó a lélekben",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "szomorúság",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Nem mondta, [zene] nem ölelt meg, nem volt rá ideje",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Ez egy örök motívum",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Mindent elraktároztam későbbre, a szívem nem másokért van",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "kinyitotta. [zene]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Az árnyékkal harcolunk",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "üres semmiségeken égünk ki",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "És nem láthatod, hogyan nyugszik a fagy",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "a vállunkon",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "De a boldogság nem a kirakat csillogásában rejlik",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[zene] nem egy köteg bankjegyben, hanem egy csendes",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "a rokonok igazsága, melegükben a viharok között. De",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "csak azt értékeljük, ami [a zene] már eleve van",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "lehetetlen visszatérni",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Folytatva a hosszú",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "és gyakran [a zene] értelmetlen út",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "Megtanuljuk értékelni, amikor elveszítjük [a zenét]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "amikor valakinek a fénye kialszik az ajtó mögött",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Integetünk [zene] az induló vonatok után",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "próbál a múlttól könyörögni válaszért",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Akkor tanulunk meg szeretni [a zenét], amikor lehűlt",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "amikor hamu van a pálmákban, [zene] és nem",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "acél. KÖRÜLBELÜL",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Ha csak előre tudtam volna, hogyan fog beindulni",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "ez az átlátszó szomorúság a lélekben",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Hívd az időseket, öleld meg őket",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "miközben a pulzus dübörög",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Hadd múljanak el a sérelmek, én ma ebben hiszek",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Imádkozom",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Mert minden dalnak van vége",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "végül is egy",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[éneklés]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Mi [a zene] mérföldkövek emlékében maradunk",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "elfeledetten ülünk",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[zene]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Megtanuljuk értékelni, amikor veszítünk",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "amikor valakinek a zenéje kimegy az ajtó mögött",
   "startMs": 191760,
