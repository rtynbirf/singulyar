 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ceb_Cebuano.srt",
 "юниты": [
  {
   "text": "[musika]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Bag-ong gabii sa coffee shop",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ang baga nga gabon nagtunaw sa mga balay. [musika]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Naglatagaw ko sa mga kasilinganan diin anaa ang mga panumduman",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "mabuang ko",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Asa sa mainit nga tingpamulak",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Ang tingtugnaw nagtabon sa kalag",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Diin ang kinabuhi milupad sama sa pana sa nangaging mga petsa, nangagi",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "kanato",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Nagtigom mig mga papel, nakalimot nganong",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "nagpuyo kita",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Ug kanunay kini daw, [musika]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "naa pa'y tunog nga C sa unahan",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Nanghiram lang ug oras",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "wala’y gihatag",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Ug kalit lang [musika] nahulog sa akong kasingkasing",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "bugnaw nga yelo",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Makakat-on kita sa pag-apresyar sa [musika] kon kita mapildi",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "kon mapalong ang suga sa usa ka tawo sa luyo sa pultahan",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Mikaway mi sa mga tren nga molarga, naningkamot",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "mangayo og tubag sa nangagi",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Makakat-on kita sa paghigugma kon tugnaw, [musika]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "kon abo ang naa sa imong mga palad, dili asero. MAHITUNGOD SA",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "kon nahibal-an ko lang daan, [musika]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "unsaon pagsakit sa kalag kining transparent nga usa",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "kasubo",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Wala siya miingon, [musika] wala niya gaksa, wala siyay panahon",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Kini usa ka walay katapusan nga motibo",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Gitipigan nako ang tanan para sa ulahi, ang akong kasingkasing dili para sa uban",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "giablihan. [musika]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Nakig-away kita sa anino",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "nahurot na among kusog sa mga walay pulos nga butang",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Ug dili nimo makita kung giunsa ang paghusay sa katugnaw",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "sa atong mga abaga",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Apan ang kalipay wala sa kinang sa bintana sa tindahan",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[musika] dili sa usa ka pundok sa mga kwarta, apan sa usa ka hilom",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "ang kamatuoran sa mga paryente, sa ilang kainit taliwala sa mga bagyo. Apan",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "among gipasalamatan kung unsa na ang [musika]",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "imposible nga makabalik",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Nagpadayon sa akong dugay nga",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "ug kasagaran [ang musika] usa ka walay kahulugan nga dalan",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "makakat-on ta sa pagpasalamat kon mawala nato [ang musika]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "kon mapalong ang suga sa usa ka tawo sa luyo sa pultahan",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Mangaway mi human sa [musika] sa mga tren nga nanglarga",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "naningkamot nga mangayo og tubag sa nangagi",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Makakat-on kita sa paghigugma [sa musika] kon kini mobugnaw na",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "kon adunay abo sa mga palad, [musika] ug dili",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "asero. MAHITUNGOD SA",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Kon nahibal-an ko lang daan kon unsaon kini pag-agulo",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "kining klaro nga kasubo sa kalag",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Tawga ang mga tigulang, gaksa sila",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "samtang nagpitik ang pulso",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Pasagdi nga molabay ang mga reklamo, uyon ko ani karong adlawa",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Nag-ampo ko",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Kay tanang kanta naa gyuy katapusan",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "sa katapusan, usa ra",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[nagkanta]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Kita [musika] magpabilin sa handumanan sa mga milestone",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "kita naglingkod nga nalimtan",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Makakat-on ta nga mopasalamat kon kita mapildi",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "kon ang musika sa usa ka tawo mogawas sa luyo sa pultahan",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "kahayag",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Mikaway mi sa mga tren nga molarga, naningkamot",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "mangayo og tubag sa nangagi",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Makakat-on kita sa paghigugma, [musika]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "sa dihang kini mibugnaw, sa dihang adunay abo sa mga palad ug",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "nabuak nga kristal [musika]. Dapat ako ang mag-atiman niini",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "unsa man, samtang ania pa kita dinhi, hangtod",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "milupad palayo",
   "startMs": 211160,
   "endMs": 213560,
   "level": "line"
  },
  {
   "text": "[musika]",
   "startMs": 213532,
   "endMs": 216720,
   "level": "line"
  },
  {
   "text": "kalag ngadto sa layo",
   "startMs": 213560,
   "endMs": 216720,
   "level": "line"
  },
  {
