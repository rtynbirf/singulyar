 "метка": "пересинхрон SRT→КС1 (такт v11.22 «СИНХРОН», С100); уровень line; чистка по канону аудита; источник: ДАННЫЕ/флагман_157_языков/srt/ha_Hausa.srt",
 "юниты": [
  {
   "text": "[kiɗa]",
   "startMs": 1309,
   "endMs": 3329,
   "level": "line"
  },
  {
   "text": "Sabuwar maraice a shagon kofi",
   "startMs": 13200,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Hazo mai kauri yana narkar da gidaje. [kiɗa]",
   "startMs": 15480,
   "endMs": 19705,
   "level": "line"
  },
  {
   "text": "Ina yawo a cikin unguwannin da abubuwan tunawa suke",
   "startMs": 20320,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "haukace ni",
   "startMs": 23080,
   "endMs": 26200,
   "level": "line"
  },
  {
   "text": "Ina a cikin bazara mai dumi",
   "startMs": 26400,
   "endMs": 32095,
   "level": "line"
  },
  {
   "text": "Lokacin sanyi yana rufe rai",
   "startMs": 29040,
   "endMs": 33320,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 32095,
   "endMs": 36760,
   "level": "line"
  },
  {
   "text": "Inda rayuwa ta tashi kamar kibiya ta wuce zamanin da, ta wuce",
   "startMs": 33320,
   "endMs": 38645,
   "level": "line"
  },
  {
   "text": "mu",
   "startMs": 36760,
   "endMs": 39160,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 38645,
   "endMs": 43080,
   "level": "line"
  },
  {
   "text": "Mun tara takardu, mun manta da dalilin da yasa muke",
   "startMs": 39160,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "muna rayuwa",
   "startMs": 43080,
   "endMs": 45520,
   "level": "line"
  },
  {
   "text": "Kuma koyaushe yana kama da, [kiɗa]",
   "startMs": 45720,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "har yanzu akwai sautin C a gaba",
   "startMs": 47240,
   "endMs": 52200,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 52400,
   "endMs": 54560,
   "level": "line"
  },
  {
   "text": "Lokaci kawai na aro",
   "startMs": 52600,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "ba ya ba da komai",
   "startMs": 54560,
   "endMs": 58520,
   "level": "line"
  },
  {
   "text": "Kuma ba zato ba tsammani [kiɗa] ya faɗo a zuciyata",
   "startMs": 59240,
   "endMs": 64440,
   "level": "line"
  },
  {
   "text": "kankara mai sanyi",
   "startMs": 61800,
   "endMs": 68960,
   "level": "line"
  },
  {
   "text": "Muna koyon godiya [kiɗa] idan muka rasa",
   "startMs": 64440,
   "endMs": 72200,
   "level": "line"
  },
  {
   "text": "lokacin da hasken wani ya fita a bayan ƙofar",
   "startMs": 68960,
   "endMs": 74670,
   "level": "line"
  },
  {
   "text": "Mun yi amfani da hannu muna bin jiragen ƙasa da ke tashi, muna ƙoƙari",
   "startMs": 72200,
   "endMs": 75240,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 74670,
   "endMs": 78320,
   "level": "line"
  },
  {
   "text": "roƙi amsar da ta gabata",
   "startMs": 75240,
   "endMs": 81920,
   "level": "line"
  },
  {
   "text": "Muna koyon ƙauna lokacin da sanyi yake, [kiɗa]",
   "startMs": 78320,
   "endMs": 85000,
   "level": "line"
  },
  {
   "text": "idan akwai toka a tafin hannunka, ba ƙarfe ba. GAME DA",
   "startMs": 81920,
   "endMs": 86360,
   "level": "line"
  },
  {
   "text": "Da ace na sani a gaba, [kiɗa]",
   "startMs": 85000,
   "endMs": 90000,
   "level": "line"
  },
  {
   "text": "yadda wannan mai gaskiya zai yi zafi a cikin ruhi",
   "startMs": 86360,
   "endMs": 91840,
   "level": "line"
  },
  {
   "text": "baƙin ciki",
   "startMs": 90000,
   "endMs": 94320,
   "level": "line"
  },
  {
   "text": "Bai ce, [kiɗa] bai rungume ba, bai da lokaci",
   "startMs": 91840,
   "endMs": 97840,
   "level": "line"
  },
  {
   "text": "Wannan dalili ne na har abada",
   "startMs": 94320,
   "endMs": 101120,
   "level": "line"
  },
  {
   "text": "Na ajiye komai don daga baya, zuciyata ba ta son wasu ba",
   "startMs": 97840,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "budewa. [kiɗa]",
   "startMs": 101120,
   "endMs": 103545,
   "level": "line"
  },
  {
   "text": "Muna faɗa da inuwar",
   "startMs": 104000,
   "endMs": 106520,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 106111,
   "endMs": 110480,
   "level": "line"
  },
  {
   "text": "Muna ƙonewa saboda ƙananan abubuwa marasa komai",
   "startMs": 106520,
   "endMs": 113316,
   "level": "line"
  },
  {
   "text": "Kuma ba za ku iya ganin yadda sanyin ya daidaita ba",
   "startMs": 110480,
   "endMs": 113880,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 113316,
   "endMs": 116960,
   "level": "line"
  },
  {
   "text": "a kafadunmu",
   "startMs": 113880,
   "endMs": 119211,
   "level": "line"
  },
  {
   "text": "Amma farin ciki ba ya cikin walƙiyar taga ta shago",
   "startMs": 116960,
   "endMs": 121800,
   "level": "line"
  },
  {
   "text": "[kiɗa] ba a cikin tarin kuɗi ba, amma a cikin shiru",
   "startMs": 119211,
   "endMs": 125040,
   "level": "line"
  },
  {
   "text": "gaskiyar dangi, a cikin ɗuminsu a tsakanin guguwa. Amma",
   "startMs": 121800,
   "endMs": 126880,
   "level": "line"
  },
  {
   "text": "Muna godiya ne kawai da abin da [kiɗa] ya riga ya kasance",
   "startMs": 125040,
   "endMs": 129920,
   "level": "line"
  },
  {
   "text": "ba zai yiwu a dawo ba",
   "startMs": 126880,
   "endMs": 132600,
   "level": "line"
  },
  {
   "text": "Ci gaba da dogon lokaci na",
   "startMs": 129920,
   "endMs": 135760,
   "level": "line"
  },
  {
   "text": "kuma sau da yawa [kiɗa] hanya ce mara ma'ana",
   "startMs": 132600,
   "endMs": 140280,
   "level": "line"
  },
  {
   "text": "muna koyon godiya idan muka rasa [kiɗa]",
   "startMs": 135760,
   "endMs": 143480,
   "level": "line"
  },
  {
   "text": "lokacin da hasken wani ya fita a bayan ƙofar",
   "startMs": 140280,
   "endMs": 145880,
   "level": "line"
  },
  {
   "text": "Muna daga hannu bayan [kiɗa] jiragen ƙasa da suka tafi",
   "startMs": 143480,
   "endMs": 149520,
   "level": "line"
  },
  {
   "text": "ƙoƙarin neman amsa daga baya",
   "startMs": 145880,
   "endMs": 153160,
   "level": "line"
  },
  {
   "text": "Muna koyon son [kiɗa] idan ya yi sanyi",
   "startMs": 149520,
   "endMs": 155000,
   "level": "line"
  },
  {
   "text": "lokacin da akwai toka a cikin tafin hannu, [kiɗa] kuma ba",
   "startMs": 153160,
   "endMs": 156160,
   "level": "line"
  },
  {
   "text": "ƙarfe. GAME DA",
   "startMs": 155000,
   "endMs": 159200,
   "level": "line"
  },
  {
   "text": "Da ace na san yadda zai yi kuka a gaba",
   "startMs": 156160,
   "endMs": 163040,
   "level": "line"
  },
  {
   "text": "wannan bakin ciki mai haske a cikin rai",
   "startMs": 159200,
   "endMs": 165061,
   "level": "line"
  },
  {
   "text": "Kira tsofaffin mutane, ku rungume su",
   "startMs": 163040,
   "endMs": 165480,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 165061,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "yayin da bugun zuciyar ke bugawa",
   "startMs": 165480,
   "endMs": 169000,
   "level": "line"
  },
  {
   "text": "Bari a wuce koke-koke, ni ne ke da alhakin wannan a yau",
   "startMs": 169440,
   "endMs": 174231,
   "level": "line"
  },
  {
   "text": "Ina addu'a",
   "startMs": 172400,
   "endMs": 175080,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 174231,
   "endMs": 178280,
   "level": "line"
  },
  {
   "text": "Domin duk waƙoƙi suna da ƙarshe",
   "startMs": 175080,
   "endMs": 180127,
   "level": "line"
  },
  {
   "text": "a ƙarshe, ɗaya",
   "startMs": 178280,
   "endMs": 181320,
   "level": "line"
  },
  {
   "text": "[suna waƙa]",
   "startMs": 180127,
   "endMs": 184680,
   "level": "line"
  },
  {
   "text": "Mu [kiɗa] muna ci gaba da tunawa da muhimman abubuwan da suka faru",
   "startMs": 181320,
   "endMs": 186022,
   "level": "line"
  },
  {
   "text": "Mun zauna mun manta",
   "startMs": 184680,
   "endMs": 187280,
   "level": "line"
  },
  {
   "text": "[kiɗa]",
   "startMs": 186022,
   "endMs": 191760,
   "level": "line"
  },
  {
   "text": "Mukan koyi godiya idan muka rasa",
   "startMs": 187280,
   "endMs": 193720,
   "level": "line"
  },
  {
   "text": "idan kiɗan wani ya fita a bayan ƙofa",
   "startMs": 191760,
   "endMs": 194959,
   "level": "line"
  },
  {
   "text": "haske",
   "startMs": 193720,
   "endMs": 197959,
   "level": "line"
  },
  {
   "text": "Mun yi amfani da hannu muna bin jiragen ƙasa da ke tashi, muna ƙoƙari",
   "startMs": 194959,
   "endMs": 200959,
   "level": "line"
  },
  {
   "text": "roƙi amsar da ta gabata",
   "startMs": 197959,
   "endMs": 202360,
   "level": "line"
  },
  {
   "text": "Muna koyon ƙauna, [kiɗa]",
   "startMs": 200959,
   "endMs": 205800,
   "level": "line"
  },
  {
   "text": "lokacin da ya huce, lokacin da akwai toka a cikin tafin hannu da",
   "startMs": 202360,
   "endMs": 208080,
   "level": "line"
  },
  {
   "text": "lu'ulu'u mai fashewa [kiɗa]. Ya kamata in kula da shi",
   "startMs": 205800,
   "endMs": 211160,
   "level": "line"
  },
  {
   "text": "menene, yayin da muke nan, har sai",
   "startMs": 208080,
   "endMs": 213532,
   "level": "line"
  },
  {
   "text": "tashi ta tafi",
   "startMs": 211160,
