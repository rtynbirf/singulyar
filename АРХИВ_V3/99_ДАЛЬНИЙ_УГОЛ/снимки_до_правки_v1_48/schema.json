{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "singulyar-funding-schema/v0.1",
  "title": "СИНГУЛЯР funding.json — машина-проверяемая честность денег",
  "type": "object",
  "required": ["schema", "status", "currency_display", "rails", "principles", "tiers", "goals", "last_verified"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "singulyar-funding/v0.1" },
    "status": { "enum": ["PROTOTYPE_NO_RAILS", "ACTIVE"] },
    "activation": { "type": "string" },
    "currency_display": { "enum": ["EUR"] },
    "rails": {
      "type": "object",
      "description": "при PROTOTYPE_NO_RAILS обязан быть пустым: ни URL, ни ключей, ни обещаний"
    },
    "principles": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "enum": [
        "accessibility_is_not_premium",
        "person_chooses_system_adapts",
        "no_user_data_sales",
        "sponsor_does_not_own_roadmap",
        "public_claims_require_evidence"
      ] }
    },
    "tiers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "kind", "amount", "currency", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["friend", "supporter", "accessibility", "infrastructure", "partner"] },
          "kind": { "enum": ["monthly", "one_time"] },
          "amount": { "type": "integer", "minimum": 1 },
          "currency": { "const": "EUR" },
          "title": { "enum": ["FRIEND", "SUPPORTER", "ACCESSIBILITY", "INFRASTRUCTURE", "PARTNER"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "target", "currency", "status", "deliverables"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "target": { "type": "integer", "minimum": 1 },
          "currency": { "const": "EUR" },
          "status": { "enum": ["PLANNED", "FUNDED", "PUBLISHED"] },
          "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "fund_corner": {
      "type": "object",
      "description": "скромный уголок: прямые двери официальному фонду имени Хелен Келлер, мимо чужих дядь; рельсы СИНГУЛЯРА при этом обязаны оставаться пустыми",
      "required": ["id", "title", "doors"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "doors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "label", "verified"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "pattern": "^https://(www\\.)?(hki\\.org|helenkellerfoundation\\.org)/" },
              "label": { "type": "string", "minLength": 1 },
              "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "if": { "properties": { "status": { "const": "PROTOTYPE_NO_RAILS" } }, "required": ["status"] },
  "then": { "properties": { "rails": { "maxProperties": 0 } } }
}
