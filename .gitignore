# мусор сборки и локальные инструменты — в репу не ходит
server/node_modules/
server/data/
node_modules/
__pycache__/
АРХИВ_V3/
ДАННЫЕ/*.xlsx
# — такты владельца (ПРИВАТ/витрина): токены, логи, архивы —
tmp/
*.log
.DS_Store
Thumbs.db
# токены и доступы — НИКОГДА не в репе (R-19/ЭП-02)
.gh_token*
*.token
*_token*
# тяжёлые архивы — не для коммитов (вес дома, ЭП-10)
*.zip
*.7z
# локальные резервные копии и выжимки скриптов
scripts/_*
*.bak
