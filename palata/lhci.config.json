{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:8080/"],
      "numberOfRuns": 2,
      "outputDir": "lhci",
      "settings": {
        "onlyCategories": ["performance", "pwa"]
      }
    },
    "assert": {
      "assertions": {
        "categories:pwa": ["error", {"minScore": 0}],
        "categories:performance": ["error", {"minScore": 0}],
        "groups:pwa-installable": "off",
        "works-offline": "off"
      }
    }
  }
}
