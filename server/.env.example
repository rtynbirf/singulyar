# SINGULAR SERVER v1 — переменные окружения
# Все опциональны: без них сервер работает с дефолтами.

PORT=8787
# TTL временных записей, мс. По ТЗ: 7 дней = 604800000. Человек сохраняет → ПАМЯТЬ, иначе GC удаляет.
TTL_TEMP_MS=604800000
# Лимиты аплоада, МБ
MAX_FINAL_MB=60
MAX_PART_MB=20
# Токен доступа, мс (12 часов)
TOKEN_TTL_MS=43200000

# Web Push (опционально). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
