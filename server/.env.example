# SINGULAR SERVER v1.1.0 — переменные окружения (v1.40.0 «РЕВИЗИЯ»: файл появился на деле, раньше был только обещан в README)
# Все необязательны: без них сервер живёт на значениях по умолчанию. Скопируйте в .env и уберите «#».

# Порт прослушивания (0 = случайный — так делает тест s19)
# PORT=8787

# Папка данных (метаданные JSON + блобы записей). По умолчанию server/data
# DATA_DIR=./data

# Временная запись живёт столько, потом GC удалит метаданные И блоб (по ТЗ — 7 дней)
# TTL_TEMP_MS=604800000

# Интервал обхода GC (мс). GC также запускается при старте
# GC_INTERVAL_MS=60000

# Лимиты загрузки (МБ): финальный микс / голос участника
# MAX_FINAL_MB=60
# MAX_PART_MB=20

# Время жизни Bearer-токена (12 ч) и одноразового ws-билета (30 с)
# TOKEN_TTL_MS=43200000
# TICKET_TTL_MS=30000

# Web Push (опционально; без ключей push тихо пропускается). Сгенерировать: npx web-push generate-vapid-keys
# VAPID_SUBJECT=mailto:you@example.org
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
